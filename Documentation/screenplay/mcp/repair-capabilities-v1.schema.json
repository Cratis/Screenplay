{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screenplay repair capabilities v1 structuredContent",
  "type": "object",
  "required": ["schema", "schemaVersion", "serverVersion", "repairContractVersion", "actions", "evidence", "structuredFailures", "savedFilesOnly", "journaledApply", "cancellation", "limits"],
  "properties": {
    "schema": { "const": "cratis.screenplay.mcp.repair-capabilities" },
    "schemaVersion": { "const": 1 },
    "serverVersion": { "type": "string", "minLength": 1 },
    "repairContractVersion": { "const": 1 },
    "actions": {
      "description": "PLAY0661 completes command-read keys only with unique same-named compatible sources. Queries and trigger reads are not repaired. PLAY0660 and PLAY0662 are not repairable. PLAY0683/PLAY0684 raise nanoid size or bytes count to at least 64 random bits using the concept subject, including across documents. PLAY0683 also offers a unique constraint using the command-property subject only for exactly one mapped event property. Both generation repairs require individual review and canonical formatting and do not support pinned evidence. PLAY0688 replaces a refuted generated-concept rule with the strategy-derived matches pattern, preserving its message and severity; it requires individual review and canonical formatting and does not support pinned evidence or fix-all. PLAY0701 replaces a capture record fixture with an event fixture only for a capture over events with exactly one from event, using the specification subject. It requires individual review and canonical formatting and supports neither pinned evidence nor fix-all. PLAY0700 has no automatic repair.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["diagnosticCode", "tool", "requiredFormatting", "pinRepairEvidence"],
        "properties": {
          "diagnosticCode": { "type": "string", "pattern": "^PLAY[0-9]{4}$" },
          "tool": { "const": "propose-repair" },
          "requiredFormatting": { "type": "string" },
          "pinRepairEvidence": { "type": "boolean" }
        }
      }
    },
    "intentActions": {
      "description": "Optional additive explicit-intent actions, never no-input editor repairs.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["diagnosticCode", "tool", "intentSchema", "intentVersion", "discoveryView", "reportView", "requiredFormatting", "requiredValidation", "individualReviewRequired", "baselineExecutableAvailable", "preservationProven", "canFixAll", "pinRepairEvidence"],
        "properties": {
          "diagnosticCode": { "const": "PLAY0470" },
          "tool": { "const": "propose-repair" },
          "intentSchema": { "const": "destinationIntent" },
          "intentVersion": { "const": 1 },
          "discoveryView": { "const": "repair-intents" },
          "reportView": { "const": "production-destinations" },
          "requiredFormatting": { "const": "CanonicalizeTouchedDocuments" },
          "requiredValidation": { "const": "Executable" },
          "individualReviewRequired": { "const": true },
          "baselineExecutableAvailable": { "const": false },
          "preservationProven": { "const": false },
          "canFixAll": { "const": false },
          "pinRepairEvidence": { "const": false }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["version", "optional", "revisionPrefix", "candidateResolutionChanges"],
      "properties": {
        "version": { "const": 1 },
        "optional": { "const": true },
        "revisionPrefix": { "const": "re1:" },
        "candidateResolutionChanges": { "const": "Refused" },
        "plannedWriteOverlap": { "const": "Refused" },
        "plannedWriteOverlapFailureKind": { "const": "RepairEvidenceWriteConflict" }
      }
    },
    "structuredFailures": {
      "type": "object",
      "required": ["version", "discriminator", "unknownApplyOutcome"],
      "properties": {
        "version": { "const": 1 },
        "discriminator": { "const": "failureKind" },
        "unknownApplyOutcome": { "const": "ApplyOutcomeUnknown" }
      }
    },
    "savedFilesOnly": { "const": true },
    "journaledApply": { "const": true },
    "cancellation": {
      "type": "object",
      "required": ["supported", "notifications", "applyOutcomeAfterDisconnect"],
      "properties": {
        "supported": { "const": false },
        "notifications": { "const": "Ignored" },
        "applyOutcomeAfterDisconnect": { "const": "Unknown" }
      }
    },
    "limits": {
      "type": "object",
      "required": ["retainedProposals", "sourceFiles", "sourceBytes", "attachmentFileBytes", "attachmentBytes", "bytePageBytes", "itemPageItems", "structuredResponseBytes", "requestCharacters"],
      "properties": {
        "retainedProposals": { "type": "integer", "minimum": 1 },
        "sourceFiles": { "type": "integer", "minimum": 1 },
        "sourceBytes": { "type": "integer", "minimum": 1 },
        "attachmentFileBytes": { "type": "integer", "minimum": 1 },
        "attachmentBytes": { "type": "integer", "minimum": 1 },
        "bytePageBytes": { "type": "integer", "minimum": 1 },
        "itemPageItems": { "type": "integer", "minimum": 1 },
        "structuredResponseBytes": { "type": "integer", "minimum": 1 },
        "requestCharacters": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "repairEvidenceRevision": { "type": "string", "pattern": "^re1:[0-9a-f]{64}$" },
    "repairEvidence": {
      "type": "object",
      "required": ["beforeRevision", "candidateRevision"],
      "properties": {
        "beforeRevision": { "$ref": "#/$defs/repairEvidenceRevision" },
        "candidateRevision": { "$ref": "#/$defs/repairEvidenceRevision" }
      }
    },
    "recoveryFailure": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/failure" }],
      "required": ["success", "status", "failureKind", "operationId", "conflict", "recovery"],
      "properties": {
        "success": { "const": false },
        "status": { "const": "RecoveryRequired" },
        "failureKind": { "const": "RecoveryRequired" },
        "operationId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "conflict": { "type": "string" },
        "recovery": { "type": "string" }
      }
    },
    "failure": {
      "type": "object",
      "required": ["failureKind"],
      "properties": { "failureKind": { "type": "string", "minLength": 1 } }
    }
  }
}
