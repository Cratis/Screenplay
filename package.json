{
    "private": true,
    "name": "screenplay-workspace",
    "workspaces": [
        "Source/Screenplay/Compiler",
        "Source/Screenplay/EventModels",
        "Source/Screenplay/Views",
        "Source/Screenplay/Monaco/screenplay-language",
        "Source/Screenplay/Monaco/screenplay-editor",
        "Source/Screenplay/McpApp",
        "Source/Screenplay/VSCodeExtension"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build": "yarn workspaces foreach -At run build",
        "lint": "yarn workspaces foreach -At run lint",
        "lint:ci": "yarn workspaces foreach -At run lint:ci",
        "compile": "yarn workspaces foreach -At run compile",
        "dev": "yarn workspace screenplay-editor dev",
        "g:lint": "cd $INIT_CWD && eslint --cache --quiet --fix",
        "g:lint:ci": "cd $INIT_CWD && eslint --cache --quiet",
        "test": "yarn workspaces foreach -At run test"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/node": "26.6.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/eslint-plugin": "8.71.0",
        "@typescript-eslint/parser": "8.71.0",
        "@vitejs/plugin-react": "6.1.1",
        "eslint": "10.12.0",
        "eslint-plugin-react": "7.37.5",
        "globals": "17.13.0",
        "happy-dom": "20.14.5",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2"
    },
    "packageManager": "yarn@4.18.1"
}
