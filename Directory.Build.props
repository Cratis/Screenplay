<Project>
    <PropertyGroup>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>

        <!-- Debuggability -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>True</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IncludeSource>True</IncludeSource>

        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!--
            Compare every packable assembly against the last released one and fail on a binary break.
            Screenplay's syntax nodes are positional records, so adding a trailing optional parameter is
            source compatible and binary breaking: a package compiled against the older version names a
            constructor that no longer exists, and the failure surfaces as a runtime 'Method not found' in
            a consumer rather than an error here. That has already shipped once - Cratis.Arc.Screenplay
            built against 1.5.2 broke against 1.7.0 exactly this way. This makes the break an error in the
            pull request that causes it, and a deliberate act when it is one.
        -->
        <!--
            Compare every packable assembly against the last released one and fail on a binary break.
            Screenplay's syntax nodes are positional records, so adding a trailing optional parameter is
            source compatible and binary breaking: a package compiled against the older version names a
            constructor that no longer exists, and the failure surfaces as a runtime 'Method not found' in
            a consumer rather than an error here. That has already shipped once - Cratis.Arc.Screenplay
            built against 1.5.2 broke against 1.7.0 exactly this way.

            The baseline moves to the first release of each major. Within a major it protects; at a major
            it is reset, because validating a deliberate break against the line it deliberately leaves has
            no answer to give.
        -->
        <!--
            Off for the 4.0.0 major only. Every break in it is deliberate - the module scoped 'layout' became
            'screen template', the arrangement tree moved out of its own 'template' block and the AST records
            that carried both were renamed with it, so the whole layout/template surface leaves the 3.x line
            on purpose.

            Turn back on with the baseline at 4.0.0 once it is published, exactly as 3.0.0 did - leaving it
            off past the major is what let eight versions tag and release with nothing on NuGet.
        -->
        <EnablePackageValidation>false</EnablePackageValidation>
        <PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>

        <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>True</RunAnalyzersDuringLiveAnalysis>
        <RunAnalyzers>True</RunAnalyzers>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>

        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <NoWarn>NU1507;CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'==''">
        <Configuration>Debug</Configuration>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>False</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>False</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>True</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>True</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>True</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>False</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All"/>
        <PackageReference Include="Roslynator.Analyzers" PrivateAssets="All"/>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="All"/>
    </ItemGroup>
</Project>
