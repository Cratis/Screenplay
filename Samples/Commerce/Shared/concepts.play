// The domain's values. Concepts used by a single slice live in that slice's
// file instead; these are the ones several modules share.

// Identities - each is the event source id of one stream.
concept ProductId        : Uuid
concept OrderId          : Uuid
concept CustomerId       : Uuid

concept ProductName      : String
concept PaymentReference : String
concept TrackingNumber   : String
concept PostalCode       : String
concept CountryCode      : String

// A rule on a concept travels with the value everywhere it appears.
concept Sku : String
  validate
    matches "^[A-Z]{3}-[0-9]{4}$"  message "A SKU looks like ABC-1234"

concept Money : Decimal
  validate
    >= 0  message "An amount cannot be negative"

concept Quantity : Int
  validate
    min 1  message "Order at least one of each item"

concept PersonName : String pii
  pii reason "The name a parcel is addressed to. Needed to deliver the order; lawful basis: contract performance. Lives under the customer's subject and is erasable with their key."

concept StreetAddress : String pii
  pii reason "Where a parcel is delivered. Needed to deliver the order; lawful basis: contract performance. Lives under the customer's subject and is erasable with their key."

concept OrderStatus : Enum
  placed
  paid
  cancelled
  shipped
  delivered

concept Carrier : Enum
  postNord
  dhl
  ups
