slice StateChange DispatchShipment
  description "Hands a packed order to a carrier"

  command DispatchShipment
    orderId        OrderId identifier
    carrier        Carrier
    trackingNumber TrackingNumber

    authorize IsWarehouseClerk

    validate
      trackingNumber not empty  message "Scan the carrier's tracking number"
      trackingNumber min 8      message "A tracking number has at least 8 characters"

    // Lands on the order's event source; the order id is also payload,
    // because the customer notification selects it as a trigger value.
    produces ShipmentDispatched
      for orderId
      orderId        = orderId
      carrier        = carrier
      trackingNumber = trackingNumber

  event ShipmentDispatched
    orderId        OrderId
    carrier        Carrier
    trackingNumber TrackingNumber

  constraint DispatchedOnce
    unique event ShipmentDispatched

  constraint OneParcelPerTrackingNumber
    unique trackingNumber on ShipmentDispatched

  specification DispatchingAPaidOrder
    given caller
      authenticated
      role "WarehouseClerk"
    given OrderPlaced
      for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      customerId      = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
      lines           = [{"productId":"6f1c2a3e-8b4d-4c5e-9f60-1a2b3c4d5e01","sku":"MUG-0042","quantity":2,"unitPrice":12.5}]
      shippingAddress = {"recipient":"Ada Lovelace","street":"12 Analytical Way","postalCode":"0150","city":"Oslo","country":"NO"}
    given ShipmentRequested
      orderId    = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      amountPaid = 25.0
    when DispatchShipment
      orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      carrier        = "postNord"
      trackingNumber = "PN00012345NO"
    then ShipmentDispatched
      for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      carrier        = "postNord"
      trackingNumber = "PN00012345NO"

  specification RejectingAShortTrackingNumber
    given caller
      authenticated
      role "WarehouseClerk"
    when DispatchShipment
      orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      carrier        = "dhl"
      trackingNumber = "JD01"
    then error "A tracking number has at least 8 characters"

  specification ACustomerCannotDispatch
    given caller
      authenticated
      role "Customer"
    when DispatchShipment
      orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      carrier        = "ups"
      trackingNumber = "1Z999AA10123456784"
    then denied

  screen DispatchShipmentScreen
    template ShipmentDialog
      body
        title "Dispatch shipment"
      actions
        action DispatchShipment
          label "Hand to carrier"
          navigate to ShipmentQueue
