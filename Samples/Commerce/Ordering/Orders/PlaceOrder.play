slice StateChange PlaceOrder
  description "A customer checks out their basket"

  command PlaceOrder
    description "Places an order for one or more products, delivered to one address"
    orderId         OrderId identifier
    customerId      CustomerId
    lines           OrderLine[]
    shippingAddress Address

    authorize IsCustomer

    // The quantity and price rules live on the Quantity and Money concepts in
    // application.play, so they hold on every line without restating them here.
    validate
      lines not empty  message "An order needs at least one line"

    produces OrderPlaced
      for orderId
      customerId      = customerId
      lines           = lines
      shippingAddress = shippingAddress

  event OrderPlaced
    customerId      CustomerId
    lines           OrderLine[]
    shippingAddress Address

  constraint OrderPlacedOnce
    unique event OrderPlaced

  example AdasBasket : PlaceOrder
    orderId         = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
    customerId      = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
    lines           = [{"productId":"6f1c2a3e-8b4d-4c5e-9f60-1a2b3c4d5e01","sku":"MUG-0042","quantity":2,"unitPrice":12.5}]
    shippingAddress = {"recipient":"Ada Lovelace","street":"12 Analytical Way","postalCode":"0150","city":"Oslo","country":"NO"}

  // The module gate (IsAuthenticated) and the command gate (IsCustomer)
  // both have to pass, so the caller states both.
  specification PlacingAnOrder
    given caller
      authenticated
      role "Customer"
    when AdasBasket
    then OrderPlaced
      for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      customerId      = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
      lines           = [{"productId":"6f1c2a3e-8b4d-4c5e-9f60-1a2b3c4d5e01","sku":"MUG-0042","quantity":2,"unitPrice":12.5}]
      shippingAddress = {"recipient":"Ada Lovelace","street":"12 Analytical Way","postalCode":"0150","city":"Oslo","country":"NO"}

  specification RejectingAnEmptyBasket
    given caller
      authenticated
      role "Customer"
    when AdasBasket lines = []
    then error "An order needs at least one line"

  // Authenticated, but not a customer - the command gate denies it.
  specification AMerchandiserCannotPlaceOrders
    given caller
      authenticated
      role "Merchandiser"
    when AdasBasket
    then denied

  // Reached from the storefront search in the Catalog module.
  screen PlaceOrderScreen
    template OrderDialog
      body
        title $strings.orders.checkout
      actions
        action PlaceOrder
          label "Place order"
          navigate to MyOrders
