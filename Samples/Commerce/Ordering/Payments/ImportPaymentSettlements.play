slice Translate ImportPaymentSettlements
  description "Translates the payment provider's settlements into a fact in the provider's vocabulary"
  direction inbound

  // External data enters the application here. The provider calls a webhook;
  // a settlement that moves from pending to settled becomes a fact.
  capture PaymentProviderSettlements
    source webhook
      path /webhooks/payments
    key paymentReference
    append PaymentSettled
      when status from "pending" to "settled"
        orderId          = $.orderReference
        amount           = $.amount
        paymentReference = $.paymentReference

  // The provider's vocabulary, captured as it arrives.
  event PaymentSettled
    orderId          OrderId
    amount           Money
    paymentReference PaymentReference

  // The provider first reports the payment pending, then settled. The
  // transition is captured as the provider's fact; MarkOrderPaid translates it
  // into the shop's own.
  specification ASettlementIsCaptured
    given capture PaymentProviderSettlements
      paymentReference = "PSP-7731-0042"
      orderReference   = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      amount           = 25.0
      status           = "pending"
    when capture PaymentProviderSettlements
      paymentReference = "PSP-7731-0042"
      orderReference   = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      amount           = 25.0
      status           = "settled"
    then PaymentSettled
      orderId          = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
      amount           = 25.0
      paymentReference = "PSP-7731-0042"
