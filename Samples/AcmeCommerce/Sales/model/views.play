module Orders
  feature Intake
    slice StateView PriceList
      description "The price list as Catalog last published it"

      // translated from Catalog's public ProductPriceChanged (translation/fulfilment.play)
      event PriceListUpdated
        description "A price in Sales' price list changed (translated from ProductPriceChanged)"
        price         Money
        currency      CurrencyCode
        effectiveFrom Date

      readmodel PriceListEntry
        description "The current price of one SKU"
        sku           Sku key
        price         Money
        currency      CurrencyCode
        effectiveFrom Date

      query AllPriceListEntries => observable PriceListEntry[]
        description "Every price Sales has heard of"

      projection PriceListProjection => PriceListEntry
        from PriceListUpdated
          price         = price
          currency      = currency
          effectiveFrom = effectiveFrom

      screen PriceList
        description "What each SKU costs today"
        template blueprint Cratis.Blueprint.Default ListScreen version "^1"
          header
            title "Price list"
          list
            data PriceListEntry[] via query AllPriceListEntries
            table PriceListEntry
              column sku           label "SKU"
              column price         label "Price"
              column currency      label "Currency"
              column effectiveFrom label "Effective from"

      specification ThePriceListFollowsTheCatalogue
        given caller
          authenticated
          role "SalesRep"
        given PriceListUpdated
          for "ACM-1000"
          price         = 59
          currency      = "NOK"
          effectiveFrom = "2026-11-01"
        then readmodel PriceListEntry
          sku           = "ACM-1000"
          price         = 59
          currency      = "NOK"
          effectiveFrom = "2026-11-01"

  feature Fulfilment
    slice StateView OrdersPipeline
      description "Every order in the column of its status"

      // outcomes of the inbound translations (translation/fulfilment.play), declared here in the slice that reads them
      event OrderReservationCompleted
        description "The warehouse reserved stock for the order (translated from StockReserved)"
        sku      Sku
        quantity Quantity

      event OrderPutOnHold
        description "The warehouse could not fill the order (translated from StockReservationFailed)"
        sku     Sku
        shortBy Quantity

      event OrderShipmentRecorded
        description "The order left the warehouse (translated from ShipmentDispatched)"
        shipmentId     ShipmentId
        carrier        Carrier
        trackingNumber TrackingNumber
        dispatchedAt   DateTime

      readmodel PipelineOrder
        description "One order on the fulfilment board"
        orderId     OrderId key
        customerId  CustomerId
        market      Market
        quotedTotal Money
        status      OrderStatus

      query AllPipelineOrders => observable PipelineOrder[]
        description "Every order on the board"

      projection PipelineOrderProjection => PipelineOrder
        no automap
        from OrderReceived
          customerId  = customerId
          market      = market
          quotedTotal = quotedTotal
          status      = "received"
        from OrderApproved
          status = "approved"
        from OrderRejected
          status = "rejected"
        from OrderPutOnHold
          status = "onHold"
        from OrderHoldReleased
          status = "received"
        from OrderConfirmationIssued
          status = "confirmed"
        from OrderShipmentRecorded
          status = "shipped"
        from OrderFulfilled
          status = "fulfilled"
        from OrderCancelled
          status = "cancelled"

      screen OrdersPipeline
        description "The fulfilment board: a column per status"
        template blueprint Cratis.Blueprint.Default BoardScreen version "^1"
          header
            title "Orders pipeline"
          board
            data PipelineOrder[] via query AllPipelineOrders
            on select
              navigate to OrderPage
                with orderId from item.orderId

      specification AnOrderMovesAcrossTheBoard
        given caller
          authenticated
          role "SalesRep"
        given OrderReceived
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          customerId  = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email       = "ada@example.com"
          lines       = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo      = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          market      = "NO"
          quotedTotal = 98
        given OrderApproved
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
        given OrderShipmentRecorded
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId     = "5a1c6e1e-0d4b-4b6e-9d63-0f4a9b6d7e01"
          carrier        = "posten"
          trackingNumber = "TRK-100200"
          dispatchedAt   = "2026-10-20T08:00:00Z"
        then readmodel PipelineOrder
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          quotedTotal = 98
          status      = "shipped"

    // The record page. The activity slot shows the order's own timeline.
    slice StateView OrderDetails
      description "One order with everything that has happened to it"

      readmodel OrderDetail
        description "The order as the record page shows it"
        orderId        OrderId key
        customerId     CustomerId
        email          EmailAddress
        market         Market
        status         OrderStatus
        quotedTotal    Money
        deliveryCity   String
        deliveryPostalCode String
        discount       DiscountPercent optional
        carrier        Carrier optional
        trackingNumber TrackingNumber optional

      // The timeline is one row of steps reached, shown on the order page as a summary.
      // (The reference evaluator carries no occurrence time on facts, so the steps are flags; a timestamped timeline needs $eventContext.)
      readmodel OrderTimeline
        description "Which steps an order has been through"
        orderId   OrderId key
        received  Bool
        approved  Bool
        rejected  Bool
        confirmed Bool
        reserved  Bool
        onHold    Bool
        shipped   Bool
        fulfilled Bool
        cancelled Bool

      query GetOrderDetail => OrderDetail optional
        by orderId OrderId

      query GetOrderTimeline => OrderTimeline optional
        by orderId OrderId

      projection OrderDetailProjection => OrderDetail
        no automap
        from OrderReceived
          customerId  = customerId
          email       = email
          market      = market
          status      = "received"
          quotedTotal = quotedTotal
          deliveryCity       = shipTo.city
          deliveryPostalCode = shipTo.postalCode
        from OrderApproved
          status = "approved"
        from OrderRejected
          status = "rejected"
        from OrderDiscounted
          discount = discount
        from OrderPutOnHold
          status = "onHold"
        from OrderHoldReleased
          status = "received"
        from OrderConfirmationIssued
          status = "confirmed"
        from OrderShipmentRecorded
          status         = "shipped"
          carrier        = carrier
          trackingNumber = trackingNumber
        from OrderFulfilled
          status = "fulfilled"
        from OrderCancelled
          status = "cancelled"

      projection OrderTimelineProjection => OrderTimeline
        no automap
        from OrderReceived
          received  = true
          approved  = false
          rejected  = false
          confirmed = false
          reserved  = false
          onHold    = false
          shipped   = false
          fulfilled = false
          cancelled = false
        from OrderApproved
          approved = true
        from OrderRejected
          rejected = true
        from OrderConfirmationIssued
          confirmed = true
        from OrderReservationCompleted
          reserved = true
        from OrderPutOnHold
          onHold = true
        from OrderHoldReleased
          onHold = false
        from OrderShipmentRecorded
          shipped = true
        from OrderFulfilled
          fulfilled = true
        from OrderCancelled
          cancelled = true

      // The page a rep works an order from: facts, lines, where it goes, how far it has come - and what the rep may do next
      screen OrderPage
        description "One order: facts, delivery, fulfilment progress and the rep's actions"
        template blueprint Cratis.Blueprint.Default RecordPage version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader orderHeader
              property title = "Order"
              property subtitle = "Everything about one order and where it stands"
          summary
            data OrderDetail via query GetOrderDetail by orderId
            summary OrderDetail
              field email          label "Customer"
              field market         label "Market"
              field status         label "Status"
              field quotedTotal    label "Quoted total"
              field discount       label "Discount %"
              field carrier        label "Carrier"
              field trackingNumber label "Tracking"
          related
            action ApplyDiscount
              label "Give discount"
            action ReleaseHold
              label "Release hold"
            action MarkOrderFulfilled
              label "Mark fulfilled"
            action CancelOrder
              label "Cancel order"
          aside
            data OrderDetail via query GetOrderDetail by orderId
            summary OrderDetail
              field deliveryCity       label "Deliver to"
              field deliveryPostalCode label "Postal code"
          activity
            data OrderTimeline via query GetOrderTimeline by orderId
            summary OrderTimeline
              field received  label "Received"
              field approved  label "Approved"
              field confirmed label "Confirmed"
              field reserved  label "Reserved"
              field shipped   label "Shipped"
              field fulfilled label "Fulfilled"

      specification TheRecordPageFollowsTheOrder
        given caller
          authenticated
          role "SalesRep"
        given OrderReceived
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          customerId  = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email       = "ada@example.com"
          lines       = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo      = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          market      = "NO"
          quotedTotal = 98
        given OrderDiscounted
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          discount = 10
        then readmodel OrderDetail
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          status      = "received"
          quotedTotal = 98
          discount    = 10

  // The customer-service desk: find any order by customer, market, status or tracking number and open it
  feature Lookup
    slice StateView OrderLookup
      description "Every order with the customer and the shipment, to answer what a customer asks"

      readmodel OrderRow
        description "One order as the desk's list shows it"
        orderId        OrderId key
        customerId     CustomerId
        email          EmailAddress
        market         Market
        quotedTotal    Money
        status         OrderStatus
        carrier        Carrier optional
        trackingNumber TrackingNumber optional

      query AllOrderRows => observable OrderRow[]
        description "Every order the desk can look up"

      projection OrderRowProjection => OrderRow
        no automap
        from OrderReceived
          customerId  = customerId
          email       = email
          market      = market
          quotedTotal = quotedTotal
          status      = "received"
        from OrderApproved
          status = "approved"
        from OrderRejected
          status = "rejected"
        from OrderPutOnHold
          status = "onHold"
        from OrderHoldReleased
          status = "received"
        from OrderConfirmationIssued
          status = "confirmed"
        from OrderShipmentRecorded
          status         = "shipped"
          carrier        = carrier
          trackingNumber = trackingNumber
        from OrderFulfilled
          status = "fulfilled"
        from OrderCancelled
          status = "cancelled"

      screen OrderList
        description "All orders: who ordered, what it is worth, where it stands and how it ships"
        template blueprint Cratis.Blueprint.Default ListScreen version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader ordersHeader
              property title = "Orders"
              property subtitle = "Find an order and open it"
          list
            data OrderRow[] via query AllOrderRows
            table OrderRow
              column orderId        label "Order"
              column email          label "Customer"
              column market         label "Market"
              column quotedTotal    label "Total"
              column status         label "Status"
              column carrier        label "Carrier"
              column trackingNumber label "Tracking"
              on double click
                navigate to OrderPage
                  with orderId from item.orderId

      specification TheDeskSeesTheShipment
        given caller
          authenticated
          role "SalesRep"
        given OrderReceived
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          customerId  = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email       = "ada@example.com"
          lines       = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo      = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          market      = "NO"
          quotedTotal = 98
        given OrderShipmentRecorded
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId     = "5a1c6e1e-0d4b-4b6e-9d63-0f4a9b6d7e01"
          carrier        = "posten"
          trackingNumber = "TRK-100200"
          dispatchedAt   = "2026-10-20T08:00:00Z"
        then readmodel OrderRow
          orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          email          = "ada@example.com"
          status         = "shipped"
          carrier        = "posten"
          trackingNumber = "TRK-100200"

  // Orders that were turned down or called off, with the reason the customer was given
  feature Cancellations
    slice StateView ClosedOrders
      description "Orders that were rejected or cancelled, and why"

      readmodel ClosedOrder
        description "One order that will not be fulfilled"
        orderId OrderId key
        outcome OrderStatus
        reason  DecisionReason

      query AllClosedOrders => observable ClosedOrder[]
        description "Every rejected or cancelled order"

      projection ClosedOrderProjection => ClosedOrder
        no automap
        from OrderRejected
          outcome = "rejected"
          reason  = reason
        from OrderCancelled
          outcome = "cancelled"
          reason  = reason

      screen Cancellations
        description "Rejected and cancelled orders with their reasons"
        template blueprint Cratis.Blueprint.Default ListScreen version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader cancellationsHeader
              property title = "Cancellations"
              property subtitle = "Orders that will not be fulfilled, and why"
          list
            data ClosedOrder[] via query AllClosedOrders
            table ClosedOrder
              column orderId label "Order"
              column outcome label "Outcome"
              column reason  label "Reason"
              on double click
                navigate to OrderPage
                  with orderId from item.orderId

      specification ACancelledOrderIsListedWithItsReason
        given caller
          authenticated
          role "SalesRep"
        given OrderReceived
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b09"
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b09"
          customerId  = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email       = "ada@example.com"
          lines       = [{"sku":"ACM-2000","quantity":1,"unitPrice":899}]
          shipTo      = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          market      = "NO"
          quotedTotal = 899
        given OrderCancelled
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b09"
          reason = "The customer changed their mind"
        then readmodel ClosedOrder
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b09"
          outcome = "cancelled"
          reason  = "The customer changed their mind"

  feature Approval
    slice StateView ApprovalInbox
      description "Orders that wait for a manager's decision"

      readmodel WaitingOrder
        description "An order that nobody has decided on yet"
        orderId     OrderId key
        customerId  CustomerId
        email       EmailAddress
        quotedTotal Money

      query OrdersWaitingForApproval => observable WaitingOrder[]
        description "The manager's inbox"
        authorize IsSalesManager

      projection WaitingOrderProjection => WaitingOrder
        no automap
        from OrderReceived
          customerId  = customerId
          email       = email
          quotedTotal = quotedTotal
        remove with OrderApproved
        remove with OrderRejected
        remove with OrderCancelled

      screen ApprovalInbox
        description "Cards for the orders a manager still has to decide on"
        template blueprint Cratis.Blueprint.Default ListScreen version "^1"
          header
            title "Approval inbox"
          list
            data WaitingOrder[] via query OrdersWaitingForApproval
            table WaitingOrder
              column orderId     label "Order"
              column email       label "Customer"
              column quotedTotal label "Quoted total"
              on double click
                navigate to Decision
                  with orderId from item.orderId

      // The decision: approve or reject, one confirm dialog
      screen Decision
        description "Approve or reject the order, with the consequence spelled out"
        template blueprint Cratis.Blueprint.Default ConfirmDialog version "^1"
          actions
            action ApproveOrder
              navigate to ApprovalInbox
            action RejectOrder
              navigate to ApprovalInbox
            action ApplyLargeDiscount
              navigate to ApprovalInbox

      specification ABigOrderWaitsForAManager
        given caller
          authenticated
          role "SalesManager"
        given OrderReceived
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b02"
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b02"
          customerId  = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          email       = "grace@example.com"
          lines       = [{"sku":"ACM-2000","quantity":2,"unitPrice":899}]
          shipTo      = {"street":"1 Compiler Road","city":"Bergen","postalCode":"5003","country":"NO"}
          market      = "NO"
          quotedTotal = 1798
        then readmodel WaitingOrder
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b02"
          quotedTotal = 1798

  feature Reporting
    slice StateView SalesDashboard
      description "Ordered and confirmed revenue per order, joined from what was received and what was confirmed"

      // One projection joins two kinds of event: what came in and what was confirmed. (A figure per market would need a payload key,
      // which Stage cannot render: STAGE-ESM-017, so the figures are per order and the screen adds them up.)
      readmodel OrderFigure
        description "The revenue of one order"
        orderId          OrderId key
        market           Market
        orderedRevenue   Money
        confirmedRevenue Money optional

      query AllOrderFigures => observable OrderFigure[]
        description "The figures of every order"
        authorize IsSalesManager

      projection OrderFigureProjection => OrderFigure
        no automap
        from OrderReceived
          market         = market
          orderedRevenue = quotedTotal
        from OrderConfirmationIssued
          confirmedRevenue = quotedTotal

      screen SalesDashboard
        description "The executive view of sales"
        template blueprint Cratis.Blueprint.Default DashboardScreen version "^1"
          header
            title "Sales"
          kpis
            data OrderFigure[] via query AllOrderFigures
            table OrderFigure
              column orderId          label "Order"
              column orderedRevenue   label "Ordered"
              column confirmedRevenue label "Confirmed"
          tables
            data PipelineOrder[] via query AllPipelineOrders
            table PipelineOrder
              column orderId     label "Order"
              column quotedTotal label "Total"
              column status      label "Status"

      specification TheFiguresGrow
        given caller
          authenticated
          role "SalesManager"
        given OrderReceived
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          customerId  = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email       = "ada@example.com"
          lines       = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo      = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          market      = "NO"
          quotedTotal = 98
        given OrderConfirmationIssued
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId     = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          lines       = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo      = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          market      = "NO"
          quotedTotal = 98
        then readmodel OrderFigure
          orderId          = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          market           = "NO"
          orderedRevenue   = 98
          confirmedRevenue = 98
