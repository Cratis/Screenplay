// ============================================================
// Sales: the application's navigation and logo
//
// The order desk: the pipeline, order lookup, the approval inbox and the dashboard.
// The logo is the SVG in assets/logos/sales.svg, inlined as a data URI (tools/embed-logos.py regenerates the line): Studio and Stage take
// a Screenplay document only, never a file beside it, and a data URI cannot 404.
// ============================================================

layout SalesNavigation
  category Shell
  content

  navigation topbar
    logo image "data:image/svg+xml;base64," title "Acme Sales"

  navigation sidebar
    item sales title "Sales" icon receipt target Orders
      item pipeline title "Pipeline" target Orders.Fulfilment
      item orderlist title "Orders" target Orders.Lookup
      item inbox title "Approval inbox" target Orders.Approval
      item cancellations title "Cancellations" target Orders.Cancellations
      item dashboard title "Dashboard" target Orders.Reporting
      item pricelist title "Price list" target Orders.Intake
