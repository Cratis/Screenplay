// Purchasing / PurchaseOrders: from draft to goods received. Decisions read PurchaseOrderRow (a protected command read).
module Buying
  feature PurchaseOrders
    description "Purchase orders from draft to goods received"

    slice StateView PurchaseOrders
      description "The purchase orders being worked, and everything a decision needs to know about one"

      readmodel PurchaseOrderRow
        id                  PurchaseOrderId
        supplierId          SupplierId
        purchaseOrderNumber PurchaseOrderNumber optional
        status              PurchaseOrderStatus
        lineCount           Int
        orderedQuantity     Int
        receivedQuantity    Int

      query AllPurchaseOrders => observable PurchaseOrderRow[]
      query PurchaseOrderById => PurchaseOrderRow optional
        by id PurchaseOrderId

      projection PurchaseOrderRowProjection => PurchaseOrderRow
        no automap
        from PurchaseOrderCreated
          id  = $eventSourceId
          supplierId       = supplierId
          status           = "draft"
          lineCount        = 0
          orderedQuantity  = 0
          receivedQuantity = 0
        from PurchaseOrderLineAdded
          increment lineCount
          add orderedQuantity by quantity
        from PurchaseOrderSubmitted
          purchaseOrderNumber = purchaseOrderNumber
          status              = "submitted"
        from PurchaseOrderGoodsReceived
          add receivedQuantity by quantity
          status = "partiallyReceived"
        from PurchaseOrderCancelled
          status = "cancelled"
        remove with PurchaseOrderArchived

      screen PurchaseOrders
        template blueprint Cratis.Blueprint.Default ListScreen version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader purchaseOrdersHeader
              property title = "Purchase orders"
              property subtitle = "What has been ordered from suppliers and what has arrived"
          toolbar
            toolbar actions
              button new title "New purchase order" slice Buying.PurchaseOrders.CreatePurchaseOrder emphasis primary icon plus
          list
            data PurchaseOrderRow[] via query AllPurchaseOrders
            table PurchaseOrderRow
              column purchaseOrderNumber label "Number"
              column status           label "Status"
              column lineCount        label "Lines"
              column orderedQuantity  label "Ordered"
              column receivedQuantity label "Received"
              on double click
                navigate to PurchaseOrderPage
                  with id from item.id

      specification TheListFollowsTheOrderToItsFirstReceipt
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        given PurchaseOrderLineAdded
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          sku       = "ACM-1000"
          quantity  = 40
          unitPrice = 62
        given PurchaseOrderSubmitted
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderNumber = "PO-2026-000101"
        given PurchaseOrderGoodsReceived
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
          receiptId       = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          sku             = "ACM-1000"
          quantity        = 25
          receivedAt      = "2026-10-12T09:30:00Z"
        then readmodel PurchaseOrderRow
          id     = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderNumber = "PO-2026-000101"
          status              = "partiallyReceived"
          lineCount           = 1
          orderedQuantity     = 40
          receivedQuantity    = 25

    slice StateChange CreatePurchaseOrder
      description "Opens a draft purchase order for a supplier"

      command CreatePurchaseOrder
        purchaseOrderId PurchaseOrderId generated identifier
        supplierId      SupplierId
        produces PurchaseOrderCreated
          for purchaseOrderId
          purchaseOrderId = purchaseOrderId
          supplierId      = supplierId
        returns purchaseOrderId

      event PurchaseOrderCreated
        purchaseOrderId PurchaseOrderId
        supplierId      SupplierId

      example Nordic : CreatePurchaseOrder
        for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
        supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"

      specification OpeningADraft
        given caller
          authenticated
          role "Buyer"
        when Nordic
        then PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        then returns "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"

      // A new order is created with its supplier; its lines and the submission are actions of the order's own page
      screen NewPurchaseOrder
        description "Chooses the supplier; the lines and the submission follow on the order's page"
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action CreatePurchaseOrder
              navigate to PurchaseOrderPage

    slice StateChange AddPurchaseOrderLine
      description "Adds a SKU and quantity to a draft purchase order"

      command AddPurchaseOrderLine
        purchaseOrderId PurchaseOrderId identifier
        sku             Sku
        quantity        Quantity
        unitPrice       Money
        produces PurchaseOrderLineAdded
          for purchaseOrderId
          sku       = sku
          quantity  = quantity
          unitPrice = unitPrice

      event PurchaseOrderLineAdded
        sku       Sku
        quantity  Quantity
        unitPrice Money

      example Mugs : AddPurchaseOrderLine
        purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
        sku             = "ACM-1000"
        quantity        = 40
        unitPrice       = 62

      specification AddingALine
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        when Mugs
        then PurchaseOrderLineAdded
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          sku       = "ACM-1000"
          quantity  = 40
          unitPrice = 62

      specification AZeroQuantityIsRejected
        given caller
          authenticated
          role "Buyer"
        when Mugs quantity = 0
        then error "A quantity is at least one"

      screen AddPurchaseOrderLineDialog
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action AddPurchaseOrderLine
              navigate to PurchaseOrders

    slice StateChange SubmitPurchaseOrder
      description "Sends a purchase order to the supplier; it gets its number now and can only be submitted once"

      command SubmitPurchaseOrder
        purchaseOrderId     PurchaseOrderId identifier
        purchaseOrderNumber PurchaseOrderNumber
        reads PurchaseOrderRow as order by purchaseOrderId
        validate
          require order.lineCount > 0
            message "A purchase order needs at least one line before it is submitted"
        produces PurchaseOrderSubmitted
          for purchaseOrderId
          purchaseOrderNumber = purchaseOrderNumber

      event PurchaseOrderSubmitted
        purchaseOrderNumber PurchaseOrderNumber

      constraint OneSubmissionPerPurchaseOrder
        unique event PurchaseOrderSubmitted
        message "A purchase order is submitted once"

      constraint UniquePurchaseOrderNumber
        unique purchaseOrderNumber on PurchaseOrderSubmitted
        message "That purchase order number is already in use"

      example Submit : SubmitPurchaseOrder
        purchaseOrderId     = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
        purchaseOrderNumber = "PO-2026-000101"

      specification SubmittingADraftWithALine
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        given PurchaseOrderLineAdded
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          sku       = "ACM-1000"
          quantity  = 40
          unitPrice = 62
        when Submit
        then PurchaseOrderSubmitted
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderNumber = "PO-2026-000101"

      specification AnEmptyDraftIsNotSubmitted
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        when Submit
        then error "A purchase order needs at least one line before it is submitted"

      specification SubmittingTwiceIsRejected
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        given PurchaseOrderLineAdded
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          sku       = "ACM-1000"
          quantity  = 40
          unitPrice = 62
        given PurchaseOrderSubmitted
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderNumber = "PO-2026-000101"
        when Submit
        then error "A purchase order is submitted once"

      specification ANumberWithoutThePrefixIsRejected
        given caller
          authenticated
          role "Buyer"
        when Submit purchaseOrderNumber = "2026-000101"
        then error "A purchase order number starts with PO-"

      screen PurchaseOrderPage
        template blueprint Cratis.Blueprint.Default RecordPage version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader purchaseOrderPageHeader
              property title = "Purchase order"
              property subtitle = "Status, quantities and what the buyer may do next"
          summary
            data PurchaseOrderRow via query PurchaseOrderById by id
            summary PurchaseOrderRow
              field purchaseOrderNumber label "Number"
              field status              label "Status"
              field orderedQuantity     label "Ordered"
              field receivedQuantity    label "Received"
          related
            data PurchaseOrderRow via query PurchaseOrderById by id
            summary PurchaseOrderRow
              field lineCount label "Lines"
            action AddPurchaseOrderLine
              label "Add line"
            action SubmitPurchaseOrder
              label "Submit"
            action ReceivePurchaseOrderGoods
              label "Receive goods"
            action CancelPurchaseOrder
              label "Cancel order"
            action "Archive"
              when item.status == "received" or item.status == "cancelled" execute ArchivePurchaseOrder
                with purchaseOrderId from item.id
              otherwise hidden

      screen SubmitPurchaseOrderDialog
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action SubmitPurchaseOrder
              navigate to PurchaseOrders

    slice StateChange ReceivePurchaseOrderGoods
      description "Books goods that arrived against a submitted purchase order; one receipt is one line, so partial deliveries are just several receipts"

      command ReceivePurchaseOrderGoods
        purchaseOrderId PurchaseOrderId identifier
        receiptId       ReceiptId generated
        sku             Sku
        quantity        Quantity
        receivedAt      DateTime
        reads PurchaseOrderRow as order by purchaseOrderId
        validate
          require order.status == "submitted" or order.status == "partiallyReceived"
            message "Only a submitted purchase order can receive goods"
        produces PurchaseOrderGoodsReceived
          for purchaseOrderId
          purchaseOrderId = purchaseOrderId
          supplierId      = order.supplierId
          receiptId       = receiptId
          sku             = sku
          quantity        = quantity
          receivedAt      = receivedAt

      event PurchaseOrderGoodsReceived
        purchaseOrderId PurchaseOrderId
        supplierId      SupplierId
        receiptId       ReceiptId
        sku             Sku
        quantity        Quantity
        receivedAt      DateTime

      example GoodsReceipt : ReceivePurchaseOrderGoods
        purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
        generated receiptId = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
        sku             = "ACM-1000"
        quantity        = 25
        receivedAt      = "2026-10-12T09:30:00Z"

      // The public event the warehouse is told belongs to the outbound translation, and is specified there.
      specification GoodsAgainstASubmittedOrderAreReceived
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        given PurchaseOrderLineAdded
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          sku       = "ACM-1000"
          quantity  = 40
          unitPrice = 62
        given PurchaseOrderSubmitted
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderNumber = "PO-2026-000101"
        when GoodsReceipt
        then PurchaseOrderGoodsReceived
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
          receiptId       = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          sku             = "ACM-1000"
          quantity        = 25
          receivedAt      = "2026-10-12T09:30:00Z"

      specification GoodsAgainstADraftAreRefused
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        when GoodsReceipt
        then error "Only a submitted purchase order can receive goods"

      specification AZeroReceiptIsRefused
        given caller
          authenticated
          role "Buyer"
        when GoodsReceipt quantity = 0
        then error "A quantity is at least one"

      screen ReceivePurchaseOrderGoodsDialog
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action ReceivePurchaseOrderGoods
              navigate to PurchaseOrders

    slice StateChange CancelPurchaseOrder
      description "Cancels a purchase order that has not been received in full"

      command CancelPurchaseOrder
        purchaseOrderId PurchaseOrderId identifier
        reason          String
        produces PurchaseOrderCancelled
          for purchaseOrderId
          reason = reason

      event PurchaseOrderCancelled
        reason String

      specification CancellingADraft
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        when CancelPurchaseOrder
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          reason          = "Supplier discontinued the product"
        then PurchaseOrderCancelled
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          reason = "Supplier discontinued the product"

      screen CancelPurchaseOrderDialog
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action CancelPurchaseOrder
              navigate to PurchaseOrders

    slice StateChange ArchivePurchaseOrder
      description "Removes a closed purchase order from the working list"

      command ArchivePurchaseOrder
        purchaseOrderId PurchaseOrderId identifier
        produces PurchaseOrderArchived
          for purchaseOrderId

      event PurchaseOrderArchived

      specification ArchivingAClosedOrder
        given caller
          authenticated
          role "Buyer"
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        given PurchaseOrderCancelled
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          reason = "Supplier discontinued the product"
        when ArchivePurchaseOrder
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
        then PurchaseOrderArchived
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"

      screen ArchivePurchaseOrderDialog
        template blueprint Cratis.Blueprint.Default ConfirmDialog version "^1"
          actions
            action ArchivePurchaseOrder
              navigate to PurchaseOrders
