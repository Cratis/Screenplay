// Purchasing: buying from suppliers. Module skeleton (features are filled by the Purchasing slices).
// Inherits the application's navigation.
module Buying
  description "Suppliers, replenishment and purchase orders"
  authorize CanBuy

  feature Suppliers
  feature Sourcing
  feature Replenishment
  feature PurchaseOrders
    template blueprint Cratis.Blueprint.Default ListScreen version "^1"
  feature Demand
  feature Overview
    template blueprint Cratis.Blueprint.Default DashboardScreen version "^1"
