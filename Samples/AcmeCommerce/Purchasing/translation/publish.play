// Purchasing / outbound translation: P11 PurchaseOrderReceived, published once per receipt line.
module Buying
  feature PurchaseOrders
    slice Translate PublishGoodsReceived
      description "Goods arrived against a purchase order; the warehouse is told what, how many and when"
      direction outbound

      public event PurchaseOrderReceived
        purchaseOrderId PurchaseOrderId
        supplierId      SupplierId
        receiptId       ReceiptId
        sku             Sku
        quantity        Quantity
        receivedAt      DateTime

      projection GoodsReceivedPublisher => PurchaseOrderReceived
        from PurchaseOrderGoodsReceived
          purchaseOrderId = purchaseOrderId
          supplierId      = supplierId
          receiptId       = receiptId
          sku             = sku
          quantity        = quantity
          receivedAt      = receivedAt

      specification PublishingAReceipt
        given PurchaseOrderCreated
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
        given PurchaseOrderLineAdded
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          sku       = "ACM-1000"
          quantity  = 40
          unitPrice = 62
        given PurchaseOrderSubmitted
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderNumber = "PO-2026-000101"
        when append PurchaseOrderGoodsReceived
          for "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
          receiptId       = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          sku             = "ACM-1000"
          quantity        = 25
          receivedAt      = "2026-10-12T09:30:00Z"
        then PurchaseOrderReceived
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
          receiptId       = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          sku             = "ACM-1000"
          quantity        = 25
          receivedAt      = "2026-10-12T09:30:00Z"
