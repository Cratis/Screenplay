// Purchasing / inbound translations: what Warehouse and Sales say, in Purchasing's own language.
// The consumer-local names (...AtPurchasing) exist because one application cannot hold two events with the same name (PLAY0472);
// `from "<Origin>"` keeps the lineage. Captures cannot read list payloads, so the contracts carry one scalar line each (see README).
module Buying
  feature Replenishment
    slice Translate RequestReplenishment
      description "Warehouse says a SKU fell below its reorder point; Purchasing records a replenishment request"
      direction inbound

      // Warehouse calls the id of a crossing (MovementId); Purchasing keeps it under Warehouse's concept and reads it in its own
      // language where it uses it: as the id of the purchase order it will open
      event StockBelowReorderPointAtPurchasing from "Warehouse"
        crossingId        MovementId
        sku               Sku
        onHand            StockQuantity
        reorderPoint      StockQuantity
        suggestedQuantity Quantity

      event ReplenishmentRequested
        sku          Sku
        quantity     Quantity
        onHand       StockQuantity
        reorderPoint StockQuantity

      capture ReorderFeed
        source events
          from StockBelowReorderPointAtPurchasing
        key sku
        append ReplenishmentRequested
          when added
            sku          = $.sku
            quantity     = $.suggestedQuantity
            onHand       = $.onHand
            reorderPoint = $.reorderPoint
        append ReplenishmentRequested
          when crossingId
            sku          = $.sku
            quantity     = $.suggestedQuantity
            onHand       = $.onHand
            reorderPoint = $.reorderPoint

      specification RequestingReplenishmentForALowSku
        when append StockBelowReorderPointAtPurchasing
          crossingId        = "c0ffee00-0000-4000-8000-000000000001"
          sku               = "ACM-1000"
          onHand            = 4
          reorderPoint      = 10
          suggestedQuantity = 40
        then ReplenishmentRequested
          for "ACM-1000"
          sku          = "ACM-1000"
          quantity     = 40
          onHand       = 4
          reorderPoint = 10
        // no preferred supplier is chosen in this scenario: AutoReplenish reports the block (the full chain is specified in DraftReplenishmentOrder)
        then ReplenishmentBlocked
          for "ACM-1000"
          reason = "SkuSourcing 'ACM-1000' does not exist."

  feature Demand
    slice Translate RecordDemand
      description "Sales confirmed an order line; Purchasing records the demand for the SKU"
      direction inbound

      // Sales publishes the whole confirmed order: its id and every line
      event OrderConfirmedAtPurchasing from "Sales"
        orderId OrderId
        lines   StockLine[]

      // One demand fact per line, found by its SKU: a repeat delivery adds nothing, a delivery with one more line adds only that line
      capture DemandFeed
        source events
          from OrderConfirmedAtPurchasing
        key orderId
        children lines identified by sku
          append DemandRecorded
            when added
              orderId  = $.orderId
              sku      = $.sku
              quantity = $.quantity

      specification RecordingDemandFromAConfirmedOrder
        when append OrderConfirmedAtPurchasing
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          lines   = [{"sku":"ACM-1000","quantity":3},{"sku":"ACM-2000","quantity":1}]
        then DemandRecorded
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        then DemandRecorded
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-2000"
          quantity = 1

      // Another delivery of the same order adds only the line that is new
      specification ARepeatedDeliveryAddsOnlyTheNewLine
        given OrderConfirmedAtPurchasing
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          lines   = [{"sku":"ACM-1000","quantity":3}]
        when append OrderConfirmedAtPurchasing
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          lines   = [{"sku":"ACM-1000","quantity":3},{"sku":"ACM-2000","quantity":1}]
        then DemandRecorded
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-2000"
          quantity = 1
