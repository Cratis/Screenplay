// ============================================================
// Application / the shell's state screens: Forbidden, NotFound and Error, and the client-error report behind the Error screen
// ============================================================

concept ClientErrorId : Uuid

module Application
  description "What the shell shows when something is not allowed, not found or went wrong"
  authorize IsAuthenticated

  feature States
    description "Forbidden, not found and error screens"

    slice StateChange ReportClientError
      description "The shell reports an error a user ran into, so support can find it from the reference on the Error screen"
      command ReportClientError
        errorId ClientErrorId identifier
        details String
        produces ClientErrorReported
          for errorId
          details = details

      event ClientErrorReported
        details String

      example Crash : ReportClientError
        errorId = "e1a2b3c4-0000-4000-8000-000000000001"
        details = "The order list failed to load"

      specification ReportingAnError
        given caller
          authenticated
        when Crash
        then ClientErrorReported
          for "e1a2b3c4-0000-4000-8000-000000000001"
          details = "The order list failed to load"

      screen ReportError
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action ReportClientError

    slice StateView ClientErrors
      description "Reported errors, found by the reference the Error screen shows"

      readmodel ClientError
        errorId ClientErrorId key
        details String

      query ClientErrorById => ClientError optional
        by errorId ClientErrorId

      projection ClientErrorProjection => ClientError
        from ClientErrorReported
          errorId = $eventSourceId
          details = details

      screen Forbidden
        template blueprint Cratis.Blueprint.Default ForbiddenScreen version "^1"

      screen NotFound
        template blueprint Cratis.Blueprint.Default NotFoundScreen version "^1"

      screen Error
        template blueprint Cratis.Blueprint.Default ErrorScreen version "^1"

      specification AReportedErrorCanBeFound
        given ClientErrorReported
          for "e1a2b3c4-0000-4000-8000-000000000001"
          details = "The order list failed to load"
        then readmodel ClientError
          errorId = "e1a2b3c4-0000-4000-8000-000000000001"
          details = "The order list failed to load"
