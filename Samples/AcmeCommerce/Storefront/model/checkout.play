module Shop
  feature Checkout
    // Step 1 of the wizard: where to deliver
    slice StateChange EnterShippingAddress
      description "Wizard step 1: where the order goes"

      command EnterShippingAddress
        basketId BasketId identifier
        shipTo   PostalAddress
        produces ShippingAddressEntered
          for basketId
          shipTo = shipTo

      event ShippingAddressEntered
        shipTo PostalAddress

      specification EnteringAnAddress
        given caller
          authenticated
          role "Shopper"
        when EnterShippingAddress
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          shipTo   = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
        then ShippingAddressEntered
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          shipTo = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}

    // Step 2: how to deliver
    slice StateChange ChooseDeliveryMethod
      description "Wizard step 2: how the order is delivered"

      command ChooseDeliveryMethod
        basketId BasketId identifier
        method   DeliveryMethod
        produces DeliveryMethodChosen
          for basketId
          method = method

      event DeliveryMethodChosen
        method DeliveryMethod

      specification ChoosingExpressDelivery
        given caller
          authenticated
          role "Shopper"
        when ChooseDeliveryMethod
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          method   = "express"
        then DeliveryMethodChosen
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          method = "express"

    // What the wizard has gathered so far
    slice StateView CheckoutProgress
      description "The address and delivery method chosen so far, per basket"

      // The draft is also what the review step submits: the lines and the total come from the basket the same events built
      readmodel CheckoutDraft
        basketId BasketId key
        shipTo   PostalAddress optional
        method   DeliveryMethod optional
        lines    BasketLine[]
        total    Money optional

      query GetCheckoutDraft => CheckoutDraft optional
        by basketId BasketId

      projection CheckoutDraftProjection => CheckoutDraft
        no automap
        from ShippingAddressEntered
          shipTo = shipTo
        from DeliveryMethodChosen
          method = method
        from BasketLineAdded
          add total by unitPrice * quantity
        children lines identified by sku
          from BasketLineAdded key sku
            sku       = sku
            quantity  = quantity
            unitPrice = unitPrice
          from BasketLineQuantityChanged key sku
            quantity = quantity
          remove with BasketLineRemoved
        remove with BasketCleared

      screen Checkout
        description "Address, delivery, review: one CommandForm per step, the draft built so far shown as progress"
        template blueprint Cratis.Blueprint.Default WizardScreen version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader checkoutHeader
              property title = "Checkout"
              property subtitle = "Address, delivery, then confirm"
          progress
            data CheckoutDraft via query GetCheckoutDraft by basketId
            summary CheckoutDraft
              field shipTo label "Deliver to"
              field method label "Delivery"
          actions
            action EnterShippingAddress
              label "Enter delivery address"
            action ChooseDeliveryMethod
              label "Choose delivery"
            action CheckOut
              label "Place order"
              navigate to MyOrders

      specification TheDraftFollowsTheSteps
        given caller
          authenticated
          role "Shopper"
        given ShippingAddressEntered
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          shipTo = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
        given DeliveryMethodChosen
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          method = "express"
        then readmodel CheckoutDraft
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          method   = "express"

      specification TheDraftCarriesWhatTheBasketHolds
        given caller
          authenticated
          role "Shopper"
        given BasketLineAdded
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku       = "ACM-1000"
          quantity  = 2
          unitPrice = 49
        given DeliveryMethodChosen
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          method = "standard"
        then readmodel CheckoutDraft
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          method   = "standard"
          total    = 98
          lines    = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]

    // Step 3: review and confirm
    slice StateChange CheckOut
      description "Wizard step 3: the shopper confirms the order"

      // A guest checkout: the order gets its own identity, the shopper is the session, and what the order holds - lines, address, delivery, total - is what the
      // draft gathered. The shopper adds the one thing the draft cannot know: where the receipt goes.
      command CheckOut
        orderId    OrderId generated identifier
        basketId   BasketId
        customerId CustomerId
        email      EmailAddress
        lines      OrderLine[]
        shipTo     PostalAddress
        method     DeliveryMethod
        total      Money
        reads BasketSize by basketId

        validate
          lines not empty  message "An order needs at least one line"
          require BasketSize.lineCount > 0
            message "Your basket is empty"

        produces CheckoutCompleted
          for orderId
          orderId        = orderId
          basketId       = basketId
          customerId     = customerId
          email          = email
          lines          = lines
          shipTo         = shipTo
          deliveryMethod = method
          total          = total

      // orderId is also the event source id; a reaction can only take payload values, so it is repeated in the payload
      event CheckoutCompleted
        orderId        OrderId
        basketId       BasketId
        customerId     CustomerId
        email          EmailAddress
        lines          OrderLine[]
        shipTo         PostalAddress
        deliveryMethod DeliveryMethod
        total          Money


      specification PlacingAnOrder
        given caller
          authenticated
          role "Shopper"
        given BasketLineAdded
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku       = "ACM-1000"
          quantity  = 2
          unitPrice = 49
        when CheckOut
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          basketId   = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          customerId = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email      = "ada@example.com"
          lines      = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo     = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          method     = "standard"
          total      = 98
        // the order, and what it sets going: the basket is emptied and the public event tells Sales
        then events in any order
        then CheckoutCompleted
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          basketId       = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          customerId     = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email          = "ada@example.com"
          lines          = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo         = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          deliveryMethod = "standard"
          total          = 98
        then BasketCleared
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
        then OrderPlaced
          orderId    = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          customerId = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email      = "ada@example.com"
          lines      = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo     = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          total      = 98

      specification RejectingAnEmptyBasket
        given caller
          authenticated
          role "Shopper"
        given BasketLineAdded
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku       = "ACM-1000"
          quantity  = 2
          unitPrice = 49
        given BasketLineRemoved
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku = "ACM-1000"
        when CheckOut
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          basketId   = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          customerId = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email      = "ada@example.com"
          lines      = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo     = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          method     = "standard"
          total      = 98
        then error "Your basket is empty"

      specification RejectingACheckoutWithoutLines
        given caller
          authenticated
          role "Shopper"
        when CheckOut
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          basketId   = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          customerId = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email      = "ada@example.com"
          lines      = []
          shipTo     = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          method     = "standard"
          total      = 0
        then error "An order needs at least one line"

      screen OrderTracking
        description "Where one order stands: received, approved, shipped, delivered"
        template SideSummary
          header
            component Cratis.Blueprint.Default.pageHeader orderTrackingHeader
              property title = "Track your order"
              property subtitle = "Where this order is on its way to you"
          main
            data MyOrder via query GetMyOrder by orderId
            summary MyOrder
              field orderId        label "Order"
              field status         label "Status"
              field deliveryMethod label "Delivery"
          summary
            component Cratis.Blueprint.Default.statCard orderTotal
              property label = "Total"
              property value from query GetMyOrder.0.total
              property format = "currency"
              property currency = "NOK"
          actions
            component Cratis.Blueprint.Default.actionButton backToMyOrders
              property label = "My orders"
              on click
                navigate to MyOrders

    // AUTOMATION: a reaction that invokes a command when an event occurs
    slice Automation EmptyBasketAfterCheckout
      description "The basket is emptied once the order is placed"

      reaction ClearBasket
        description "The basket is emptied once the order is placed"
        runs as system role "Shopper"
        when CheckoutCompleted
          basketId
          invokes ClearBasketContents
            basketId = basketId

      specification ClearingTheBasketAfterCheckout
        given caller
          authenticated
          role "Shopper"
        when append CheckoutCompleted
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          basketId       = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          customerId     = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email          = "ada@example.com"
          lines          = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo         = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          deliveryMethod = "standard"
          total          = 98
        // the public event is the other consequence of the same checkout (translation/publish.play)
        then events in any order
        then BasketCleared
        then OrderPlaced
          orderId    = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          customerId = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email      = "ada@example.com"
          lines      = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo     = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          total      = 98

    slice StateChange ClearBasketContents
      description "Empties a basket (invoked by the automation, not by the shopper)"

      command ClearBasketContents
        basketId BasketId identifier
        produces BasketCleared
          for basketId

      event BasketCleared
        description "The basket was emptied (after checkout)"

      specification ClearingABasket
        given caller
          authenticated
          role "Shopper"
        when ClearBasketContents
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
        then BasketCleared
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
