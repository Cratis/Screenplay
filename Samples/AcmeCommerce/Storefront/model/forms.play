module Shop
  // One CommandForm per wizard step: the shopper meets address, delivery and review as three small forms, never as one long one.
  form ShippingAddressForm for EnterShippingAddress
    field shipTo label "Delivery address"
    on submit navigate to Checkout

  form DeliveryMethodForm for ChooseDeliveryMethod
    field method label "How should we deliver?"
    on submit navigate to Checkout

  // The review step: the draft the first two steps built pre-fills the order.
  form CheckOutForm for CheckOut
    populate via query GetCheckoutDraft by basketId
    field shipTo label "Deliver to"
    field method label "Delivery"
    field total label "Total"
    on submit navigate to MyOrders

  form RegisterCustomerForm for RegisterCustomer
    field name label "Your name"
    field email label "Email address"
    layout
      column 1 width 1fr
      column 2 width 1fr
      columnGap 24px
      rowGap 16px
      place name row 1 column 1
      place email row 1 column 2

  // Adding to the basket: the product comes from the page it is added on, the shopper picks how many
  form AddToBasketForm for AddToBasket
    field sku label "Product"
    field quantity label "How many?"
    on submit navigate to Basket
