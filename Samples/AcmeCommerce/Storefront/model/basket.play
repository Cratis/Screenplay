module Shop
  feature Basket
    slice StateChange AddToBasket
      description "Puts a listed product in the basket"

      command AddToBasket
        basketId BasketId identifier
        sku      Sku
        quantity Quantity
        reads ListedProduct by sku

        validate
          require ListedProduct.available > 0
            message "That product is out of stock"

        produces BasketLineAdded
          for basketId
          sku       = sku
          quantity  = quantity
          unitPrice = ListedProduct.displayPrice

      event BasketLineAdded
        sku       Sku
        quantity  Quantity
        unitPrice Money

      example Mug : AddToBasket
        basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
        sku      = "ACM-1000"
        quantity = 2

      specification AddingAnAvailableProduct
        given caller
          authenticated
          role "Shopper"
        given ProductListed
          for "ACM-1000"
          productId        = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          title            = "Acme mug"
          shortDescription = "A sturdy enamel mug"
          slug             = "ACM-1000"
          category         = "Kitchen"
          displayPrice     = 49
          currency         = "NOK"
          imageUrl         = "/img/acm-1000.png"
          available        = 9
        when Mug
        then BasketLineAdded
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku       = "ACM-1000"
          quantity  = 2
          unitPrice = 49

      specification RejectingAProductThatIsOutOfStock
        given caller
          authenticated
          role "Shopper"
        given ProductListed
          for "ACM-1000"
          productId        = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          title            = "Acme mug"
          shortDescription = "A sturdy enamel mug"
          slug             = "ACM-1000"
          category         = "Kitchen"
          displayPrice     = 49
          currency         = "NOK"
          imageUrl         = "/img/acm-1000.png"
          available        = 0
        when Mug
        then error "That product is out of stock"

    slice StateChange ChangeBasketQuantity
      description "Changes how many of a product the basket holds"

      command ChangeBasketQuantity
        basketId BasketId identifier
        sku      Sku
        quantity Quantity
        produces BasketLineQuantityChanged
          for basketId
          sku      = sku
          quantity = quantity

      event BasketLineQuantityChanged
        sku      Sku
        quantity Quantity

      specification ChangingAQuantity
        given caller
          authenticated
          role "Shopper"
        when ChangeBasketQuantity
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku      = "ACM-1000"
          quantity = 3
        then BasketLineQuantityChanged
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku      = "ACM-1000"
          quantity = 3

      specification RejectingAZeroQuantity
        given caller
          authenticated
          role "Shopper"
        when ChangeBasketQuantity
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku      = "ACM-1000"
          quantity = 0
        then error "A quantity is at least one"

    slice StateChange RemoveFromBasket
      description "Takes a product out of the basket"

      command RemoveFromBasket
        basketId BasketId identifier
        sku      Sku
        produces BasketLineRemoved
          for basketId
          sku = sku

      event BasketLineRemoved
        sku Sku

      specification RemovingALine
        given caller
          authenticated
          role "Shopper"
        when RemoveFromBasket
          basketId = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku      = "ACM-1000"
        then BasketLineRemoved
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku = "ACM-1000"

    // The basket as the shopper sees it: lines on the left, totals on the right (own template SideSummary)
    slice StateView BasketView
      description "The lines in a basket and what they add up to"

      readmodel BasketContents
        description "A basket with its lines"
        basketId  BasketId key
        lines     BasketLine[]

      // The count CheckOut decides on. A command's protected read refuses read models with children, so it is its own small view.
      readmodel BasketSize
        description "How many lines a basket holds"
        basketId   BasketId key
        lineCount  Int
        addedValue Money optional

      query GetBasketSize => BasketSize optional
        by basketId BasketId

      query GetBasketContents => BasketContents optional
        by basketId BasketId

      // What the shop's topbar counts: the basket indicator reads the line count of the shopper's own basket (the basket the session acts as)
      query AllBasketSizes => observable BasketSize[]
        description "Every open basket's size, or the one basket asked for"
        filter basketId BasketId optional

      query AllBaskets => observable BasketContents[]
        description "Every open basket, or the one basket asked for (a screen shows the shopper's own)"
        filter basketId BasketId optional

      projection BasketSizeProjection => BasketSize
        from BasketLineAdded
          increment lineCount
          add addedValue by unitPrice * quantity
        from BasketLineRemoved
          decrement lineCount
        remove with BasketCleared

      projection BasketContentsProjection => BasketContents
        no automap
        from BasketLineAdded
        children lines identified by sku
          from BasketLineAdded key sku
            sku       = sku
            quantity  = quantity
            unitPrice = unitPrice
          from BasketLineQuantityChanged key sku
            quantity = quantity
          remove with BasketLineRemoved
        remove with BasketCleared

      screen Basket
        description "The basket: lines beside a summary"
        template SideSummary
          header
            component Cratis.Blueprint.Default.pageHeader basketHeader
              property title = "Your basket"
              property subtitle = "Change a quantity or remove a line, then check out"
          main
            data BasketContents[] via query AllBaskets
            component Cratis.Blueprint.Default.dataList basketLines
              id "basketLines"
              property rows from query AllBaskets.0.lines
              property idField = "sku"
              property titleField = "sku"
              property selectionMode = "single"
              property label = "Basket lines"
              property columns = [{"field":"sku","header":"Product"},{"field":"quantity","header":"Qty","kind":"number"},{"field":"unitPrice","header":"Unit price","kind":"currency","currency":"NOK"}]
              on select
                navigate to Basket
                  with sku from component.basketLines.value
          summary
            data BasketSize[] via query AllBasketSizes
            summary BasketSize
              field lineCount label "Lines"
              field addedValue label "Added value"
          actions
            action ChangeBasketQuantity
              label "Change quantity"
            action RemoveFromBasket
              label "Remove line"
            toolbar basketActions
              item checkout navigate to Checkout
                label "Check out"
                icon shopping-cart

      specification SummingUpABasket
        given caller
          authenticated
          role "Shopper"
        given BasketLineAdded
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku       = "ACM-1000"
          quantity  = 2
          unitPrice = 49
        given BasketLineAdded
          for "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          sku       = "ACM-2000"
          quantity  = 1
          unitPrice = 899
        then readmodel BasketSize
          basketId   = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          lineCount  = 2
          addedValue = 997
