// Storefront OUTBOUND translation: what the shop says about itself leaves as ONE public event.
module Shop
  feature Checkout
    // P4 CheckoutCompleted -> OrderPlaced (consumed by Sales as OrderPlacedAtSales)
    slice Translate PublishOrder
      direction outbound

      public event OrderPlaced
        orderId    OrderId
        customerId CustomerId
        email      EmailAddress
        lines      OrderLine[]
        shipTo     PostalAddress
        total      Money

      projection OrderPublisher => OrderPlaced
        from CheckoutCompleted
          orderId    = $eventSourceId
          customerId = customerId
          email      = email
          lines      = lines
          shipTo     = shipTo
          total      = total

      specification PublishingACompletedCheckout
        when append CheckoutCompleted
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          basketId       = "b1a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c02"
          customerId     = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email          = "ada@example.com"
          lines          = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo         = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          deliveryMethod = "standard"
          total          = 98
        // the reactions' appends are the outcome (the appended fact itself is excluded): the basket automation and the public event
        then events in any order
        then BasketCleared
        then OrderPlaced
          orderId    = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          customerId = "c2a4e6f8-1b3d-4f5a-9c7e-2d4f6a8b0c01"
          email      = "ada@example.com"
          lines      = [{"sku":"ACM-1000","quantity":2,"unitPrice":49}]
          shipTo     = {"street":"12 Analytical Way","city":"Oslo","postalCode":"0150","country":"NO"}
          total      = 98
