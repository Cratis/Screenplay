// ============================================================
// Storefront: the application shell and look - warm and spacious: round, airy, the shop window.
//
// Each Acme domain is its own application: its own logo (see navigation.play), a theme of the shared design system, colour scheme and menu, on the shared
// platform (Cratis.Components + the Default blueprint's AppShell, ^1). The profile lists only the packages every Stage ships, so a screen
// built from stock components plays everywhere, Studio's Play included.
// ============================================================

theme AcmeStorefront
  implements AcmeDesign
  compatible with Cratis.Components
  compatible with Cratis.Blueprint.Default
  compatible with PrimeReact
  compatible with Acme.Commerce

  palette
    accent        = "#C2410C"
    accent-strong = "#9A3412"
    white         = "#FFFFFF"
    paper         = "#F8FAFC"
    ink           = "#111827"
    slate         = "#1F2937"

  values
    space.sm       = "8px"
    space.md       = "12px"
    radius.control = "12px"
    font.sans      = "source-serif-4"

  light
    color.surface        = palette.white
    color.surface-card   = palette.paper
    color.text           = palette.ink
    color.primary        = palette.accent
    color.primary-strong = palette.accent-strong
    color.on-primary     = palette.white

  dark
    color.surface        = palette.ink
    color.surface-card   = palette.slate
    color.text           = palette.white
    color.primary        = palette.accent
    color.primary-strong = palette.accent-strong
    color.on-primary     = palette.white

ui profile Storefront
  target platform web
  target size regular
  theme AcmeStorefront

  packages
    Cratis.Components
    Cratis.Blueprint.Default

  root template StorefrontShell

  identity
    name "Acme Shop"
    logo image "data:image/svg+xml;base64,"

  appearance
    color scheme light

  sample data
    active AcmeStorefront
