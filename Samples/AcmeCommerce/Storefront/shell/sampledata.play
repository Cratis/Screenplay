// ============================================================
// Storefront: the sample-data pack of this application. Design and preview time only - a production build never sees it.
// Each shape names the read model it supplies rows for. Storefront is its own application, so it carries only its own shapes.
// ============================================================

sample data AcmeStorefront
  title "Acme Storefront - Nordic"
  locale nb-NO

