// ============================================================
// The application's shell: ONE root template (a blueprint AppShell), theme, packages and the sample-data pack
//
// Every domain's screens are drawn inside this shell. The profile lists only the packages every stage ships: a screen built from
// stock components plays everywhere, Studio's Play included. The custom package Acme.Commerce (_packages/scene.commerce, see ../README.md)
// is still in the sample for `cratis render --package-set`; list it here to use its components.
// ============================================================

ui profile Web
  target platform web
  target size regular
  theme Acme

  packages
    Cratis.Components
    Cratis.Blueprint.Default

  root template blueprint Cratis.Blueprint.Default AppShell version "^1"

  appearance
    color scheme light
    accent "#0D9488"

  // The one place the active pack is chosen: demo data spans all five domains
  sample data
    active AcmeNordic
