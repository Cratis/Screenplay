// ============================================================
// The application's shell: ONE root template (a blueprint AppShell), theme, packages and the sample-data pack
//
// Every domain's screens are drawn inside this shell. The custom package Acme.Commerce (@acme/scene.commerce) is declared
// for `cratis render --package-set` (see ../README.md) but no screen uses its components any more: a stage (Studio's Play
// included) renders only the packages it ships, and a screen built from stock components plays everywhere.
// ============================================================

ui profile Web
  target platform web
  target size regular
  theme Acme

  packages
    Cratis.Components
    Cratis.Blueprint.Default
    Acme.Commerce

  root template blueprint Cratis.Blueprint.Default AppShell version "^1"

  appearance
    color scheme light
    accent "#0D9488"

  // The one place the active pack is chosen: demo data spans all five domains
  sample data
    active AcmeNordic
