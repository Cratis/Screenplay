// ============================================================
// Application-level navigation: the hierarchical sidebar (module -> feature) for all five domains, and the topbar
//
// With a blueprint root template the layout carries ONLY the regions. A domain module changes a region by
// stating a mode in its own file: Sales `extends` the sidebar, Shop `overrides` the topbar, the others inherit.
// ============================================================

layout AcmeNavigation
  category Shell
  content

  navigation topbar
    logo image "/assets/acme.svg" title "Acme"
    item shop title "Shop" target Shop
    item catalog title "Catalog" target Merchandising
    item sales title "Sales" target Orders
    item purchasing title "Purchasing" target Buying
    item warehouse title "Warehouse" target Stock
    // Application-level buttons: always at hand, whichever page the user is on, and only for who may use them
    button newProduct title "New product" slice Merchandising.Products.DraftProduct emphasis primary icon plus
      authorize CanCurateCatalog
    button registerSku title "Register SKU" slice Stock.Levels.RegisterSku emphasis secondary icon box
      authorize IsWarehouseClerk

  navigation sidebar
    item shop title "Shop" icon shopping-cart target Shop
      item browse title "Browse" target Shop.Browse
      item basket title "Basket" target Shop.Basket
      item checkout title "Checkout" target Shop.Checkout
      item myorders title "My orders" target Shop.MyOrders
    item catalog title "Catalog" icon tag target Merchandising
      item products title "Products" target Merchandising.Products
      item pricing title "Pricing" target Merchandising.Pricing
      item publication title "Publication" target Merchandising.Publication
    item sales title "Sales" icon receipt target Orders
      item pipeline title "Orders pipeline" target Orders.Fulfilment
      item inbox title "Approval inbox" target Orders.Approval
      item dashboard title "Dashboard" target Orders.Reporting
      item pricelist title "Price list" target Orders.Intake
    item purchasing title "Purchasing" icon truck target Buying
      item purchaseorders title "Purchase orders" target Buying.PurchaseOrders
      item suppliers title "Suppliers" target Buying.Suppliers
      item replenishment title "Replenishment" target Buying.Replenishment
      item preferred title "Preferred suppliers" target Buying.Sourcing
      item demand title "Demand" target Buying.Demand
      item overview title "Dashboard" target Buying.Overview
    item warehouse title "Warehouse" icon box target Stock
      item levels title "Stock levels" target Stock.Levels
      item adjustments title "Adjustments" target Stock.Adjustments
      item reservations title "Reservations" target Stock.Reservations
      item picking title "Picking" target Stock.Picking
      item receiving title "Receiving" target Stock.Receiving
      item shipments title "Shipments" target Stock.Dispatch
      item stockoverview title "Dashboard" target Stock.Overview
