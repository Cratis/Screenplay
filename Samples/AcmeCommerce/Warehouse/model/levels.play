// Warehouse / Levels: what is on the shelves. StockLevel is the one view every stock decision reads (protected command reads).
module Stock
  description "Stock levels, reservations, receiving and dispatch"
  authorize CanWorkWarehouse

  feature Levels
    description "How much of each SKU is on hand, reserved and available"

    slice StateChange RegisterSkuManually
      description "Registers a SKU by hand (normally Catalog's ProductPublished does it); it starts with the default reorder point 10"

      command RegisterSkuManually
        sku         Sku identifier
        productName ProductName
        produces SkuRegistered
          for sku
          sku         = sku
          productName = productName

      event SkuRegistered
        sku         Sku
        productName ProductName

      example Mug : RegisterSkuManually
        sku         = "ACM-1000"
        productName = "Acme mug"

      specification RegisteringASku
        given caller
          authenticated
          role "WarehouseClerk"
        when Mug
        then SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"

      specification ASkuNeedsThePrefix
        given caller
          authenticated
          role "WarehouseClerk"
        when Mug sku = "XYZ-1000"
        then error "A SKU starts with ACM-"

      screen NewSku
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action RegisterSkuManually
              navigate to StockLevels

    slice StateChange BlockSkuForReceiving
      description "Stops goods of a retired product from being received by hand"

      command BlockSkuForReceiving
        sku Sku identifier
        produces SkuBlockedForReceiving
          for sku
          sku = sku

      event SkuBlockedForReceiving
        sku Sku

      screen Block
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action BlockSkuForReceiving

    slice StateChange DecommissionSku
      description "Removes a SKU from the warehouse once its stock is gone"

      command DecommissionSku
        sku Sku identifier
        produces SkuDecommissioned
          for sku

      event SkuDecommissioned

      screen Decommission
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action DecommissionSku

    slice StateChange SetReorderPoint
      description "Tunes when a SKU is reordered and by how much"

      command SetReorderPoint
        sku          Sku identifier
        reorderPoint StockQuantity
        reorderQuantity Quantity
        produces ReorderPointSet
          for sku
          reorderPoint    = reorderPoint
          reorderQuantity = reorderQuantity

      event ReorderPointSet
        reorderPoint    StockQuantity
        reorderQuantity Quantity

      specification TuningTheReorderPoint
        given caller
          authenticated
          role "WarehouseClerk"
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        when SetReorderPoint
          sku             = "ACM-1000"
          reorderPoint    = 25
          reorderQuantity = 60
        then ReorderPointSet
          for "ACM-1000"
          reorderPoint    = 25
          reorderQuantity = 60

      screen ReorderPoint
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action SetReorderPoint

    slice StateChange AdjustStock
      description "Corrects stock after a count, damage or a find; a write-off cannot take more than is available"

      command AdjustStock
        sku          Sku identifier
        adjustmentId AdjustmentId generated
        quantity     Quantity
        increase     Bool
        reason       AdjustmentReason
        reads StockLevel as level by sku
        validate
          require increase == true or level.available >= quantity
            message "A write-off cannot exceed the available stock"
        produces when increase == true
          StockAdjustedUp
            for sku
            sku          = sku
            adjustmentId = adjustmentId
            quantity     = quantity
            reason       = reason
        produces when increase == false
          StockWrittenOff
            for sku
            sku          = sku
            adjustmentId = adjustmentId
            quantity     = quantity
            reason       = reason

      event StockAdjustedUp
        sku          Sku
        adjustmentId AdjustmentId
        quantity     Quantity
        reason       AdjustmentReason

      event StockWrittenOff
        sku          Sku
        adjustmentId AdjustmentId
        quantity     Quantity
        reason       AdjustmentReason

      specification AWriteOffCannotExceedTheAvailableStock
        given caller
          authenticated
          role "WarehouseClerk"
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        when AdjustStock
          generated adjustmentId = "a0000000-0000-4000-8000-000000000002"
          sku      = "ACM-1000"
          quantity = 5
          increase = false
          reason   = "damaged"
        then error "A write-off cannot exceed the available stock"

      specification OnlyClerksAdjustStock
        given caller
          authenticated
          role "Shopper"
        when AdjustStock
          generated adjustmentId = "a0000000-0000-4000-8000-000000000003"
          sku      = "ACM-1000"
          quantity = 5
          increase = true
          reason   = "found"
        then denied

      screen AdjustStock
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action AdjustStock
              navigate to StockLevels

    slice StateView StockLevels
      description "Every SKU with on hand, reserved, available and its reorder point"

      readmodel StockLevel
        sku             Sku key
        productName     ProductName optional
        onHand          StockQuantity
        reserved        StockQuantity
        available       StockQuantity
        reorderPoint    StockQuantity
        reorderQuantity Quantity
        status          SkuStatus optional
        // decision flag for commands (an optional enum cannot be compared): 0 = receiving open, 1 = blocked
        blocked         Int

      query AllStockLevels => observable StockLevel[]
      query StockLevelBySku => StockLevel optional
        by sku Sku

      projection StockLevelProjection => StockLevel
        from SkuRegistered
          sku             = $eventSourceId
          productName     = productName
          onHand          = 0
          reserved        = 0
          available       = 0
          reorderPoint    = 10
          reorderQuantity = 20
          status          = "active"
          blocked         = 0
        from ReorderPointSet
          sku             = $eventSourceId
          add onHand by 0
          add reserved by 0
          add available by 0
          reorderPoint    = reorderPoint
          reorderQuantity = reorderQuantity
          add blocked by 0
        from SkuBlockedForReceiving
          sku = $eventSourceId
          add onHand by 0
          add reserved by 0
          add available by 0
          add reorderPoint by 0
          add reorderQuantity by 0
          status = "blocked"
          blocked = 1
        from StockReceived
          sku = $eventSourceId
          add onHand by quantity
          add reserved by 0
          add available by quantity
          add reorderPoint by 0
          add reorderQuantity by 0
          add blocked by 0
        from StockAdjustedUp
          sku = $eventSourceId
          add onHand by quantity
          add reserved by 0
          add available by quantity
          add reorderPoint by 0
          add reorderQuantity by 0
          add blocked by 0
        from StockWrittenOff
          sku = $eventSourceId
          subtract onHand by quantity
          add reserved by 0
          subtract available by quantity
          add reorderPoint by 0
          add reorderQuantity by 0
          add blocked by 0
        from ReservationMade
          sku = $eventSourceId
          add onHand by 0
          add reserved by quantity
          subtract available by quantity
          add reorderPoint by 0
          add reorderQuantity by 0
          add blocked by 0
        from StockShipped
          sku = $eventSourceId
          subtract onHand by quantity
          subtract reserved by quantity
          add available by 0
          add reorderPoint by 0
          add reorderQuantity by 0
          add blocked by 0
        remove with SkuDecommissioned

      screen StockLevels
        template blueprint Cratis.Blueprint.Default ListScreen version "^1"
          toolbar
            toolbar actions
              button adjust title "Adjust stock" slice Stock.Levels.AdjustStock emphasis quiet icon sliders
              button register title "New SKU" slice Stock.Levels.RegisterSkuManually emphasis quiet icon plus
              button reorder title "Reorder point" slice Stock.Levels.SetReorderPoint emphasis quiet icon bell
          list
            data StockLevel[] via query AllStockLevels
            table StockLevel
              column sku          label "SKU"
              column productName  label "Product"
              column onHand       label "On hand"
              column reserved     label "Reserved"
              column available    label "Available"
              column reorderPoint label "Reorder point"
              on row-click navigate to ItemPage by sku

      screen ItemPage
        template blueprint Cratis.Blueprint.Default RecordPage version "^1"
          summary
            data StockLevel via query StockLevelBySku by sku
            summary StockLevel
              field sku          label "SKU"
              field productName  label "Product"
              field onHand       label "On hand"
              field reserved     label "Reserved"
              field available    label "Available"
              field reorderPoint label "Reorder point"
              field status       label "Status"

      specification ReceivingAndReservingMovesTheLevels
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        given StockReceived
          for "ACM-1000"
          sku       = "ACM-1000"
          receiptId = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          quantity  = 50
        given ReservationMade
          for "ACM-1000"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        then readmodel StockLevel
          sku          = "ACM-1000"
          onHand       = 50
          reserved     = 3
          available    = 47
          reorderPoint = 10
