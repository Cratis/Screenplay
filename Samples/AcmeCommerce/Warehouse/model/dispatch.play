// ============================================================
// Warehouse / Stock / Dispatch - the parcel leaves the building
// ============================================================

module Stock
  feature Dispatch
    // Goods leave: the clerk dispatches from the shipments list.
    toolbar actions
      button dispatch title "Dispatch shipment" slice Stock.Dispatch.DispatchShipment emphasis primary icon send

    slice StateChange DispatchShipment
      description "Hands a packed parcel to the carrier. A shipment is dispatched once"
      command DispatchShipment
        orderId        OrderId identifier
        carrier        Carrier
        trackingNumber TrackingNumber
        shipmentId     ShipmentId generated
        reads PickingCard by orderId
        validate
          require PickingCard.status == packed
            message "The parcel is not packed"
        produces ShipmentHandedToCarrier
          for orderId
          orderId        = orderId
          shipmentId     = shipmentId
          carrier        = carrier
          trackingNumber = trackingNumber
          sku            = PickingCard.sku
          quantity       = PickingCard.quantity
          dispatchedAt   = $context.occurred

      event ShipmentHandedToCarrier
        orderId        OrderId
        shipmentId     ShipmentId
        carrier        Carrier
        trackingNumber TrackingNumber
        sku            Sku
        quantity       Quantity
        dispatchedAt   DateTime

      constraint OneDispatchPerShipment
        unique event ShipmentHandedToCarrier
        message "A shipment is dispatched once"

      example Handover : DispatchShipment
        orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
        carrier        = posten
        trackingNumber = "RR123456789NO"

      // The accepted path (and the public dispatch it triggers) is specified in PublishDispatch
      specification DispatchingBeforePackingIsRejected
        given caller
          authenticated
          role "WarehouseClerk"
        given ShipmentPlanned
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        when Handover
        then error "The parcel is not packed"

      // Defence in depth: even when two clerks race past the status check, the event itself can be appended once per shipment
      specification AShipmentIsDispatchedOnce
        given ShipmentPlanned
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        given ShipmentHandedToCarrier
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId     = "5e5e5e5e-0c0d-4c6a-9a41-3b6a1a0e6001"
          carrier        = posten
          trackingNumber = "RR123456789NO"
          sku            = "ACM-1000"
          quantity       = 3
          dispatchedAt   = "2026-10-02T14:00:00Z"
        when append ShipmentHandedToCarrier
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId     = "5e5e5e5e-0c0d-4c6a-9a41-3b6a1a0e6002"
          carrier        = dhl
          trackingNumber = "DHL-0001"
          sku            = "ACM-1000"
          quantity       = 3
          dispatchedAt   = "2026-10-02T15:00:00Z"
        then error "A shipment is dispatched once"

      specification ATrackingNumberIsRequired
        given caller
          authenticated
          role "WarehouseClerk"
        when Handover trackingNumber = ""
        then error "A tracking number is required"

      screen DispatchShipmentDialog
        template blueprint Cratis.Blueprint.Default QuickCreateDialog version "^1"
          actions
            action DispatchShipment
              navigate to Shipments

    // The stock leaves the shelf when the parcel is handed over
    slice Automation TakeStockWhenDispatched
      reaction TakeStockWhenDispatchedReaction
        description "A dispatched parcel takes its units off the shelf and releases the reservation"
        runs as system role "WarehouseClerk"
        when ShipmentHandedToCarrier
          orderId
          sku
          quantity
          invokes TakeDispatchedStock
            sku      = sku
            orderId  = orderId
            quantity = quantity

      specification DispatchingTakesTheUnitsOffTheShelf
        given SkuRegistered
          for "ACM-1000"
          sku = "ACM-1000"
          name = "Acme mug"
        given StockReceived
          for "ACM-1000"
          sku             = "ACM-1000"
          purchaseOrderId = "7b2f4a3e-0c0d-4c6a-9a41-3b6a1a0e4001"
          quantity        = 40
          receivedAt      = "2026-10-02T09:00:00Z"
        given ReservationMade
          for "ACM-1000"
          sku        = "ACM-1000"
          orderId    = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          quantity   = 3
          movementId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
        given ShipmentPlanned
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        when append ShipmentHandedToCarrier
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId     = "5e5e5e5e-0c0d-4c6a-9a41-3b6a1a0e6001"
          carrier        = posten
          trackingNumber = "RR123456789NO"
          sku            = "ACM-1000"
          quantity       = 3
          dispatchedAt   = "2026-10-02T14:00:00Z"
        // taking the units off is TakeDispatchedStock's; the snapshot and the public dispatch are the other slices'
        then invokes TakeDispatchedStock
          sku      = "ACM-1000"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          quantity = 3

    slice StateChange TakeDispatchedStock
      command TakeDispatchedStock
        sku      Sku identifier
        orderId  OrderId
        quantity Quantity
        produces StockDispatched
          for sku
          sku      = sku
          orderId  = orderId
          quantity = quantity

      event StockDispatched
        sku      Sku
        orderId  OrderId
        quantity Quantity

      example TakeOff : TakeDispatchedStock
        sku      = "ACM-1000"
        orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
        quantity = 3

      specification TakingDispatchedStockOffTheShelf
        given caller
          authenticated
          role "WarehouseClerk"
        given SkuRegistered
          for "ACM-1000"
          sku  = "ACM-1000"
          name = "Acme mug"
        given StockReceived
          for "ACM-1000"
          sku             = "ACM-1000"
          purchaseOrderId = "7b2f4a3e-0c0d-4c6a-9a41-3b6a1a0e4001"
          quantity        = 40
          receivedAt      = "2026-10-02T09:00:00Z"
        when TakeOff
        then StockDispatched
          for "ACM-1000"
          sku      = "ACM-1000"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          quantity = 3

      specification ASalesRepCannotTakeStockOffTheShelf
        given caller
          authenticated
          role "SalesRep"
        when TakeOff
        then denied

    slice StateView Shipments
      description "Every parcel with its carrier and tracking number"

      readmodel ShipmentRow
        orderId        OrderId key
        sku            Sku
        quantity       Quantity
        status         ShipmentStatus
        carrier        Carrier optional
        trackingNumber TrackingNumber optional
        dispatchedAt   DateTime optional

      query AllShipments => observable ShipmentRow[]

      projection ShipmentRowProjection => ShipmentRow
        no automap
        from ShipmentPlanned
          orderId  = $eventSourceId
          sku      = sku
          quantity = quantity
          status   = "toPick"
        from ShipmentPickingStarted
          status = "picking"
        from ShipmentPacked
          status = "packed"
        from ShipmentHandedToCarrier
          status         = "dispatched"
          carrier        = carrier
          trackingNumber = trackingNumber
          dispatchedAt   = dispatchedAt

      screen Shipments
        template blueprint Cratis.Blueprint.Default ListScreen version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader shipmentsHeader
              property title = "Shipments"
              property subtitle = "Every parcel with its carrier and tracking number"
          toolbar
            action DispatchShipment
              label "Dispatch"
            // The stage of the selected parcel decides what can be done to it; the Picking board only shows the stages.
            data ShipmentRow[] via query AllShipments
            action "Pick order"
              when item.status == "toPick" execute PickOrder
                with orderId from item.orderId
              otherwise hidden
            action "Pack"
              when item.status == "picking" execute PackShipment
                with orderId from item.orderId
              otherwise hidden
            action "Cancel shipment"
              when item.status == "toPick" or item.status == "picking" execute CancelShipment
                with orderId from item.orderId
              otherwise hidden
          list
            data ShipmentRow[] via query AllShipments
            table ShipmentRow
              column orderId        label "Order"
              column sku            label "SKU"
              column quantity       label "Qty"
              column status         label "Status"
              column carrier        label "Carrier"
              column trackingNumber label "Tracking"

      specification ADispatchedParcelCarriesItsTracking
        given ShipmentPlanned
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        given ShipmentHandedToCarrier
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId     = "5e5e5e5e-0c0d-4c6a-9a41-3b6a1a0e6001"
          carrier        = posten
          trackingNumber = "RR123456789NO"
          sku            = "ACM-1000"
          quantity       = 3
          dispatchedAt   = "2026-10-02T14:00:00Z"
        then readmodel ShipmentRow
          orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          status         = "dispatched"
          carrier        = "posten"
          trackingNumber = "RR123456789NO"
