// Warehouse / inbound translations: what Catalog, Sales and Purchasing say, in the Warehouse's own language.
// Consumer-local names (...AtWarehouse) exist because one application cannot hold two events with the same name (PLAY0472);
// `from "<Origin>"` keeps the lineage. Captures cannot read list payloads, so the contracts carry one scalar line each (see README).
// Every capture is keyed by SKU so its event lands on the StockItem stream; a second append (`when <id>`) catches every later
// delivery for the SKU (`when added` only holds for the first one).
module Stock
  feature Levels
    slice Translate RegisterSku
      description "Catalog published a product; the warehouse registers its SKU with the default reorder point"
      direction inbound

      event ProductPublishedAtWarehouse from "Catalog"
        productId ProductId
        sku       Sku
        name      ProductName

      capture ProductFeed
        source events
          from ProductPublishedAtWarehouse
        key sku
        append SkuRegistered
          when added
            sku         = $.sku
            productName = $.name

      specification RegisteringAPublishedProduct
        when append ProductPublishedAtWarehouse
          productId = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          sku       = "ACM-1000"
          name      = "Acme mug"
        then SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"

    slice Translate BlockSku
      description "Catalog retired a product; the warehouse stops receiving its SKU by hand"
      direction inbound

      event ProductRetiredAtWarehouse from "Catalog"
        productId ProductId
        sku       Sku

      capture RetirementFeed
        source events
          from ProductRetiredAtWarehouse
        key sku
        append SkuBlockedForReceiving
          when added
            sku = $.sku

      specification BlockingARetiredProduct
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        when append ProductRetiredAtWarehouse
          productId = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          sku       = "ACM-1000"
        then SkuBlockedForReceiving
          for "ACM-1000"
          sku = "ACM-1000"

  feature Reservations
    slice Translate RequestReservation
      description "Sales confirmed an order line; the warehouse is asked to reserve the SKU"
      direction inbound

      event OrderConfirmedAtWarehouse from "Sales"
        orderId  OrderId
        sku      Sku
        quantity Quantity

      capture ReservationFeed
        source events
          from OrderConfirmedAtWarehouse
        key sku
        append ReservationRequested
          when added
            orderId  = $.orderId
            sku      = $.sku
            quantity = $.quantity
        append ReservationRequested
          when orderId
            orderId  = $.orderId
            sku      = $.sku
            quantity = $.quantity

      specification ReservingForAConfirmedOrder
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        given StockReceived
          for "ACM-1000"
          sku       = "ACM-1000"
          receiptId = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          quantity  = 50
        when append OrderConfirmedAtWarehouse
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        then ReservationRequested
          for "ACM-1000"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku = "ACM-1000"
          quantity = 3
        then ReservationMade
          for "ACM-1000"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku = "ACM-1000"
          quantity = 3
        then StockReserved
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku = "ACM-1000"
          quantity = 3
        then ShipmentPrepared
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku = "ACM-1000"
          quantity = 3
        then StockLevelRecorded
          for "ACM-1000"
          sku = "ACM-1000"
          onHand = 50
          available = 47
        then StockLevelChanged
          sku = "ACM-1000"
          onHand = 50
          available = 47

  feature Receiving
    slice Translate ReceiveStock
      description "Purchasing received goods against a purchase order; the stock goes on the shelf"
      direction inbound

      event PurchaseOrderReceivedAtWarehouse from "Purchasing"
        purchaseOrderId PurchaseOrderId
        supplierId      SupplierId
        receiptId       ReceiptId
        sku             Sku
        quantity        Quantity
        receivedAt      DateTime

      capture ReceiptFeed
        source events
          from PurchaseOrderReceivedAtWarehouse
        key sku
        append StockReceived
          when added
            sku       = $.sku
            receiptId = $.receiptId
            quantity  = $.quantity
        append StockReceived
          when receiptId
            sku       = $.sku
            receiptId = $.receiptId
            quantity  = $.quantity

      specification ShelvingGoodsFromAPurchaseOrder
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        when append PurchaseOrderReceivedAtWarehouse
          purchaseOrderId = "7b1c2d3e-4f50-4a61-8b72-9c0d1e2f3a01"
          supplierId      = "5a0b7c1e-2d4f-4a6b-8c9d-0e1f2a3b4c01"
          receiptId       = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          sku             = "ACM-1000"
          quantity        = 25
          receivedAt      = "2026-10-12T09:30:00Z"
        then StockReceived
          for "ACM-1000"
          sku = "ACM-1000"
          receiptId = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          quantity = 25
        then StockLevelRecorded
          for "ACM-1000"
          sku = "ACM-1000"
          onHand = 25
          available = 25
        then StockLevelChanged
          sku = "ACM-1000"
          onHand = 25
          available = 25
