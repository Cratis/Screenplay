// Warehouse / outbound translations: P7 StockReserved, P8 StockReservationFailed, P9 StockLevelChanged,
// P10 StockBelowReorderPoint and P12 ShipmentDispatched. Each is the only way the rest of the company sees the event.
module Stock
  feature Reservations
    slice Translate PublishReservation
      description "Sales is told the stock for an order line was reserved (P7)"
      direction outbound

      public event StockReserved
        orderId  OrderId
        sku      Sku
        quantity Quantity

      projection ReservedPublisher => StockReserved
        from ReservationMade
          orderId  = orderId
          sku      = sku
          quantity = quantity

      specification PublishingAReservation
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        given StockReceived
          for "ACM-1000"
          sku       = "ACM-1000"
          receiptId = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          quantity  = 50
        when append ReservationMade
          for "ACM-1000"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        then StockReserved
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku = "ACM-1000"
          quantity = 3
        then ShipmentPrepared
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku = "ACM-1000"
          quantity = 3
        then StockLevelRecorded
          for "ACM-1000"
          sku = "ACM-1000"
          onHand = 50
          available = 47
        then StockLevelChanged
          sku = "ACM-1000"
          onHand = 50
          available = 47

    slice Translate PublishReservationFailure
      description "Sales is told the stock for an order line could not be reserved (P8); shortBy is the quantity that was refused"
      direction outbound

      public event StockReservationFailed
        orderId OrderId
        sku     Sku
        shortBy Quantity

      projection ReservationFailedPublisher => StockReservationFailed
        from ReservationFailed
          orderId = orderId
          sku     = sku
          shortBy = shortBy

      specification PublishingAFailedReservation
        when append ReservationFailed
          for "ACM-1000"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku     = "ACM-1000"
          shortBy = 3
          reason  = "Not enough stock is available"
        then StockReservationFailed
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku     = "ACM-1000"
          shortBy = 3

    slice Translate PublishLowStock
      description "Purchasing is told that a SKU fell below its reorder point (P10)"
      direction outbound

      public event StockBelowReorderPoint
        crossingId        OrderId
        sku               Sku
        onHand            StockQuantity
        reorderPoint      StockQuantity
        suggestedQuantity Quantity

      projection LowStockPublisher => StockBelowReorderPoint
        from ReorderPointCrossed
          crossingId        = crossingId
          sku               = sku
          onHand            = onHand
          reorderPoint      = reorderPoint
          suggestedQuantity = suggestedQuantity

      specification PublishingALowStockAlert
        when append ReorderPointCrossed
          for "ACM-1000"
          crossingId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku               = "ACM-1000"
          onHand            = 9
          reorderPoint      = 10
          suggestedQuantity = 20
        then StockBelowReorderPoint
          crossingId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku               = "ACM-1000"
          onHand            = 9
          reorderPoint      = 10
          suggestedQuantity = 20

  feature Levels
    slice Translate PublishStockLevel
      description "The shop is told how much of a SKU is on hand and available (P9)"
      direction outbound

      public event StockLevelChanged
        sku       Sku
        onHand    StockQuantity
        available StockQuantity

      projection StockLevelPublisher => StockLevelChanged
        from StockLevelRecorded
          sku       = sku
          onHand    = onHand
          available = available

      specification PublishingALevel
        when append StockLevelRecorded
          for "ACM-1000"
          sku       = "ACM-1000"
          onHand    = 50
          available = 47
        then StockLevelChanged
          sku       = "ACM-1000"
          onHand    = 50
          available = 47

  feature Shipments
    slice Translate PublishDispatch
      description "Sales is told which carrier took the order and under which tracking number (P12)"
      direction outbound

      public event ShipmentDispatched
        orderId        OrderId
        shipmentId     ShipmentId
        carrier        Carrier
        trackingNumber TrackingNumber
        dispatchedAt   DateTime

      projection DispatchPublisher => ShipmentDispatched
        from ShipmentHandedToCarrier
          orderId        = orderId
          shipmentId     = shipmentId
          carrier        = carrier
          trackingNumber = trackingNumber
          dispatchedAt   = dispatchedAt

      specification PublishingADispatch
        given SkuRegistered
          for "ACM-1000"
          sku         = "ACM-1000"
          productName = "Acme mug"
        given StockReceived
          for "ACM-1000"
          sku       = "ACM-1000"
          receiptId = "9d3e4f50-6172-4a83-8b94-0c1d2e3f4a01"
          quantity  = 50
        given ReservationMade
          for "ACM-1000"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        given ShipmentPrepared
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId  = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          sku      = "ACM-1000"
          quantity = 3
        given ShipmentPicked
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
        given ShipmentPacked
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
        when append ShipmentHandedToCarrier
          for "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          orderId        = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId     = "5e000000-0000-4000-8000-000000000001"
          carrier        = "posten"
          trackingNumber = "370712345678"
          dispatchedAt   = "2026-10-12T13:05:00Z"
          sku            = "ACM-1000"
          quantity       = 3
        then ShipmentDispatched
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          shipmentId = "5e000000-0000-4000-8000-000000000001"
          carrier = "posten"
          trackingNumber = "370712345678"
          dispatchedAt = "2026-10-12T13:05:00Z"
        then StockShipped
          for "ACM-1000"
          sku = "ACM-1000"
          orderId = "0e7d9b1a-3c5f-4a2e-8d6b-7c9e1f2a3b01"
          quantity = 3
        then StockLevelRecorded
          for "ACM-1000"
          sku = "ACM-1000"
          onHand = 47
          available = 47
        then StockLevelChanged
          sku = "ACM-1000"
          onHand = 47
          available = 47
