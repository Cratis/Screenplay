// ============================================================
// Catalog / Merchandising / Pricing - the price list and the board that shows products by status
// ============================================================

module Merchandising
  feature Pricing
    description "What each product costs"

    slice StateChange SetProductPrice
      description "Sets the selling price of a product; a price below zero is refused by the Money concept"
      command SetProductPrice
        productId ProductId identifier
        price     Money
        currency  CurrencyCode
        effectiveFrom Date
        produces ProductPriceSet
          for productId
          price    = price
          currency = currency
          effectiveFrom = effectiveFrom

      event ProductPriceSet
        price    Money
        currency CurrencyCode
        effectiveFrom Date

      // The accepted path states the public event the price change is published as (PublishPriceChange translates it).
      specification SettingAPriceIsPublished
        given caller
          authenticated
          role "Merchandiser"
        given ProductDrafted
          for "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          sku      = "ACM-1000"
          name     = "Acme mug"
          category = "Kitchen"
        when SetProductPrice
          productId = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          price     = 59
          currency  = "NOK"
          effectiveFrom = "2026-03-01"
        then ProductPriceSet
          price    = 59
          currency = "NOK"
          effectiveFrom = "2026-03-01"
        then ProductPriceChanged
          productId     = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          sku           = "ACM-1000"
          newPrice      = 59
          currency      = "NOK"
          effectiveFrom = "2026-03-01"

      specification APriceBelowZeroIsRejected
        given caller
          authenticated
          role "Merchandiser"
        when SetProductPrice
          productId = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          price     = -1
          currency  = "NOK"
          effectiveFrom = "2026-03-01"
        then error "An amount cannot be negative"

    slice StateView PricingBoard
      description "Products as cards in columns by status"

      readmodel PricedProduct
        productId ProductId
        sku       Sku
        name      ProductName
        price     Money
        status    ProductStatus

      query AllPricedProducts => observable PricedProduct[]

      projection PricedProductProjection => PricedProduct
        from ProductDrafted
          productId = $eventSourceId
          sku       = sku
          name      = name
          price     = 0
          status    = "draft"
        from ProductPriceSet
          price = price
        from ProductApprovedForSale
          status = "approved"
        from ProductWithdrawn
          status = "withdrawn"

      screen PricingBoard
        template blueprint Cratis.Blueprint.Default BoardScreen version "^1"
          header
            component Cratis.Blueprint.Default.pageHeader pricingHeader
              property title = "Pricing"
              property subtitle = "Products by status - set a price to make one ready"
          board
            data PricedProduct[] via query AllPricedProducts
            table PricedProduct
              column sku    label "SKU"
              column name   label "Product"
              column price  label "Price"
              column status label "Status"
              on double click
                navigate to ProductPage
                  with productId from item.productId

      specification TheBoardFollowsTheStatus
        given ProductDrafted
          for "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          sku         = "ACM-1000"
          name        = "Acme mug"
          category    = "Kitchen"
        given ProductWithdrawn
          for "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          sku = "ACM-1000"
        then readmodel PricedProduct
          productId = "6f1f4a3e-0c0d-4c6a-9a41-3b6a1a0e1001"
          status    = "withdrawn"
