// ============================================================
// Catalog: the application's navigation and logo
//
// The merchandiser's back office: products, pricing, publication and the catalog dashboard, with the one thing done most often - a new product - always at hand.
// The logo is the SVG in assets/logos/catalog.svg, inlined as a data URI (tools/embed-logos.py regenerates the line): Studio and Stage take
// a Screenplay document only, never a file beside it, and a data URI cannot 404.
// ============================================================

layout CatalogNavigation
  category Shell
  content

  navigation topbar
    logo image "data:image/svg+xml;base64," title "Acme Catalog"
    button newProduct title "New product" slice Merchandising.Products.DraftProduct emphasis primary icon plus
      authorize CanCurateCatalog

  navigation sidebar
    item catalog title "Catalog" icon tag target Merchandising
      item products title "Products" target Merchandising.Products
      item pricing title "Pricing" target Merchandising.Pricing
      item publication title "Publication" target Merchandising.Publication
      item catalogdashboard title "Dashboard" target Merchandising.Reporting
