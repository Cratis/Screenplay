// The last step of the chase: a week still undecided after the reminder is escalated.
slice StateChange EscalateApproval
  description "Raises a week that nobody has decided, even after a reminder, with the manager's own manager"
  command EscalateApproval
    timesheetId TimesheetId identifier
    authorize IsEngagementManager
    produces ApprovalEscalated
      for timesheetId
      timesheetId = timesheetId
      raisedAt    = $context.occurred
  event ApprovalEscalated
    timesheetId TimesheetId
    raisedAt    DateTime
  screen EscalateApprovalDialog
    template TimesheetDialog
      body
        title "Escalate the approval"
      actions
        action EscalateApproval
          label "Escalate"
  specification TheApprovalIsEscalated
    given caller
      authenticated
      role "EngagementManager"
    given clock "2026-10-02T09:00:00Z"
    when EscalateApproval
      timesheetId = "7e1f3a5b-9c2d-4e6f-8a0b-1c3d5e7f9a41"
    then ApprovalEscalated
      for "7e1f3a5b-9c2d-4e6f-8a0b-1c3d5e7f9a41"
      timesheetId = "7e1f3a5b-9c2d-4e6f-8a0b-1c3d5e7f9a41"
      raisedAt    = "2026-10-02T09:00:00Z"
  specification ConsultantsCannotEscalateApproval
    given caller
      authenticated
      role "Consultant"
    when EscalateApproval
      timesheetId = "7e1f3a5b-9c2d-4e6f-8a0b-1c3d5e7f9a41"
    then denied
