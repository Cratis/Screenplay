// The domain's values and the rules that travel with them. A rule on a concept
// holds on every command that carries the value, wherever it is declared.

concept ClientName : String
  validate
    not empty  message "A client needs a name"
    max 120    message "A client name is at most 120 characters"

// A message can be a $strings key instead of a literal - the text then lives
// in timetracking.<locale>.strings.
concept EngagementName : String
  validate
    not empty  message $strings.engagements.validation.nameRequired
    max 120    message "An engagement name is at most 120 characters"

// A day's hours.
concept Hours : Decimal
  validate
    > 0    message $strings.timesheets.validation.hoursPositive
    <= 24  message $strings.timesheets.validation.hoursPerDay

// A week's hours - a different value with different bounds, so a different concept.
concept WeeklyHours : Decimal
  validate
    >= 0    message "Weekly hours cannot be negative"
    <= 168  message "A week has 168 hours"

concept HourlyRate : Decimal
  validate
    >= 0  message "A rate cannot be negative"

concept TimesheetYear : Int
  validate
    min 2020  message "Time before 2020 is recorded in the old system"

concept WeekNumber : Int
  validate
    min 1   message "Weeks are numbered from 1"
    max 53  message "A year has at most 53 weeks"

concept WorkDate : Date

concept ActivityCode : String
  validate
    matches "^[A-Z]{3}-[0-9]{2}$"  severity warning message "An activity code looks like DEV-01"

concept RejectionReason : String
  validate
    max 500  message "Keep the reason under 500 characters"

concept CountryCode : String
  validate
    length == 2  message "A country is a two-letter ISO code"

concept HolidayName : String
