<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Screenplay.Mcp</AssemblyName>
        <RootNamespace>Cratis.Screenplay.Mcp</RootNamespace>
        <PackageId>Cratis.Screenplay.Mcp</PackageId>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <IsPackable>true</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- This new package has no 4.0.0 baseline. Keep package validation enabled. -->
        <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
        <Description>Embeddable MCP server for Cratis Screenplay model navigation and authoring</Description>
        <PackageTags>cratis;screenplay;dsl;mcp</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Screenplay/Screenplay.csproj" />
        <ProjectReference Include="../Screenplay.CanonicalCorpus/Screenplay.CanonicalCorpus.csproj" Condition="'$(Configuration)'=='Debug'" />
        <InternalsVisibleTo Include="Cratis.Screenplay.Tool" />
    </ItemGroup>

    <!-- The event model board hosts render beside the conversation (MCP Apps). It is built by the
         @cratis/screenplay-mcp-app workspace: yarn workspaces foreach -Rt from @cratis/screenplay-mcp-app run build.
         Without it the server still runs, and offers no views. -->
    <PropertyGroup>
        <EventModelBoardPage>$(MSBuildProjectDirectory)/../../Screenplay/McpApp/dist/event-model-board.html</EventModelBoardPage>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="$(EventModelBoardPage)" LogicalName="Cratis.Screenplay.Mcp.Apps.event-model-board.html" Condition="Exists('$(EventModelBoardPage)')" />
    </ItemGroup>
    <Target Name="RequireEventModelBoardForPack" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('$(EventModelBoardPage)')" Text="Build the event model board before packing: yarn workspaces foreach -Rt --from @cratis/screenplay-mcp-app run build" />
    </Target>
</Project>
