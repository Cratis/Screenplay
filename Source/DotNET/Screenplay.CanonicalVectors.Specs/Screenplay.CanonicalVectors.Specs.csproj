                          WithCulture="false"
                          LogicalName="Cratis.Screenplay.CanonicalVectors.Conformance.stream-id-codec.json" />
        <EmbeddedResource Include="../../../Documentation/screenplay/interoperability.md"
                          Link="Documentation/interoperability.md"
                          WithCulture="false"
                          LogicalName="Cratis.Screenplay.CanonicalVectors.Documentation.interoperability.md" />
        <EmbeddedResource Include="../Screenplay/for_ScreenplayCompiler/invoicing.play"
                          Link="Samples/invoicing.play"
