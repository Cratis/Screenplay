<Project>
    <!-- Evaluate the final opt-in after library and dedicated-spec project overrides. -->
    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsTestProject)' == 'true'">
        <PackageReference Include="Cratis.Specifications" PrivateAssets="all" />
        <PackageReference Include="Cratis.Specifications.XUnit.v3" PrivateAssets="all" />
        <PackageReference Include="xunit.v3.mtp-off" PrivateAssets="all" />
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
        <PackageReference Include="NSubstitute" Condition="'$(DedicatedSpecsProject)' != 'true'" />
    </ItemGroup>

    <!--
        Strips the inline specs (when_*/, for_*/, given/ and Specs/ folders) from Release builds. This lives in
        Directory.Build.targets - not Directory.Build.props - because the SDK's default Compile items do not
        exist yet when the props evaluate, which would make the removes silent no-ops.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Release' AND '$(DedicatedSpecsProject)' != 'true'">
        <Compile Remove="$(MSBuildProjectDirectory)/**/when_*/**/*.cs" />
        <Compile Remove="$(MSBuildProjectDirectory)/**/for_*/**/*.cs" />
        <Compile Remove="$(MSBuildProjectDirectory)/**/given/**/*.cs" />
        <Compile Remove="$(MSBuildProjectDirectory)/Specs/*.cs" />
    </ItemGroup>
</Project>
