<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Cratis.Screenplay.Tool</AssemblyName>
        <RootNamespace>Cratis.Screenplay.Tool</RootNamespace>
        <PackageId>Cratis.Screenplay.Tool</PackageId>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <RuntimeIdentifiers></RuntimeIdentifiers>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>screenplay</ToolCommandName>
        <Description>Compile and verify Cratis Screenplay (.play) models and host the Screenplay MCP server, including the event model board for MCP Apps</Description>
        <PackageTags>cratis;event-sourcing;event-modeling;cqrs;screenplay;dsl;compiler;dotnet-tool</PackageTags>
        <NoWarn>$(NoWarn);CS7022</NoWarn>
        <XunitAutoGeneratedEntryPoint Condition="'$(Configuration)'=='Debug'">false</XunitAutoGeneratedEntryPoint>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="$(MSBuildProjectDirectory)/../../../README.md" />
        <None Update="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Screenplay/Screenplay.csproj" />
        <ProjectReference Include="../Screenplay.Contracts/Screenplay.Contracts.csproj" />
        <ProjectReference Include="../Screenplay.CanonicalCorpus/Screenplay.CanonicalCorpus.csproj" Condition="'$(Configuration)'=='Debug'" />
        <ProjectReference Include="../Screenplay.Mcp/Screenplay.Mcp.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetDir)screenplay-contract.json" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)'=='Release'">
        <FileWrites Include="$(IntermediateOutputPath)screenplay-contract.stamp" />
    </ItemGroup>
    <!-- The contract is produced by reflection over the loaded assemblies only (no files are read at run time), so the tool and its copy-local dlls are the complete input set. -->
    <Target Name="GenerateScreenplayContract" AfterTargets="Build" Condition="'$(Configuration)'=='Release' AND '$(TargetFramework)'!=''" Inputs="$(TargetPath);@(ReferenceCopyLocalPaths->WithMetadataValue('Extension', '.dll'))" Outputs="$(IntermediateOutputPath)screenplay-contract.stamp">
        <Exec Command="dotnet &quot;$(TargetPath)&quot; contract --output &quot;$(TargetDir)screenplay-contract.json&quot;" />
        <Touch Files="$(IntermediateOutputPath)screenplay-contract.stamp" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(TargetDir)screenplay-contract.json" />
        </ItemGroup>
    </Target>
    <Target Name="RegenerateMissingScreenplayContract" BeforeTargets="GenerateScreenplayContract" Condition="'$(Configuration)'=='Release' AND '$(TargetFramework)'!='' AND !Exists('$(TargetDir)screenplay-contract.json')">
        <Delete Files="$(IntermediateOutputPath)screenplay-contract.stamp" />
    </Target>
</Project>
