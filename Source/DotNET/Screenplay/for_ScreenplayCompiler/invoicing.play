// ============================================================
// Invoicing — complete .play file
//
// A full-feature showcase of the Screenplay language: strongly
// typed concepts and composite types, authorization policies and
// personas, identity providers, vertical slices (state change,
// view, automation and translation), projections, captures,
// screens, specifications and seed data — all built around a
// single invoicing domain.
// ============================================================

domain Sales

import Customers.CustomerRegistered
import Customers.CustomerAccountClosed
import Shipping.InvoiceShipped
import Shipping.InvoiceShippingCleared

concept InvoiceId        : Uuid
concept CustomerId       : Uuid
concept TenantId         : Uuid
concept InvoiceNumber    : String
concept CurrencyCode     : String
concept ProductName      : String
concept Money            : Decimal
concept Quantity         : Int

concept PersonName : String @pii
  pii reason "The name of the person to contact about an invoice. Needed to reach them about billing; lawful basis: contract performance. Lives under the customer's subject and is erasable with their key."

concept BankAccount : String @pii @sensitive
  pii reason "Refund payout account. Remits money back to the customer; lawful basis: contract performance / legal obligation. Personal only for sole-proprietor customers."
  sensitive reason "Fraud-sensitive — a leaked account number enables direct financial harm, so it is never rendered in full and never leaves the payout path."

concept EmailAddress : String @pii
  pii reason "Billing contact address. Delivers invoices and payment reminders; lawful basis: contract performance. Under the customer's subject, erasable with their key."
  validate
    not empty          message "Email is required"
    matches "^.+@.+$"  message "Must be a valid email address"
    rule BeFromAnAllowedDomain message "Email domain is not allowed"
      csharp
        ```
        string email = context.Value;
        return !email.EndsWith("@example.com", StringComparison.OrdinalIgnoreCase);
        ```

concept DiscountPercentage : Decimal
  validate
    >= 0    message "A discount cannot be negative"
    <= 100  message "A discount cannot exceed 100 percent"

concept InvoiceStatus : Enum
  draft
  sent
  paid
  overdue
  cancelled

concept PaymentTerms : Enum
  net30
  net60
  immediate

// Composite value types — the shapes events and commands carry beyond a single
// primitive. Declared here, they give `lines InvoiceLine[]` something to resolve
// against, and give the concepts that only ever appear inside them a home.
type InvoiceLine
  description "A single billed line of an invoice"
  lineNumber  Int
  productName ProductName
  quantity    Quantity
  unitPrice   Money
  discount    DiscountPercentage?

type BillingContact
  description "Who to reach about an invoice - the personal data lives here, not on the invoice itself"
  name  PersonName
  email EmailAddress

policy IsAuthenticated
  require authenticated

policy IsAccountant
  require role "Accountant"

policy CanManageInvoice
  require role "InvoiceManager"
    or role "Accountant"

policy IsFinanceDepartment
  require claim "department" matches "Finance"

policy OwnsInvoice
  require claim "customerId" matches subject

policy CanWriteOff
  require ( role "InvoiceManager" or role "Accountant" ) and authenticated

policy IsAdultCustomer
  csharp
    ```
    var dateOfBirth = context.Identity.ClaimValue("dateOfBirth");
    return dateOfBirth is not null && DateTime.Parse(dateOfBirth) <= DateTime.UtcNow.AddYears(-18);
    ```

persona Accountant
  description "Keeps the books and approves invoices"
  policy IsAccountant
  policy CanManageInvoice

persona InvoiceManager
  description "Registers invoices and manages their lifecycle"
  policy CanManageInvoice

authentication
  provider EntraId
  provider GitHub
  provider OpenId name Partner

module Invoicing
  description
    ```
    Everything related to invoicing customers.
    Registration, lifecycle and payment tracking of invoices.
    ```

  layout MasterDetail
    template
      sidebar
      main

  layout DashboardLayout
    template
      header
      left
      right
      footer

  feature InvoiceManagement
    description "Registering and managing the lifecycle of invoices"

    slice StateChange RegisterInvoice
      description "Registers a new invoice"

      command RegisterInvoice
        description "Registers a new invoice with its lines and payment terms"
        // 'identifier' marks the property a runtime resolves the event source id
        // from. At most one per command; without it a new Uuid is generated.
        invoiceId      InvoiceId identifier
        customerId     CustomerId
        invoiceNumber  InvoiceNumber
        lines          InvoiceLine[]
        billingContact BillingContact
        currency       CurrencyCode
        paymentTerms   PaymentTerms
        dueDate        Date
        isProForma     Bool

        authorize CanManageInvoice
                  IsAdultCustomer

        validate
          invoiceNumber not empty                  message "Invoice number is required"
          invoiceNumber matches "^INV-[0-9]{6}$"   message "Invoice number must match INV-000000"
          lines not empty                          message "An invoice must have at least one line"
          lines.quantity all > 0                   message "All line quantities must be positive"
          lines.unitPrice all >= 0                 message "Line prices cannot be negative"
          currency length == 3                     message "Currency must be a 3-letter ISO code"
          dueDate > today                          message "Due date must be in the future"
          invoiceNumber rule BeUnusedInvoiceNumber message "Invoice number is already in use"
            file Validations/BeUnusedInvoiceNumber.cs

        validate csharp
          ```
          if (context.Artifact.paymentTerms == "immediate" && context.Artifact.total > 1_000_000)
          {
              yield return "Invoices over 1,000,000 cannot require immediate payment";
          }
          ```

        // Everything the command context carries is reachable from a mapping —
        // the same values an inline handler compiles against on CommandContext.
        produces InvoiceRegistered
          tag audit
          invoiceId      = invoiceId
          customerId     = customerId
          invoiceNumber  = invoiceNumber
          lines          = lines
          billingContact = billingContact
          currency       = currency
          paymentTerms   = paymentTerms
          dueDate        = dueDate
          registeredAt   = $context.occurred
          registeredBy   = $context.identity.id
          registeredFor  = $context.tenant
          registeredByOn = $context.causedBy.subject
          source         = $env.SERVICE_NAME
          status         = "draft"

        produces when isProForma == true
          ProFormaInvoiceIssued
            invoiceId  = invoiceId
            issuedAt   = $context.occurred

        produces when currency != "NOK"
          ForeignCurrencyInvoiceRegistered
            invoiceId = invoiceId
            currency  = currency

        produces when paymentTerms == "immediate"
          ImmediatePaymentInvoiceRegistered
            invoiceId = invoiceId
            dueDate   = dueDate

        produces when paymentTerms == "net30" or paymentTerms == "net60"
          DeferredPaymentInvoiceRegistered
            invoiceId    = invoiceId
            paymentTerms = paymentTerms
            dueDate      = dueDate

        concurrency
          eventSource
          sourceType Invoice
          streamType Invoicing
          streamId Primary
          events InvoiceRegistered, InvoiceCancelled

      event InvoiceRegistered
        tag invoicing
        tag "billing"
        tag $context.identity.id
        invoiceId      InvoiceId
        customerId     CustomerId
        invoiceNumber  InvoiceNumber
        lines          InvoiceLine[]
        billingContact BillingContact
        currency       CurrencyCode
        paymentTerms   PaymentTerms
        dueDate        Date
        registeredAt   DateTime
        registeredBy   String
        registeredFor  TenantId
        registeredByOn String
        source         String
        status         InvoiceStatus

      event ProFormaInvoiceIssued
        invoiceId InvoiceId
        issuedAt  DateTime

      event ForeignCurrencyInvoiceRegistered
        invoiceId InvoiceId
        currency  CurrencyCode

      event ImmediatePaymentInvoiceRegistered
        invoiceId InvoiceId
        dueDate   Date

      event DeferredPaymentInvoiceRegistered
        invoiceId    InvoiceId
        paymentTerms PaymentTerms
        dueDate      Date

      constraint UniqueInvoiceNumber
        unique invoiceNumber on InvoiceRegistered

      constraint OneRegistrationPerInvoice
        unique event InvoiceRegistered

      specification RegisteringADraftInvoice
        given CustomerRegistered
          customerId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          name       = "Acme Corp"
        when RegisterInvoice
          invoiceId     = "9c858901-8a57-4791-81fe-4c455b099bc9"
          customerId    = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          invoiceNumber = "INV-000123"
          currency      = "USD"
        then InvoiceRegistered
          invoiceId     = "9c858901-8a57-4791-81fe-4c455b099bc9"
          customerId    = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          invoiceNumber = "INV-000123"
          currency      = "USD"

      specification RejectingAnInvoiceWithNoLines
        when RegisterInvoice
          invoiceId = "9c858901-8a57-4791-81fe-4c455b099bc9"
        then error "An invoice must have at least one line"

      // A bare 'then error' says the command is rejected without naming a reason —
      // the reason this specification carries in its name, not in an assertion.
      specification RejectingAnInvoiceWhoseNumberIsAlreadyTaken
        given InvoiceRegistered
          invoiceNumber = "INV-000123"
        when RegisterInvoice
          invoiceId     = "5b1f2f7c-0f6c-4d3c-9f2f-1b1b7e0f0a11"
          invoiceNumber = "INV-000123"
        then error

    slice StateChange CancelInvoice

      command CancelInvoice
        invoiceId     InvoiceId identifier
        reason        String
        refund        Bool
        refundAccount BankAccount

        authorize CanManageInvoice

        validate
          reason not empty  message $strings.invoices.validation.reasonRequired
          reason min 3      message "A reason must be at least 3 characters"
          reason max 500    message "Reason must be 500 characters or fewer"

        produces InvoiceCancelled
          invoiceId   = invoiceId
          reason      = reason
          cancelledAt = $context.occurred
          cancelledBy = $context.identity.id
          cancelledVia = $context.causation.type

        produces when refund == true
          InvoiceRefundRequested
            invoiceId     = invoiceId
            requestedAt   = $context.occurred
            refundAccount = refundAccount

      event InvoiceCancelled
        invoiceId    InvoiceId
        reason       String
        cancelledAt  DateTime
        cancelledBy  String
        cancelledVia String

      event InvoiceRefundRequested
        invoiceId     InvoiceId
        requestedAt   DateTime
        refundAccount BankAccount

    slice StateChange ChangeInvoiceStatus

      command ChangeInvoiceStatus
        invoiceId InvoiceId identifier
        status    InvoiceStatus
        note      String?

        authorize IsAccountant

        validate
          status not empty  message "Status is required"

        produces when status == "sent"
          InvoiceSent
            invoiceId = invoiceId
            sentAt    = $context.occurred
            note      = note

        produces when status == "paid"
          InvoicePaid
            invoiceId = invoiceId
            paidAt    = $context.occurred
            note      = note

        produces when status == "overdue"
          InvoiceMarkedOverdue
            invoiceId = invoiceId
            overdueAt = $context.occurred

        produces when status != "sent" and status != "paid" and status != "overdue"
          InvoiceStatusChanged
            invoiceId = invoiceId
            status    = status
            changedAt = $context.occurred

      event InvoiceSent
        invoiceId InvoiceId
        sentAt    DateTime
        note      String?

      event InvoicePaid
        invoiceId InvoiceId
        paidAt    DateTime
        note      String?

      event InvoiceMarkedOverdue
        invoiceId InvoiceId
        overdueAt DateTime

      event InvoiceStatusChanged
        invoiceId InvoiceId
        status    InvoiceStatus
        changedAt DateTime

      constraint InvoiceStatusTransition
        file Constraints/InvoiceStatusTransitionConstraint.cs

      specification SendingADraftInvoice
        given readmodel InvoiceListReadModel
          invoiceId = "9c858901-8a57-4791-81fe-4c455b099bc9"
          status    = "draft"
        when ChangeInvoiceStatus
          invoiceId = "9c858901-8a57-4791-81fe-4c455b099bc9"
          status    = "sent"
        then InvoiceSent
          invoiceId = "9c858901-8a57-4791-81fe-4c455b099bc9"
        then readmodel InvoiceListReadModel
          status = "sent"

    slice StateChange ProcessInvoiceBatch

      command ProcessInvoiceBatch
        batchId    Uuid identifier
        invoiceIds InvoiceId[]
        action     String

        authorize IsAccountant

        validate
          invoiceIds not empty  message "Batch must contain at least one invoice"
          action not empty      message "Action is required"

        handler
          csharp
            ```
            var events = new List<object>();
            events.Add(new InvoiceBatchProcessingStarted(BatchId, InvoiceIds.Count, DateTimeOffset.UtcNow));
            foreach (var id in InvoiceIds)
                events.Add(Action switch {
                    "send"   => new InvoiceSent(id, DateTimeOffset.UtcNow, context.Identity.Id, null),
                    "cancel" => new InvoiceCancelled(id, "Batch", DateTimeOffset.UtcNow, context.Identity.Id),
                    _        => throw new InvalidOperationException($"Unknown action: {Action}")
                });
            events.Add(new InvoiceBatchProcessingCompleted(BatchId, InvoiceIds.Count, DateTimeOffset.UtcNow));
            return events;
            ```

      event InvoiceBatchProcessingStarted
        batchId   Uuid
        count     Int
        startedAt DateTime

      event InvoiceBatchProcessingCompleted
        batchId        Uuid
        processedCount Int
        completedAt    DateTime

    slice StateChange ArchiveOldInvoices

      command ArchiveOldInvoices
        olderThan Date

        authorize IsAccountant

        validate
          olderThan < today  message "Can only archive invoices dated before today"

        handler
          file Handlers/ArchiveOldInvoicesHandler.cs

    feature Adjustments
      description "Discounts and write-offs applied to issued invoices"

      slice StateChange ApplyDiscount

        command ApplyDiscount
          invoiceId      InvoiceId
          percentage     DiscountPercentage
          reason         String
          requiresReview Bool

          authorize IsAccountant or IsFinanceDepartment

          validate
            percentage >= 0    message "A discount cannot be negative"
            percentage <= 100  message "A discount cannot exceed 100 percent"
            reason min 5       message "Give a reason of at least 5 characters"

          produces DiscountApplied
            invoiceId  = invoiceId
            percentage = percentage
            appliedAt  = $context.occurred

          produces when ( percentage >= 50 ) or requiresReview == true
            DiscountReviewRequested
              invoiceId = invoiceId

          produces when percentage < 10
            DiscountAutoApproved
              invoiceId = invoiceId

        event DiscountApplied
          invoiceId  InvoiceId
          percentage DiscountPercentage
          appliedAt  DateTime

        event DiscountReviewRequested
          invoiceId InvoiceId

        event DiscountAutoApproved
          invoiceId InvoiceId

      slice StateChange WriteOffInvoice

        command WriteOffInvoice
          invoiceId    InvoiceId identifier
          amount       Money
          reason       String
          confirmation String

          authorize CanWriteOff

          validate
            amount min 1                message "Write-off amount must be at least 1"
            amount < 1000000            message "Write-offs of 1,000,000 or more need board approval"
            reason not empty            message "A reason is required"
            confirmation == "WRITEOFF"  message "Type WRITEOFF to confirm"

          produces InvoiceWrittenOff
            invoiceId    = invoiceId
            amount       = amount
            writtenOffAt = $context.occurred

          produces when amount > 10000
            LargeWriteOffFlagged
              invoiceId = invoiceId

          produces when amount <= 100
            SmallWriteOffRecorded
              invoiceId = invoiceId

        event InvoiceWrittenOff
          invoiceId    InvoiceId
          amount       Money
          writtenOffAt DateTime

        event LargeWriteOffFlagged
          invoiceId InvoiceId

        event SmallWriteOffRecorded
          invoiceId InvoiceId

    slice Translate LegacyInvoiceSync

      capture LegacyInvoiceCapture
        source api
          api LegacyInvoicingApi
          route /invoices
          poll 5m
        key id
        map
          status = status translate
            "utkast"     => draft
            "sendt"      => sent
            "betalt"     => paid
            "kansellert" => cancelled
          split contactName by ","
            firstName
            lastName
          summary = `${status} invoice`
        append InvoiceStatusChanged
          tag legacy
          when status
            invoiceId = $.id
            status    = $.status
            changedAt = $context.occurred
        append InvoicePaidFromSent
          when status from "sent" to "paid"
            invoiceId = $.id
            paidAt    = $context.occurred
        append InvoiceNeedsAttention
          when status or contactName
            invoiceId = $.id
        append InvoiceFullyApproved
          when approvedByFinance and approvedByManager
            invoiceId = $.id
        append InvoiceFlagged
          when `status == "sent" && overdue == true`
            invoiceId = $.id
        children lineItems identified by lineNumber
          map
            productName = name
          append InvoiceLineItemAdded
            when added
              invoiceId  = $.id
              lineNumber = $.lineNumber
              quantity   = $.quantity
              unitPrice  = $.unitPrice
          append InvoiceLineItemRemoved
            when removed
              invoiceId  = $.id
              lineNumber = $.lineNumber
        nested billingContact
          map
            contactName = name
          append BillingContactUpdated
            when email
              invoiceId = $.id
              email     = $.email

    slice StateView InvoiceList

      // A query says what it is for, where each parameter comes from, and — when it
      // needs one — how it is performed. 'from' fills a parameter from the query
      // context instead of the caller, so the UI never supplies the tenant.
      query ListInvoices => InvoiceListReadModel[]
        description "Every invoice the caller may see, narrowed by status and customer"
        filter status     InvoiceStatus?
        filter customerId CustomerId?
        filter tenantId   TenantId from $context.tenant
        authorize IsAuthenticated

      projection InvoiceList => InvoiceListReadModel
        every
          lastActivityAt = $eventContext.occurred
        from InvoiceRegistered key invoiceId
          id            = $eventSourceId
          customerId    = customerId
          invoiceNumber = invoiceNumber
          currency      = currency
          status        = "draft"
          lineCount     = 0
          dueDate       = dueDate
          channel       = "portal"
        from InvoiceSent, InvoicePaid
          touched = true
        from InvoiceMarkedOverdue
          status = "overdue"
        from InvoiceStatusChanged
          status = status
        remove with InvoiceCancelled

      screen RegisterInvoiceScreen
        title "Register invoice"
        action RegisterInvoice
          navigate to InvoiceList

      screen InvoiceList
        title "Invoices"
        data InvoiceListReadModel[] via query ListInvoices
        action RegisterInvoice
          navigate to RegisterInvoiceScreen
        action CancelInvoice
        typescript
          ```
          export const statusLabel = (status: string) => status.toUpperCase();
          ```

    slice StateView InvoiceDetails

      query GetInvoice => InvoiceDetailsReadModel
        description "One invoice with its lines, customer and shipping status"
        by invoiceId InvoiceId
        authorize OwnsInvoice or IsAuthenticated

      projection InvoiceDetails => InvoiceDetailsReadModel
        key invoiceId
        every
          lastUpdatedAt = $eventContext.occurred
          exclude children
        from InvoiceRegistered key invoiceId
          customerId           = customerId
          invoiceNumber        = invoiceNumber
          currency             = currency
          paymentTerms         = paymentTerms
          status               = "draft"
          dueDate              = dueDate
          registeredAt         = $eventContext.occurred
          registeredBy         = $causedBy.name
          registeredByUser     = $causedBy.userName
          registeredForSubject = $causedBy.subject
          displayLabel         = `${invoiceNumber} (${currency})`
        from InvoiceSent
          status = "sent"
          sentAt = sentAt
        from InvoicePaid
          status = "paid"
          paidAt = paidAt
        from InvoiceMarkedOverdue
          status    = "overdue"
          overdueAt = overdueAt
        join customer on customerId
          with CustomerRegistered
            no automap
            customerName = name
        children lineItems identified by lineNumber
          from InvoiceLineItemAdded key lineNumber
            parent invoiceId
            quantity  = quantity
            unitPrice = unitPrice
            add subtotal by unitPrice
            count itemCount
          remove with InvoiceLineItemRemoved key lineNumber
            parent invoiceId
        nested shipping
          from InvoiceShipped
            carrier = carrier
          clear with InvoiceShippingCleared
        remove via join on CustomerAccountClosed

      screen InvoiceLineDetail
        title "Line item"
        data InvoiceDetailsReadModel via query GetInvoice by invoiceId

      screen InvoiceDetails
        layout MasterDetail
          sidebar
            data InvoiceDetailsReadModel via query GetInvoice by invoiceId
            summary InvoiceDetailsReadModel
              field invoiceNumber label "Invoice #"
              field status        label "Status"
            section actions
              action CancelInvoice
              action ChangeInvoiceStatus
          main
            section lineItems
              table lineItems
                column lineNumber  label "#"
                column quantity    label "Qty"
                column unitPrice   label "Unit Price"
                on row-click navigate to InvoiceLineDetail by lineNumber
            section help
              html
                ```
                <p class="hint">Line items become read-only once an invoice is paid.</p>
                ```

    slice StateView InvoiceLineReport

      // The performer is the query's escape hatch, mirroring a command's handler —
      // an inline block in a top level language, or a 'file' reference.
      query ListLineItems => InvoiceLineReportReadModel[]
        description "Every invoice line, priced, for the accounting line report"
        filter tenantId TenantId from $context.tenant
        authorize IsAccountant
        performer
          sql
            ```
            select   InvoiceId, LineNumber, Quantity, UnitPrice
            from     InvoiceLineReport
            where    TenantId = @tenantId
            order by InvoiceId, LineNumber
            ```

      projection InvoiceLineReport => InvoiceLineReportReadModel
        from InvoiceLineItemAdded
          key InvoiceLineKey
            invoiceId  = invoiceId
            lineNumber = lineNumber
          quantity  = quantity
          unitPrice = unitPrice

      screen InvoiceLineReport
        file Screens/InvoiceLineReport.tsx

    slice StateView CancelledInvoices
      description "Archive of cancelled invoices - every property auto-maps from the event"

      query ListCancelledInvoices => CancelledInvoiceReadModel[]
        description "Cancelled invoices, kept for audit"
        authorize IsAccountant

      // No explicit mappings needed - AutoMap is on by default and copies
      // every matching property from InvoiceCancelled onto the read model.
      projection CancelledInvoices => CancelledInvoiceReadModel
        from InvoiceCancelled

    slice StateView InvoiceDashboard

      query GetInvoiceSummary  => InvoiceSummaryReadModel
        description "The counters behind the dashboard header"
        authorize IsAccountant
        performer
          file Queries/InvoiceSummaryPerformer.cs

      query GetOverdueInvoices => OverdueInvoicesReadModel[]
        description "Invoices past their due date, oldest first"
        authorize IsAccountant
        performer
          csharp
            ```
            return readModels
                .Where(invoice => invoice.Status == InvoiceStatus.Overdue)
                .Where(invoice => invoice.TenantId == context.Tenant)
                .OrderBy(invoice => invoice.DueDate);
            ```

      projection InvoiceSummary => InvoiceSummaryReadModel
        from InvoiceRegistered
          key "global"
          increment totalCount
          increment draftCount
          count touches
        from InvoiceSent
          decrement draftCount
          increment sentCount
        from InvoicePaid
          decrement sentCount
          increment paidCount
        from InvoiceMarkedOverdue
          increment overdueCount
        from InvoiceWrittenOff
          add writeOffTotal by amount
          subtract outstandingTotal by amount
        from InvoiceCancelled
          decrement totalCount

      screen InvoiceDashboard
        layout DashboardLayout
          header
            section title
              data InvoiceSummaryReadModel via query GetInvoiceSummary
              react
                ```
                export default ({ data }: Props) => (
                  <header className="dashboard-header">
                    <h1>Invoice Dashboard</h1>
                    <span className="badge">{data.totalCount} invoices</span>
                    {data.overdueCount > 0 && (
                      <span className="badge badge--warning">{data.overdueCount} overdue</span>
                    )}
                  </header>
                );
                ```
          left
            section overdue
              data OverdueInvoicesReadModel[] via query GetOverdueInvoices
              table OverdueInvoicesReadModel
                column invoiceNumber label "Invoice #"
                column dueDate       label "Due Date"
                on row-click navigate to InvoiceDetails by invoiceId
          right
            section summary
              data InvoiceSummaryReadModel via query GetInvoiceSummary
              react
                ```
                import { PieChart, Pie, Cell, Tooltip } from 'recharts';
                const COLORS = ['#94a3b8', '#60a5fa', '#34d399', '#f87171'];
                export default ({ data }: Props) => (
                  <PieChart width={300} height={300}>
                    <Pie data={[
                      { name: 'Draft', value: data.draftCount },
                      { name: 'Sent',  value: data.sentCount },
                      { name: 'Paid',  value: data.paidCount },
                    ]} dataKey="value">
                      {COLORS.map((c, i) => <Cell key={i} fill={c} />)}
                    </Pie>
                    <Tooltip />
                  </PieChart>
                );
                ```
          footer
            section actions
              action RegisterInvoice
                label $strings.invoices.actions.newInvoice
                navigate to RegisterInvoiceScreen

    slice StateView SystemActivity
      description "Counts every event in the system for the activity ticker"

      query GetSystemActivity => SystemActivityReadModel
        authorize IsAccountant

      projection SystemActivity => SystemActivityReadModel
        all
          count totalEvents
          lastOccurred = $eventContext.occurred

    slice Automation NotifyCustomerOnInvoiceRegistered

      reactor NotifyCustomer
        description "Emails the billing contact once an invoice is registered"
        on InvoiceRegistered
          file Reactors/NotifyCustomerReactor.cs

    slice Automation DetectOverdueInvoices

      reactor OverdueInvoiceDetector
        on InvoiceRegistered
          csharp
            ```
            if (DueDate < DateTimeOffset.UtcNow)
                return [new MarkInvoiceOverdue(InvoiceId, DateTimeOffset.UtcNow)];
            ```
        on InvoiceSent
          csharp
            ```
            if (DueDate < DateTimeOffset.UtcNow)
                return [new MarkInvoiceOverdue(InvoiceId, DateTimeOffset.UtcNow)];
            ```

    slice Automation ReconcilePayments
      description "Described before any of it is implemented - no 'file' anywhere"

      // A trigger states intent on its own. The 'file' reference and the inline
      // block are realization metadata a slice gains once it is built, never
      // something an author must invent to make the document parse.
      reactor PaymentReconciler
        description "Matches settled payments against outstanding invoices and closes them out"
        on InvoicePaid
        on InvoiceMarkedOverdue
          description "Re-checks whether a late payment has since arrived"

seed
  for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
    CustomerRegistered
      customerId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      name       = "Acme Corp"
    InvoiceRegistered
      invoiceNumber = "INV-000042"
      status        = "draft"
  for "9c858901-8a57-4791-81fe-4c455b099bc9"
    CustomerRegistered
      name = "Globex"
