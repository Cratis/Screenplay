<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Screenplay</AssemblyName>
        <RootNamespace>Cratis.Screenplay</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <Description>Compiler for the Cratis Screenplay language - parsing, syntax tree and visitor contracts</Description>
        <PackageTags>cratis;event-sourcing;event-modeling;cqrs;screenplay;dsl;compiler</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
        <ProjectReference Include="../Screenplay.ContractCatalog/Screenplay.ContractCatalog.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
        <ProjectReference Include="../Screenplay.Contexts/Screenplay.Contexts.csproj" />
        <ProjectReference Include="../Screenplay.Matching/Screenplay.Matching.csproj" />
        <InternalsVisibleTo Include="Cratis.Screenplay.Mcp" />
        <InternalsVisibleTo Include="Cratis.Screenplay.CanonicalVectors.Specs" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)'=='Debug'">
        <EmbeddedResource Include="**/*.play" />
        <!-- WithCulture=false keeps <base>.<locale>.strings samples in the main assembly instead of a satellite. -->
        <EmbeddedResource Include="**/*.strings" WithCulture="false" />
        <EmbeddedResource Include="Semantics/Serialization/Golden/*.json" WithCulture="false" />
    </ItemGroup>
    <!-- The compiler consumes Matching internals, so its package must resolve the same release. -->
    <Target Name="PinMatchingPackageDependency" AfterTargets="_GetProjectReferenceVersions">
        <ItemGroup>
            <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" Condition="'%(_ProjectReferencesWithVersions.Filename)' == 'Screenplay.Matching'">
                <ProjectVersion>[$(PackageVersion)]</ProjectVersion>
            </_ProjectReferencesWithVersions>
        </ItemGroup>
    </Target>
</Project>
