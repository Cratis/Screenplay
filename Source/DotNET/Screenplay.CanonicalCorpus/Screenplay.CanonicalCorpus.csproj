<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Screenplay.CanonicalCorpus</AssemblyName>
        <RootNamespace>Cratis.Screenplay.CanonicalCorpus</RootNamespace>
        <Description>Canonical Screenplay conformance corpora shared by authoring, rendering, publication, and recovery hosts</Description>
        <IsPackable>true</IsPackable>
        <IsTestProject>false</IsTestProject>
        <!-- CanonicalCorpus was first published at 4.7.0; the shared 4.0.0 baseline does not exist for this package. -->
        <PackageValidationBaselineVersion>4.7.0</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Corpus/**/*.play" />
        <EmbeddedResource Include="Corpus/**/*.json" />
        <EmbeddedResource Include="Corpus/**/*.txt" />
        <EmbeddedResource Include="Corpus/**/*.ts" />
        <EmbeddedResource Include="Corpus/ProtectedCommandReads/v24/README.md" />
        <EmbeddedResource Include="../Screenplay/Semantics/Serialization/Golden/full-esm-v*.json"
                          Link="Esm/%(Filename)%(Extension)"
                          WithCulture="false"
                          LogicalName="Cratis.Screenplay.CanonicalCorpus.Esm.%(Filename)%(Extension)" />
        <EmbeddedResource Include="../Screenplay/Semantics/Serialization/Golden/policy-negation-v*.json"
                          Link="Esm/%(Filename)%(Extension)"
                          WithCulture="false"
                          LogicalName="Cratis.Screenplay.CanonicalCorpus.Esm.%(Filename)%(Extension)" />
        <ProjectReference Include="../Screenplay/Screenplay.csproj" />
    </ItemGroup>
</Project>
