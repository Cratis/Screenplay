        health HealthInformation
        key ApiKey
        note PersonalSecret
        status InvoiceStatus
        produces InformationRecorded
          for id
          health = health
          key = key
          note = note
          status = status
      specification ProtectedInformation
        when RecordInformation
          id = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          health = "well"
          key = "token"
          note = "private"
          status = "draft"
        then InformationRecorded
