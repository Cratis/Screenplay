concept WorkItemId : Uuid
concept CommentId : Uuid
concept WorkStatus : Enum
  open
  closed

layout AppShell
  topbar
  navigation contributes Navigation
  content

  arrangement flow
    column
      topbar height 56
      row gap 16
        navigation width 240
        content grow

ui profile Desktop
  target platform web
  target size expanded
  layout AppShell
  packages
    core
    Cratis.Components

behavior ConfirmClose
  parameter command
  parameter message

  on click
    confirm message
      on success
        execute command
        notify info "Work item closed"

module Workspaces
  screen template MasterDetail
    fits slot content
    list
    details

    arrangement flow
      row gap 16
        list width 320
        details grow
      when width compact
        column
          details
          list

  dialog template EditDialog
    body
    actions

  form CreateWorkItemForm for CreateWorkItem
    field workItemId
    field title label "Title"

    on submit navigate to WorkItemList by workItemId

  form RenameWorkItemForm for RenameWorkItem
    populate from item
    field workItemId
    field title label "New title"

    on submit navigate to WorkItemDetails by workItemId

  feature Tracking
    slice StateChange CreateWorkItem
      command CreateWorkItem
        workItemId WorkItemId identifier
        title String
        produces WorkItemCreated
          for workItemId
          title = title
          status = "open"

      event WorkItemCreated
        title String
        status WorkStatus

      specification CreatingAWorkItem
        when CreateWorkItem
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Design master detail"
        then WorkItemCreated
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Design master detail"
          status = "open"

    slice StateChange RenameWorkItem
      command RenameWorkItem
        workItemId WorkItemId identifier
        title String
        produces WorkItemRenamed
          for workItemId
          title = title

      event WorkItemRenamed
        title String

      specification RenamingAWorkItem
        given WorkItemCreated
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Design master detail"
          status = "open"
        when RenameWorkItem
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Implement master detail"
        then WorkItemRenamed
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Implement master detail"

    slice StateChange CloseWorkItem
      command CloseWorkItem
        workItemId WorkItemId identifier
        produces WorkItemClosed
          for workItemId
          status = "closed"

      event WorkItemClosed
        status WorkStatus

      specification ClosingAWorkItem
        given WorkItemCreated
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Design master detail"
          status = "open"
        when CloseWorkItem
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
        then WorkItemClosed
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          status = "closed"

    slice StateChange AddComment
      command AddComment
        commentId CommentId identifier
        workItemId WorkItemId
        text String
        produces CommentAdded
          for commentId
          workItemId = workItemId
          text = text

      event CommentAdded
        workItemId WorkItemId
        text String

      specification AddingAComment
        when AddComment
          commentId = "11111111-1111-1111-1111-111111111111"
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          text = "Needs compact layout"
        then CommentAdded
          for "11111111-1111-1111-1111-111111111111"
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          text = "Needs compact layout"

    slice StateView WorkItemList
      readmodel WorkItemSummary
        workItemId WorkItemId
        title String
        status WorkStatus

      query AllWorkItems => observable WorkItemSummary[]
      query WorkItemById => WorkItemSummary optional
        by workItemId WorkItemId

      projection WorkItemList => WorkItemSummary
        from WorkItemCreated
          workItemId = $eventSourceId
          title = title
          status = status
        from WorkItemRenamed
          title = title
        from WorkItemClosed
          status = status

      screen WorkItemList
        template MasterDetail
          list
            title "Work items"
            data WorkItemSummary[] via query AllWorkItems
            table WorkItemSummary
              column title label "Title"
              column status label "Status"
              on row-click navigate to WorkItemDetails by workItemId
              on double click
                when item.status == "open"
                  navigate to WorkItemDetails
                    with workItemId from item.workItemId
                otherwise
                  notify info "This work item is closed"
          details
            section emptyState
              title "Select a work item"
              action CreateWorkItem

      specification ListingCreatedWorkItems
        given WorkItemCreated
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Design master detail"
          status = "open"
        when query WorkItemById
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
        then result
          title = "Design master detail"
          status = "open"

    slice StateView WorkItemDetails
      readmodel WorkItemDetails
        workItemId WorkItemId
        title String
        status WorkStatus

      query GetWorkItem => WorkItemDetails optional
        by workItemId WorkItemId

      projection WorkItemDetails => WorkItemDetails
        from WorkItemCreated
          workItemId = $eventSourceId
          title = title
          status = status
        from WorkItemRenamed
          title = title
        from WorkItemClosed
          status = status

      screen WorkItemDetails
        template MasterDetail
          list
            data WorkItemSummary[] via query AllWorkItems
            table WorkItemSummary
              column title label "Title"
              column status label "Status"
              on row-click navigate to WorkItemDetails by workItemId
          details
            data WorkItemDetails via query GetWorkItem by workItemId
            section summary
              title "Details"
              summary WorkItemDetails
                field title label "Title"
                field status label "Status"
              action RenameWorkItem
                label "Rename"
              action "Close"
                when item.status == "open" execute CloseWorkItem
                  with workItemId from item.workItemId
                otherwise hidden
                navigate to WorkItemList
            section comments
              title "Comments"
              data CommentView[] via query CommentsForWorkItem by workItemId
              section hierarchy
                table CommentView
                  column text label "Comment"
                section composer
                  action AddComment

      specification ShowingRenamedDetails
        given WorkItemCreated
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Design master detail"
          status = "open"
        given WorkItemRenamed
          for "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          title = "Implement master detail"
        when query GetWorkItem
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
        then result
          title = "Implement master detail"
          status = "open"

    slice StateView WorkItemComments
      readmodel CommentView
        commentId CommentId
        workItemId WorkItemId
        text String

      query CommentsForWorkItem => observable CommentView[]
        by workItemId WorkItemId

      projection WorkItemComments => CommentView
        from CommentAdded
          commentId = $eventSourceId
          workItemId = workItemId
          text = text

      screen CommentThread
        data CommentView[] via query CommentsForWorkItem by workItemId
        section thread
          table CommentView
            column text label "Comment"
          on click
            open dialog EditDialog
              with workItemId from item.workItemId
              on result
                refresh CommentsForWorkItem


      specification ShowingCommentsForAWorkItem
        given CommentAdded
          for "11111111-1111-1111-1111-111111111111"
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          text = "Needs compact layout"
        when query CommentsForWorkItem
          workItemId = "3fa85f64-5717-4562-b3fc-2c963f66afa6"
        then result
          text = "Needs compact layout"

    contribute to Navigation
      navigate to WorkItemList
      label "Work items"
      order 10
