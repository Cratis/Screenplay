module Workspaces
  screen template MasterDetail
    fits slot content
    category Workspace
    list
    details

    arrangement flow
      row gap 16
        list width 320
        details grow
      when width compact
        column
          details
          list

  dialog template EditDialog
    category Dialog
    body
    actions

  form CreateWorkItemForm for CreateWorkItem
    generation manual
    field workItemId
    field title label "Title"
    field notes label "Notes"
    columns auto
    layout
      column 1 width 1fr
      column 2 width 2fr
      columnGap 24px
      rowGap 16px
      place workItemId row 1 column 1
      place title row 1 column 2
      place notes row 2 column 1 columnSpan 2

    on submit navigate to WorkItemList by workItemId

  form RenameWorkItemForm for RenameWorkItem
    populate from item
    field workItemId
    field title label "New title"

    on submit navigate to WorkItemDetails by workItemId

  contribute to Navigation
    navigate to WorkItemList
    label "Overview"
    order 5
    icon home
    presentation text
