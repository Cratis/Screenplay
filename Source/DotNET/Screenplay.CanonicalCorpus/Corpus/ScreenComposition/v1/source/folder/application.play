concept WorkItemId : Uuid
concept CommentId : Uuid
concept WorkStatus : Enum
  open
  closed

layout AppShell
  category Shell
  topbar
  navigation contributes Navigation
  content

  arrangement flow
    column
      topbar height 56
      row gap 16
        navigation width 240
        content grow

ui profile Desktop
  target platform web
  target size expanded
  root template AppShell
  packages
    core
    Cratis.Components

behavior ConfirmClose
  parameter command
  parameter message

  on click
    confirm message
      on success
        execute command
        notify info "Work item closed"
