module M
  feature F
    slice Automation S
      event Recorded
      event Followed
      event Folded
      command Record
        id String identifier
        stream Account.Notes
          streamId = "period"
        produces Recorded
          for id
      command Fold
        id String identifier
        stream Account.Archive
        produces Folded
          for id
      readmodel Snapshot
        id String key
      readmodel Followups
        id String key
      projection FollowupsProjection => Followups
        from Followed
      reaction Follow
        from Account.Notes
        when Recorded
          produces Followed
      reducer Fold => Snapshot
        from Account
        on Folded
          ```csharp
          return context.State;
          ```
      specification RoutedReaction
        given Recorded
          for "history"
        when append Recorded
          for "other"
          stream Account.Notes
            streamId = "period"
        then Followed
          no stream
        then readmodel Followups
          id = "other"
      specification UnroutedReaction
        when append Recorded
          for "other"
        then no readmodel Followups for "other"
      specification UnroutedReducer
        when append Folded
          for "other"
        then no readmodel Snapshot for "other"
      specification WrongStreamReaction
        when append Recorded
          for "other"
          stream Account.Archive
        then no readmodel Followups for "other"
      specification MatchingReducer
        when append Folded
          for "other"
          stream Account.Archive
        then no readmodel Snapshot for "other"
