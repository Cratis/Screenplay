module Scheduling
  feature Clocks
    slice StateChange Due
      command RecordDue
        id String identifier
        dueDate Date
        calendar "America/St_Johns"
        validate
          require dueDate >= today - 7 days
            message "The due date is too old."
        produces DueRecorded
          for id
          dueDate = dueDate
      event DueRecorded
        dueDate Date
      specification RecentDue
        given clock "2026-03-10T02:00:00Z"
        when RecordDue
          id = "due"
          dueDate = "2026-03-02"
        then DueRecorded
          for "due"
          dueDate = "2026-03-02"
      specification StaleDue
        given clock "2026-03-10T02:00:00Z"
        when RecordDue
          id = "due"
          dueDate = "2026-03-01"
        then error "The due date is too old."
    slice StateChange Billing
      command DateInvoice
        id String identifier
        issuedAt DateTime
        calendar from $context.billingZone
        produces when date of issuedAt == today
          InvoiceDated
            for id
      event InvoiceDated
      specification SameBillingDay
        given time zone "Pacific/Auckland"
        given clock "2026-03-10T12:00:00Z"
        when DateInvoice
          id = "invoice"
          issuedAt = "2026-03-10T11:30:00Z"
        then InvoiceDated
          for "invoice"
      specification EarlierBillingDay
        given time zone "Pacific/Auckland"
        given clock "2026-03-10T12:00:00Z"
        when DateInvoice
          id = "invoice"
          issuedAt = "2026-03-10T10:30:00Z"
        then no events
    slice StateChange Window
      command Arrive
        id String identifier
        arrivedAt DateTime
        validate
          require arrivedAt >= now - 30 minutes
            message "The arrival is too old."
        produces Arrived
          for id
      event Arrived
      specification FreshArrival
        given clock "2026-03-10T12:00:00Z"
        when Arrive
          id = "arrival"
          arrivedAt = "2026-03-10T11:45:00Z"
        then Arrived
          for "arrival"
      specification StaleArrival
        given clock "2026-03-10T12:00:00Z"
        when Arrive
          id = "arrival"
          arrivedAt = "2026-03-10T11:00:00Z"
        then error "The arrival is too old."
