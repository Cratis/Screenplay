policy PersonOnly
  require authenticated and not role "Service" and not claim "actorKind" matches "service"
policy Grouped
  require not (role "Service" or claim "actorKind" matches "service") and authenticated
policy Precedence
  require not role "Service" and role "Accountant" or role "Controller"
policy DoubleNegative
  require not not authenticated
