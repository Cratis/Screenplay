{
  "version": 1,
  "rules": {
    "interval": "Positive whole-second intervals are counted from the Unix epoch, using floor division for instants before the epoch.",
    "schedule": "Schedules use a UTC second-of-day (0..86399), optionally restricted to either a day of week (0=Sunday..6=Saturday) or a day of month (1..31), never both; days a month lacks are skipped.",
    "window": "from is exclusive and to is inclusive; authored offsets are normalized to UTC.",
    "limit": "At most 10000 occurrences across all reactions and triggers are admitted per advance; exceeding the shared limit refuses the advance and returns no occurrences.",
    "ordering": "Occurrences are ordered by instant, then reaction running order (semantic identity order), then trigger declaration order."
  },
  "vectors": [
    {
      "name": "fractional-start",
      "trigger": {
        "kind": "interval",
        "everySeconds": 5
      },
      "from": "1969-12-31T23:59:59.500Z",
      "to": "1970-01-01T00:00:05Z",
      "due": [
        "1970-01-01T00:00:00Z",
        "1970-01-01T00:00:05Z"
      ]
    },
    {
      "name": "floor-before-epoch",
      "trigger": {
        "kind": "interval",
        "everySeconds": 5
      },
      "from": "1969-12-31T23:59:49Z",
      "to": "1969-12-31T23:59:59Z",
      "due": [
        "1969-12-31T23:59:50Z",
        "1969-12-31T23:59:55Z"
      ]
    },
    {
      "name": "offset-normalization",
      "trigger": {
        "kind": "schedule",
        "secondOfDay": 0
      },
      "from": "2026-10-02T01:59:59+02:00",
      "to": "2026-10-02T02:00:00+02:00",
      "due": [
        "2026-10-02T00:00:00Z"
      ]
    },
    {
      "name": "interval-offset-normalization",
      "trigger": {
        "kind": "interval",
        "everySeconds": 5
      },
      "from": "1970-01-01T01:59:59+02:00",
      "to": "1970-01-01T02:00:05+02:00",
      "due": [
        "1970-01-01T00:00:00Z",
        "1970-01-01T00:00:05Z"
      ]
    },
    {
      "name": "month-31-across-february-2026",
      "trigger": {
        "kind": "schedule",
        "secondOfDay": 0,
        "dayOfMonth": 31
      },
      "from": "2026-01-30T00:00:00Z",
      "to": "2026-03-31T00:00:00Z",
      "due": [
        "2026-01-31T00:00:00Z",
        "2026-03-31T00:00:00Z"
      ]
    },
    {
      "name": "february-29-leap-year-2028",
      "trigger": {
