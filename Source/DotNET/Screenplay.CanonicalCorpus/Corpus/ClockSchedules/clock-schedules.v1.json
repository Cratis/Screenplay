      ]
    },
    {
      "name": "empty-window",
      "trigger": {
        "kind": "schedule",
        "secondOfDay": 0
      },
      "from": "1970-01-01T00:00:00Z",
      "to": "1970-01-01T00:00:00Z",
      "due": []
    },
    {
      "name": "exact-occurrence-limit",
      "triggers": [
        {
          "kind": "interval",
          "everySeconds": 1
        }
      ],
      "from": "1970-01-01T00:00:00Z",
      "to": "1970-01-01T02:46:40Z",
      "refused": false,
      "count": 10000
    },
    {
      "name": "one-over-occurrence-limit",
      "triggers": [
        {
          "kind": "interval",
          "everySeconds": 1
        }
      ],
      "from": "1970-01-01T00:00:00Z",
      "to": "1970-01-01T02:46:41Z",
      "refused": true,
      "count": 0
    },
    {
      "name": "simultaneous-triggers-exact-shared-limit",
      "triggers": [
        {
          "kind": "interval",
          "everySeconds": 1
        },
        {
          "kind": "interval",
          "everySeconds": 1
        }
      ],
      "from": "1970-01-01T00:00:00Z",
      "to": "1970-01-01T01:23:20Z",
