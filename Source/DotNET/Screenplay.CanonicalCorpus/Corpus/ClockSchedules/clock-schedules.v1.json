        "kind": "schedule",
        "secondOfDay": 43200,
        "dayOfMonth": 29
      },
      "from": "2100-02-28T12:00:00Z",
      "to": "2100-03-01T12:00:00Z",
      "due": []
    },
    {
      "name": "last-calendar-day",
      "trigger": {
        "kind": "schedule",
        "secondOfDay": 86399
      },
      "from": "9999-12-30T23:59:59Z",
      "to": "9999-12-31T23:59:59Z",
      "due": [
        "9999-12-31T23:59:59Z"
      ]
    },
    {
      "name": "interval-larger-than-calendar",
