// Systems declare abilities with inputs, returned values, named outcomes and an effect class.
concept ParcelId : Uuid
concept TrackingNumber : String
concept Channel : Enum
  email
  sms

type Address
  street String
  postalCode String

system Carrier
  description "The parcel carrier's booking service"
  ability BookPickup idempotent
    description "Books a pickup for one parcel"
    parcelId ParcelId
    address Address
    notes String optional
    stops Address[]
    returns
      trackingNumber TrackingNumber
      pickupAt DateTime
    outcome NoCapacity
      description "No pickup slot on the requested day"
    outcome AddressRefused
  ability CancelPickup idempotent
    trackingNumber TrackingNumber
  ability Quote safe
    address Address
    returns
      price Decimal
  ability PostNotice
    description "Posts to the carrier's notice board"
    channel Channel
    @description String
    @outcome String
    implementation
      hint "Use the existing notice adapter"
      file Adapters/PostNotice.cs
  ability RequestApproval once
    answers later
    parcelId ParcelId
    ```csharp
    return Pending(parcelId);
    ```
  ability Withdraw
    parcelId ParcelId
    file Adapters/Withdraw.cs

system Ledger
  description "The finance department's ledger"
