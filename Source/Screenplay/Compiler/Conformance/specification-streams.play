// Specification routes are authoring-only until an ESM version admits them.
// Legacy numeric mode lets binding report the route's own admission issue (#457).
concept Partition : Int
eventsource Account
  identifier String
  stream Transactions
    streamId String
  stream Profile
  stream Partitioned
    streamId Partition
  stream Composite
    streamId
      streamId String
      stream Partition
module Banking
  feature Accounts
    slice StateView History
      event Recorded
        stream Int
        streamId Int
      specification ReadingHistory
        given Recorded
          stream Account.Transactions
            streamId = "p-1:2026-10"
          for "other"
          stream = 5
        when append Recorded
          for "other"
          stream Account.Profile
          streamId = 6
        then Recorded
          for "other"
          stream Account.Partitioned
            streamId = 202610
          stream = 7
        then Recorded
          no stream
          streamId = 8
        then Recorded
          stream = 9
      specification CompositeHistory
        given Recorded
          for "other"
          stream Account.Composite
            streamId
              stream = 202610
              streamId = "period"
          streamId = 6
        when append Recorded
          for "other"
          stream Account.Composite
            streamId
              streamId = "period"
              stream = 202610
          stream = 5
        then Recorded
          stream Account.Composite
            streamId
              stream = 202610
              streamId = "period"
