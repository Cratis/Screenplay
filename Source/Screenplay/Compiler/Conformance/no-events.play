module Work
  feature Recording
    slice StateChange Nothing
      command DoNothing
        item String identifier
      specification NothingHappens
        when DoNothing
          item = "one"
        then no events
      specification ImplicitEmptyExpectation
        when DoNothing
          item = "one"
