concept InvoiceId : Uuid
module Billing
  feature Invoices
    slice StateChange CloseInvoice
      command CloseInvoice
        invoiceId InvoiceId identifier
        reason String
        produces InvoiceClosed
          for invoiceId
          reason = reason
      event InvoiceClosed
        reason String
    slice Automation Closing
      event InvoicePaid
        invoiceId InvoiceId
      reaction Closer
        when InvoicePaid
          invoiceId
          invokes CloseInvoice
            invoiceId = invoiceId
            reason = "paid"
      specification ClosingAPaidInvoice
        when append InvoicePaid
          invoiceId = "9c858901-8a57-4791-81fe-4c455b099bc9"
        then invokes CloseInvoice
          invoiceId = "9c858901-8a57-4791-81fe-4c455b099bc9"
          reason = "paid"
      specification ClosingInAnyOrder
        when append InvoicePaid
          invoiceId = "9c858901-8a57-4791-81fe-4c455b099bc9"
        then events in any order
        then invokes CloseInvoice
