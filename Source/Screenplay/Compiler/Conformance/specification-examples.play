domain SpecificationExamples

concept ReceiptId : Uuid

example RootInvoice : Invoices.Registration.RegisterInvoice.InvoiceRegistered
  description "One current invoice"
  for "11111111-1111-1111-1111-111111111111"
  total = 1000

module Invoices
  example ModuleBalance : Invoices.Registration.RegisterInvoice.InvoiceBalance
    total = 1000

  feature Registration
    example FeatureInput : RegisterInvoice.RegisterInvoice
      total = 1000
      generated receipt = "22222222-2222-2222-2222-222222222222"

    slice StateChange RegisterInvoice
      command RegisterInvoice
        total Int
        receipt ReceiptId generated
        produces InvoiceRegistered
          total = total

      event InvoiceRegistered
        total Int

      readmodel InvoiceBalance
        total Int

      example AcmeInput : RegisterInvoice
        total = 2000
        generated receipt = "22222222-2222-2222-2222-222222222222"

      specification RegisteringAcme
        given RootInvoice total = 3000
        given readmodel ModuleBalance total = 3000
        when AcmeInput total = 5000
        then RootInvoice total = 5000
        then readmodel ModuleBalance exactly total = 5000

      specification AppendingAnInvoice
        when append RootInvoice total = 6000
        then readmodel ModuleBalance total = 6000

      specification OverridingAnInput
        when FeatureInput
          total = 7000
        then RootInvoice total = 7000
