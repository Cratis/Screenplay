type ResponseDetails
  labels String[]
  accepted Bool
concept ProjectId : Uuid
concept ReceiptId : Uuid
concept lowerCaseConcept : String
concept slug : String
module Projects
  feature Registration
    slice StateChange Register
      command RegisterProject
        // Declaration order does not affect scalar response recognition.
        returns projectId
        projectId ProjectId generated identifier
        receiptId ReceiptId generated
        name String
        produces event ProjectRegistered
          name String = name
      specification RegistersProject
        when RegisterProject
          for "11111111-1111-1111-1111-111111111111"
          generated receiptId = "22222222-2222-2222-2222-222222222222"
          name = "Apollo"
        then returns "11111111-1111-1111-1111-111111111111"
      command RegisterWithReceipt
        projectId ProjectId generated identifier
        receiptId ReceiptId generated
        note String optional
        returns
          projectId = projectId
          receiptId ReceiptId = receiptId
          note String optional = note
      specification ReturnsReceipt
        when RegisterWithReceipt
          generated receiptId = "22222222-2222-2222-2222-222222222222"
        then returns
          receiptId = "22222222-2222-2222-2222-222222222222"
          note = null
      command ReturnOneFieldRecord
        name String
        returns
          value = name
      command ContextualNames
        returns lowerCaseConcept
        generated String
        value String
      command ReturnPropertyNamedReturns
        @returns String
        returns returns
      command TypeNamedLikeProperty
        returns slug
        slug slug
      command ForcedResponse
        returns @slug
        slug slug
      command ReturnDetails
        details ResponseDetails
        returns
          details ResponseDetails = details
      specification ReturnsConcreteDetails
        when ReturnDetails
          details = {"labels": ["one", "two"], "accepted": true}
        then returns
          details = {"labels": ["one", "two"], "accepted": true}
      command HandlerWithResponse
        name String
        handler
          ```csharp
          return name;
          ```
        returns name
