// A property graph: the graph declaration, a projection onto it, and the specification steps that assert it.

concept PersonId     : Uuid
concept GroupId      : Uuid
concept AssignmentId : Uuid
concept PersonName   : String

module Organization
  feature Chart
    slice StateView OrganizationChart
      description "People, groups and the edges between them"

      event PersonRegistered
        name PersonName

      event PersonRemoved

      event MemberAdded
        groupId GroupId

      event RoleAssigned
        groupId      GroupId
        assignmentId AssignmentId
        tags         String[]

      graph Organization
        description "Who belongs to which group"
        node Person
          personId PersonId key
          name     PersonName
          aliases  String[] optional
          touched  DateTime optional
        node Group
          groupId GroupId key
        edge MEMBER_OF source Person target Group
          since DateTime
          visits Int
        edge HAS_ROLE source Person target Group identified by assignmentId
          assignmentId AssignmentId
          tags         String[]

      projection OrganizationChart => graph Organization
        description "Project the organization's events onto people, groups and their edges"
        node Person
          every
            touched = $eventContext.occurred
          from PersonRegistered key $eventSourceId
            personId = $eventSourceId
            name     = name
          remove with PersonRemoved key $eventSourceId detach
        node Group
          from MemberAdded key groupId
            groupId = groupId
        edge MEMBER_OF
          from MemberAdded source $eventSourceId target groupId
            since = $eventContext.occurred
            increment visits
        edge HAS_ROLE
          from RoleAssigned source $eventSourceId target groupId identified by assignmentId
            assignmentId = assignmentId
            tags         = tags
          remove with PersonRemoved source $eventSourceId target groupId identified by assignmentId

      specification AddingAMemberDrawsAnEdge
        given graph Organization
          has node Person "6fa459ea-ee8a-4ca4-894e-db77e160355e"
            name = "Ada Lovelace"
        when append MemberAdded
          for "6fa459ea-ee8a-4ca4-894e-db77e160355e"
          groupId = "0f8fad5b-d9cb-469f-a165-70867728950e"
        then graph Organization
          has node Group "0f8fad5b-d9cb-469f-a165-70867728950e"
          has edge MEMBER_OF from "6fa459ea-ee8a-4ca4-894e-db77e160355e" to "0f8fad5b-d9cb-469f-a165-70867728950e"
            visits = 1
          has edge HAS_ROLE from "6fa459ea-ee8a-4ca4-894e-db77e160355e" to "0f8fad5b-d9cb-469f-a165-70867728950e" identified by "9c858901-8a57-4791-81fe-4c455b099bc9"
          no edge MEMBER_OF from "0f8fad5b-d9cb-469f-a165-70867728950e" to "6fa459ea-ee8a-4ca4-894e-db77e160355e"
          no node Person "9c858901-8a57-4791-81fe-4c455b099bc9"
