// Authoring-only conformance fixture. Event sources and streams are not executable ESM contracts.
concept AccountId : Uuid
concept Month : String
concept Partition : Int

eventsource Account
  description "A customer's account"
  id "OldAccount"
  identifier AccountId
  stream Transactions
    description
      ```markdown
      Money in and out, partitioned by month.
      ```
    id "OldTransactions"
    streamId Month
  stream Onboarding
  stream Partitioned
    streamId Partition
  stream PeriodLedger
    streamId
      accountId AccountId
      period Month
  stream ThreeParts
    streamId
      streamId String
      stream Partition
      owner AccountId

eventsource Ledger
  stream Transactions
    streamId Uuid

module Banking
  feature Accounts
    slice StateChange Deposit
      command Deposit
        accountId AccountId identifier
        month Month
        amount Decimal
        stream Account.Transactions
          streamId = month
        produces event Deposited
          amount Decimal = amount
      command Book
        accountId AccountId identifier
        month Month
        stream Account.PeriodLedger
          streamId
            period = month
            accountId = accountId
        produces event Booked
          for accountId
          streamId String = month
        concurrency
          eventSource
          sourceType Account
          streamType PeriodLedger
          streamId Primary
      command Three
        accountId AccountId identifier
        stream Account.ThreeParts
          streamId
            owner = accountId
            stream = 42
            streamId = "literal"
      command Opaque
        stream Account.Transactions
          streamId = "p-1:2026-10"
      command Import
        month Month
        stream Account.Transactions
          streamId = month
        handler
          file Commands/Import.cs
      command Begin
        stream Account.Onboarding
      command LegacyNames
        stream String
          deeper String
        identifier String
        eventsource String
        streamId String
        from String
        @stream Account.Transactions optional
        @stream Account.ThreeParts optional
