// Legacy numeric mode lets binding report the reaction's own admission issue (#433).

eventsource Invoice
  identifier String
  stream Ledger
    streamId String

module Billing
  feature Claims
    slice Automation Handling
      event Approved
        invoice String
      event Refused
        reason String
        constraint String
        message String
      command Claim
        invoice String identifier
        produces Claimed
          for invoice
      event Claimed
      constraint UniqueClaim
        unique event Claimed
      reaction Claimer
        when Approved
          invokes Claim
            invoice = invoice
            on refused by constraint Handling.UniqueClaim
              produces Refused
                for invoice
                reason = $refusal.reason
                constraint = $refusal.constraint
                message = $refusal.message
            on refused by validation
              acknowledge
            on refused by constraint
              acknowledge
            on refused by authorization
              acknowledge
            on refused
              acknowledge
      specification Recovery
        given Approved
          for "invoice-1"
          invoice = "invoice-1"
        when redelivered Approved to Claimer
          for "invoice-1"
          invoice = "invoice-1"
        then no events
      specification Routed_recovery
        given Approved
          for "invoice-1"
          stream Invoice.Ledger
            streamId = "september"
          invoice = "invoice-1"
        given Approved
          for "invoice-1"
          stream Invoice.Ledger
            streamId = "october"
          invoice = "invoice-1"
        when redelivered Approved to Claimer
          stream Invoice.Ledger
            streamId = "september"
        then no events
      specification Unrouted_recovery
        given Approved
          for "invoice-1"
          stream Invoice.Ledger
            streamId = "september"
          invoice = "invoice-1"
        given Approved
          for "invoice-1"
          invoice = "invoice-1"
        when redelivered Approved to Claimer
          no stream
        then no events
