{
    "comments": {
        "lineComment": "//"
    },
    "autoClosingPairs": [
        { "open": "\"", "close": "\"", "notIn": ["comment"] },
        { "open": "{", "close": "}", "notIn": ["comment"] }
    ],
    "surroundingPairs": [
        ["\"", "\""],
        ["{", "}"]
    ],
    "wordPattern": "[A-Za-z_][\\w.]*"
}
