{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Screenplay",
    "scopeName": "source.screenplay",
    "fileTypes": [
        "play"
    ],
    "patterns": [
        { "include": "#comment" },
        { "include": "#numeric-preamble" },
        { "include": "#fenced-csharp" },
        { "include": "#fenced-react" },
        { "include": "#fenced-typescript" },
        { "include": "#fenced-html" },
        { "include": "#fenced-sql" },
        { "include": "#code-block-csharp" },
        { "include": "#code-block-react" },
        { "include": "#code-block-typescript" },
        { "include": "#code-block-html" },
        { "include": "#code-block-sql" },
        { "include": "#handler-block" },
        { "include": "#event-block" },
        { "include": "#command-block" },
        { "include": "#concept-block" },
        { "include": "#operation-block" },
        { "include": "#description-block" },
        { "include": "#projection-block" },
        { "include": "#capture-block" },
        { "include": "#example-header" },
        { "include": "#specification-stream" },
        { "include": "#stream-id-parts" },
        { "include": "#declared-dependency" },
        { "include": "#keywords" },
        { "include": "#common" }
    ],
    "repository": {
        "concept-block": {
            "begin": "^([ ]*)(concept)\\s+([^\\s:]+)\\s*:\\s*(\\w+)((?:\\s+(?:@?pii|personal|@?sensitive|secret))*)(?=\\s*(?://.*)?$)",
            "beginCaptures": {
                "2": { "name": "keyword.control.screenplay" },
                "3": { "name": "entity.name.type.screenplay" },
                "4": { "name": "storage.type.screenplay" },
                "5": { "name": "keyword.other.screenplay" }
            },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [
                {
                    "match": "^\\s*(@?pii|personal|@?sensitive|secret)\\s+(reason|scope|special|criminal)\\b",
                    "captures": { "1": { "name": "keyword.other.screenplay" }, "2": { "name": "keyword.other.screenplay" } }
                },
                { "include": "#comment" },
                { "include": "#fenced-csharp" },
                { "include": "#keywords" },
                { "include": "#common" }
            ]
        },
        "example-header": {
            "match": "^\\s*(example)\\s+([A-Z][\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}&&[\\x{0000}-\\x{FFFF}]]*)\\s*(:)\\s*([A-Z](?:[\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}&&[\\x{0000}-\\x{FFFF}]]|[.])*)(?=\\s*(?://.*)?$)",
            "captures": { "1": { "name": "keyword.control.screenplay" }, "2": { "name": "entity.name.type.screenplay" }, "3": { "name": "keyword.operator.screenplay" }, "4": { "name": "entity.name.type.screenplay" } }
        },
        "numeric-preamble": {
            "match": "^(?:\\uFEFF)?(numbers)([ \\t]+)(exact)(?=[ \\t]*(?:(?://|#).*)?$)",
            "captures": { "1": { "name": "keyword.control.screenplay" }, "3": { "name": "keyword.other.screenplay" } }
        },
        "command-block": {
            "comment": "Compiler identifiers start with ASCII letter/underscore; continuations use .NET word categories on BMP UTF-16 code units only.",
            "begin": "^([ ]*)(command)\\s+([A-Za-z_][\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}&&[\\x{0000}-\\x{FFFF}]]*)(?=\\s*(?://.*)?$)",
            "beginCaptures": { "2": { "name": "keyword.control.screenplay" }, "3": { "name": "entity.name.type.screenplay" } },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [
                { "include": "#inline-operation-block" },
                { "include": "#command-validation" },
                { "include": "#handler-block" },
                { "include": "#event-block" },
                { "include": "#description-block" },
                { "include": "#fenced-csharp" },
                { "include": "#stream-id-parts" },
                { "include": "#keyword-input" },
                { "include": "#keywords" },
                { "include": "#common" }
            ]
        },
        "command-validation": {
            "begin": "^([ ]*)(validate)(?=\\s*(?://.*)?$)",
            "beginCaptures": { "2": { "name": "keyword.other.screenplay" } },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [{ "include": "#command-named-rule" }, { "include": "#fenced-csharp" }, { "include": "#keywords" }, { "include": "#common" }]
        },
        "command-named-rule": {
            "begin": "^([ ]*)((?:[\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}&&[\\x{0000}-\\x{FFFF}]]|[.])+)\\s+(rule)\\s+([A-Za-z_][\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}&&[\\x{0000}-\\x{FFFF}]]*)(?=\\s*(?:severity\\s+\\w+|message\\s+.*|//.*|$))",
            "beginCaptures": { "2": { "name": "variable.other.screenplay" }, "3": { "name": "keyword.other.screenplay" }, "4": { "name": "entity.name.type.screenplay" } },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [{ "include": "#handler-implementation" }, { "include": "#fenced-csharp" }, { "include": "#fenced-typescript" }, { "include": "#fenced-react" }, { "include": "#fenced-html" }, { "include": "#fenced-sql" }, { "include": "#keywords" }, { "include": "#common" }]
        },
        "stream-id-parts": {
            "begin": "^([ \\t]*)(streamId)(?=\\s*(?://.*)?$)",
            "beginCaptures": { "2": { "name": "keyword.other.screenplay" } },
            "while": "^(?=\\1[ \\t]+\\S|[ \\t]*$)",
            "patterns": [
                { "match": "^\\s*([A-Za-z_]\\w*)\\s*=(?!=|>)", "captures": { "1": { "name": "variable.other.screenplay" } } },
                { "include": "#keyword-input" },
                { "include": "#common" }
            ]
        },
        "specification-stream": {
            "begin": "^([ \\t]*)(stream)\\s+([A-Za-z_]\\w*\\.[A-Za-z_]\\w*)(?=\\s*(?://.*)?$)",
            "beginCaptures": { "2": { "name": "keyword.other.screenplay" }, "3": { "name": "entity.name.type.screenplay" } },
            "while": "^(?=\\1[ \\t]+\\S|[ \\t]*$)",
            "patterns": [
                { "include": "#stream-id-parts" },
                { "match": "^\\s*(streamId)\\s*=(?!=|>)", "captures": { "1": { "name": "keyword.other.screenplay" } } },
                { "include": "#common" }
            ]
        },
        "keyword-input": {
            "match": "^\\s*(@?(?:system|operation|command|uses|execute|compensate|eventsource|stream|streamId|identifier|from))\\s+([\\w.]+(?:\\[\\])?(?:\\?|\\s+optional)?)(?=\\s*(?:=(?!=|>)|//|$))",
            "captures": { "1": { "name": "variable.other.screenplay" }, "2": { "name": "entity.name.type.screenplay" } }
        },
        "operation-block": {
            "begin": "^([ ]*)(operation)\\s+([A-Za-z_]\\w*)(?=\\s*(?://.*)?$)",
            "beginCaptures": { "2": { "name": "keyword.control.screenplay" }, "3": { "name": "entity.name.type.screenplay" } },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [{ "include": "#operation-body" }]
        },
        "inline-operation-block": {
            "begin": "^([ ]*)(produces\\s+operation)\\s+([A-Za-z_]\\w*)(?=\\s*(?://.*)?$)",
            "beginCaptures": { "2": { "name": "keyword.control.screenplay" }, "3": { "name": "entity.name.type.screenplay" } },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [{ "include": "#operation-body" }]
        },
        "operation-body": {
            "patterns": [
                { "include": "#comment" },
                { "include": "#operation-phase" },
                { "match": "^\\s*(uses)\\s+([A-Za-z_]\\w*)(?=\\s*(?://.*)?$)", "captures": { "1": { "name": "keyword.other.screenplay" }, "2": { "name": "entity.name.type.screenplay" } } },
                { "include": "#keyword-input" },
                { "include": "#description-block" },
                { "include": "#keywords" },
                { "include": "#common" }
            ]
        },
        "operation-phase": {
            "begin": "^([ ]*)(execute|compensate)(?=\\s*(?://.*)?$)",
            "beginCaptures": { "2": { "name": "keyword.other.screenplay" } },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [
                { "include": "#handler-implementation" },
                { "include": "#description-block" },
                { "include": "#fenced-csharp" },
                { "include": "#fenced-react" },
                { "include": "#fenced-typescript" },
                { "include": "#fenced-html" },
                { "include": "#fenced-sql" },
                { "include": "#keywords" },
                { "include": "#common" }
            ]
        },
        "comment": {
            "match": "//.*",
            "name": "comment.line.double-slash.screenplay"
        },
        "declared-dependency": {
            "comment": "Depends on is a module/feature directive phrase, not a globally reserved property name.",
            "match": "^[ \\t]*(depends)[ \\t]+(on)[ \\t]+([A-Za-z_][\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}&&[\\x{0000}-\\x{FFFF}]]*(?:\\.[A-Za-z_][\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}&&[\\x{0000}-\\x{FFFF}]]*)*)(?=[ \\t]*(?://.*)?$)",
            "captures": {
                "1": { "name": "keyword.other.screenplay" },
                "2": { "name": "keyword.other.screenplay" },
                "3": { "name": "entity.name.type.screenplay" }
            }
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Ordered invocation refusal selectors are syntax-only.",
                    "match": "^\\s*(on)\\s+(refused)(?:\\s+(by)\\s+(validation|constraint|authorization)(?:\\s+([\\w.]+))?)?(?=\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.other.screenplay" }, "2": { "name": "keyword.other.screenplay" }, "3": { "name": "keyword.other.screenplay" }, "4": { "name": "keyword.other.screenplay" }, "5": { "name": "entity.name.type.screenplay" } }
                },
                {
                    "match": "^\\s*(acknowledge)(?=\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.other.screenplay" } }
                },
                {
                    "comment": "Redelivery selects an existing given occurrence and one reaction; syntax-only.",
                    "match": "^\\s*(when)\\s+(redelivered)\\s+([\\w.]+)\\s+(to)\\s+([\\w.]+)(?=\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.other.screenplay" }, "2": { "name": "keyword.other.screenplay" }, "3": { "name": "entity.name.type.screenplay" }, "4": { "name": "keyword.other.screenplay" }, "5": { "name": "entity.name.type.screenplay" } }
                },
                {
                    "match": "^\\s*(no)\\s+(stream)(?=\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.other.screenplay" }, "2": { "name": "keyword.other.screenplay" } }
                },
                {
                    "match": "^\\s*(stream|streamId)\\s*=(?!=|>)",
                    "captures": { "1": { "name": "variable.other.screenplay" } }
                },
                {
                    "match": "^(system|eventsource)\\s+([A-Za-z_]\\w*)(?=\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.control.screenplay" }, "2": { "name": "entity.name.type.screenplay" } }
                },
                {
                    "match": "^\\s*(given)\\s+(operation)\\s+([\\w.]+)\\s+(fails)(?=\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.other.screenplay" }, "2": { "name": "keyword.other.screenplay" }, "3": { "name": "entity.name.type.screenplay" }, "4": { "name": "keyword.other.screenplay" } }
                },
                {
                    "match": "^\\s*(then)\\s+(operation|compensated)\\s+([\\w.]+)(?=\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.other.screenplay" }, "2": { "name": "keyword.other.screenplay" }, "3": { "name": "entity.name.type.screenplay" } }
                },
                {
                    "comment": "Generated is a contextual modifier after a complete type, not a globally reserved name.",
                    "match": "^\\s*@?[a-z_]\\w*\\s+([\\w.]+(?:\\[\\])?(?:\\?|\\s+optional)?)\\s+(generated)(?:\\s+(identifier))?(?=\\s*(?://.*)?$)",
                    "captures": {
                        "1": { "name": "entity.name.type.screenplay" },
                        "2": { "name": "keyword.other.screenplay" },
                        "3": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "Generated specification fixtures are separate from request mappings.",
                    "match": "^\\s*(generated)\\s+([a-z_]\\w*)\\s*=(?!=|>)",
                    "captures": {
                        "1": { "name": "keyword.other.screenplay" },
                        "2": { "name": "variable.other.screenplay" }
                    }
                },
                {
                    "match": "^\\s*(then)\\s+(returns)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.screenplay" },
                        "2": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "Unambiguous response headers; a type-shaped returns property keeps its name.",
                    "match": "^\\s*(returns)(?=\\s*(?://.*)?$|\\s+@\\w+\\s*(?://.*)?$)",
                    "captures": { "1": { "name": "keyword.other.screenplay" } }
                },
                {
                    "match": "^\\s*(@?[a-z_]\\w*)\\s+([\\w.]+(?:\\[\\])?\\??)(?:\\s+(optional))?\\s*=(?!=|>)",
                    "captures": {
                        "1": { "name": "variable.other.screenplay" },
                        "2": { "name": "entity.name.type.screenplay" },
                        "3": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "Optional query parameters require a name and type after by or filter.",
                    "match": "^\\s*(?:by|filter)\\s+[a-z_]\\w*\\s+([\\w.]+(?:\\[\\])?)\\s+(optional)\\b(?=\\s*(?:from\\b|//|$))",
                    "captures": {
                        "1": { "name": "entity.name.type.screenplay" },
                        "2": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "Optional is a modifier after a type, not a reserved name; query prefixes cannot be property names.",
                    "match": "^(?!\\s*(?:by|filter)\\s+)\\s*@?[a-z_]\\w*\\s+([\\w.]+(?:\\[\\])?)\\s+(optional)\\b(?=\\s*(?:identifier\\b|from\\b|=(?!=|>)|//|$))",
                    "captures": {
                        "1": { "name": "entity.name.type.screenplay" },
                        "2": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "Observable optional means an observable of the type named optional.",
                    "match": "^\\s*query\\s+[A-Za-z_]\\w*\\s*=>\\s*(?!observable\\s+optional\\s*(?://.*)?$)(?:observable\\s+)?([\\w.]+(?:\\[\\])?)\\s+(optional)\\b(?=\\s*(?://.*)?$)",
                    "captures": {
                        "1": { "name": "entity.name.type.screenplay" },
                        "2": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "A specification's clock, capture, trigger and query steps.",
                    "match": "^\\s*(given|when)\\s+(clock|capture|trigger|query)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.screenplay" },
                        "2": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "A specification explicitly expects no new events.",
                    "match": "^\\s*(then)\\s+(no)\\s+(events)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.screenplay" },
                        "2": { "name": "keyword.other.screenplay" },
                        "3": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "What the query a specification performs returns.",
                    "match": "^\\s*(then)\\s+(?:(no)\\s+)?(result)\\b(?:\\s+(exactly)\\b)?",
                    "captures": {
                        "1": { "name": "keyword.other.screenplay" },
                        "2": { "name": "keyword.other.screenplay" },
                        "3": { "name": "keyword.other.screenplay" },
                        "4": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "comment": "A quoted import names .play files by path or glob rather than a qualified name.",
                    "match": "^\\s*(import)\\s+(\"[^\"\\\\]*\")",
                    "captures": {
                        "1": { "name": "keyword.control.screenplay" },
                        "2": { "name": "string.quoted.double.import-path.screenplay" }
                    }
                },
                {
                    "match": "^\\s*(?:(?:public|produces)\\s+)?(event)\\s+[A-Za-z_]\\w*\\s+(generation)(?=\\s+[0-9]+(?:\\s+from\\s+\"(?:[^\"\\\\]|\\\\.)*\")?\\s*$)",
                    "captures": {
                        "1": { "name": "keyword.control.screenplay" },
                        "2": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "match": "^\\s*(public)\\s+(event)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.screenplay" },
                        "2": { "name": "keyword.control.screenplay" }
                    }
                },
                {
                    "match": "^\\s*(direction)\\s+(inbound|outbound)\\s*$",
                    "captures": {
                        "1": { "name": "keyword.other.screenplay" },
                        "2": { "name": "keyword.other.screenplay" }
                    }
                },
                {
                    "match": "^\\s*(domain|import|concept|type|policy|persona|authentication|module|layout|theme|ui|feature|slice|event|system|eventsource|operation|command|query|projection|capture|reaction|reducer|readmodel|trigger|screen|dialog|form|contribute|constraint|specification|example|seed|behavior)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.screenplay" }
                    }
                },
                {
                    "match": "\\brow-click\\b",
                    "name": "keyword.other.screenplay"
                },
                {
                    "match": "^\\s*(notify|confirm)(?=\\s+(?:info\\b|warning\\b|error\\b|\"|\\$strings\\.))",
                    "captures": { "1": { "name": "keyword.control.screenplay" } }
                },
                {
                    "match": "\\bnot\\b(?=\\s+(?:role\\b|claim\\b|authenticated\\b|not\\b|\\())",
                    "name": "keyword.operator.logical.screenplay"
                },
                {
                    "match": "\\b(authorize|validate|produces|reads|as|handler|performer|observable|identifier|reason|from|require|when|given|then|arguments|result|error|template|data|component|context|property|literal|icons|packages|outlet|toolbar|presentation|exposes|mode|oneWay|twoWay|null|propagate|clear|preserve|expected|action|otherwise|hidden|execute|with|contains|starts|section|navigate|to|by|via|filter|on|label|column|field|table|summary|title|unique|released|ignore|casing|file|rule|message|severity|information|warning|matches|all|max|min|length|today|not|no|empty|and|or|authenticated|role|claim|subject|event|query|layout|translate|key|description|concurrency|eventSource|sourceType|streamType|streamId|tag|for|readmodel|provider|nested|exclude|literal|automap)\\b",
                    "name": "keyword.other.screenplay"
                }
            ]
        },
        "common": {
            "patterns": [
                { "include": "#comment" },
                {
                    "comment": "A leading @ escapes a name that collides with a directive keyword.",
                    "match": "^\\s*@[a-z_]\\w*",
                    "name": "variable.other.screenplay"
                },
                {
                    "match": "@\\w+",
                    "name": "entity.other.attribute-name.screenplay"
                },
                {
                    "match": "\\$(?:context|eventContext|eventSourceId|causedBy|refusal)(?:\\.\\w+)*|\\$(?:env|secrets|strings)\\.[\\w.]+|\\$\\.[\\w.]*",
                    "name": "variable.language.screenplay"
                },
                {
                    "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
                    "name": "string.quoted.double.screenplay"
                },
                {
                    "match": "\"(?:[^\"\\\\]|\\\\.)*$",
                    "name": "invalid.illegal.unterminated-string.screenplay"
                },
                {
                    "match": "\\b\\d+(?:ms|s|m|h|d)\\b",
                    "name": "constant.numeric.duration.screenplay"
                },
                {
                    "match": "-?\\b\\d+(?:\\.\\d+)?\\b",
                    "name": "constant.numeric.screenplay"
                },
                {
                    "match": "\\b(StateChange|StateView|Automation|Translate)\\b",
                    "name": "support.class.slice-type.screenplay"
                },
                {
                    "match": "\\b(Uuid|String|Int|Decimal|Bool|Date|DateTime|Enum)\\b",
                    "name": "support.type.primitive.screenplay"
                },
                {
                    "match": "=>|==|!=|>=|<=|[><=:?]",
                    "name": "keyword.operator.screenplay"
                },
                {
                    "match": "\\b[A-Z]\\w*\\b",
                    "name": "entity.name.type.screenplay"
                },
                {
                    "match": "\\b[a-z_]\\w*\\b",
                    "name": "variable.other.screenplay"
                }
            ]
        },
        "fenced-csharp": {
            "begin": "^[ ]*(```)(csharp)[ ]*$",
            "beginCaptures": { "1": { "name": "punctuation.definition.fence.screenplay" }, "2": { "name": "entity.name.tag.code-language.screenplay" } },
            "end": "^[ ]*(```)[ ]*$",
            "endCaptures": { "1": { "name": "punctuation.definition.fence.screenplay" } },
            "contentName": "meta.embedded.block.csharp",
            "patterns": [{ "include": "source.cs" }]
        },
        "fenced-react": {
            "begin": "^[ ]*(```)(react)[ ]*$",
            "end": "^[ ]*(```)[ ]*$",
            "contentName": "meta.embedded.block.typescriptreact",
            "patterns": [{ "include": "source.tsx" }]
        },
        "fenced-typescript": {
            "begin": "^[ ]*(```)(typescript)[ ]*$",
            "end": "^[ ]*(```)[ ]*$",
            "contentName": "meta.embedded.block.typescript",
            "patterns": [{ "include": "source.ts" }]
        },
        "fenced-html": {
            "begin": "^[ ]*(```)(html)[ ]*$",
            "end": "^[ ]*(```)[ ]*$",
            "contentName": "meta.embedded.block.html",
            "patterns": [{ "include": "text.html.basic" }]
        },
        "fenced-sql": {
            "begin": "^[ ]*(```)(sql)[ ]*$",
            "end": "^[ ]*(```)[ ]*$",
            "contentName": "meta.embedded.block.sql",
            "patterns": [{ "include": "source.sql" }]
        },
        "code-block-csharp": {
            "begin": "^([ ]*)((?:validate|produces)[ ]+)?(csharp)[ ]*$",
            "beginCaptures": {
                "2": { "name": "keyword.other.screenplay" },
                "3": { "name": "entity.name.tag.code-language.screenplay" }
            },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [
                {
                    "begin": "^[ ]*(```)[ ]*$",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.fence.screenplay" }
                    },
                    "end": "^[ ]*(```)[ ]*$",
                    "endCaptures": {
                        "1": { "name": "punctuation.definition.fence.screenplay" }
                    },
                    "contentName": "meta.embedded.block.csharp",
                    "patterns": [
                        { "include": "source.cs" }
                    ]
                }
            ]
        },
        "code-block-typescript": {
            "begin": "^([ ]*)(typescript)[ ]*$",
            "beginCaptures": {
                "2": { "name": "entity.name.tag.code-language.screenplay" }
            },
            "while": "^(?=\\1[ ]+\\S|[ ]*$)",
            "patterns": [
                {
                    "begin": "^[ ]*(```)[ ]*$",
                    "beginCaptures": {
