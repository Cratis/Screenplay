# Only the bundled output in `out/`, the grammar, the language configuration,
# and the resources ship — everything else is build/dev tooling.
node_modules/**
**/*.ts
tsconfig.json
esbuild.mjs
vitest.config.mts

# Native-host and process harnesses include synthetic fixtures and must never ship.
tests/**
out/tests/**
vscode.stub.*
vitest.setup.*
.eslintcache
.gitignore

# Source maps would leak local paths and add size for no runtime gain.
**/*.map

# OS metadata.
**/.DS_Store

# Packaging artifacts.
**/*.vsix
.vscodeignore

# The webview's sources; it ships as the bundle in `out/`.
Webview/**
**/for_*/**
