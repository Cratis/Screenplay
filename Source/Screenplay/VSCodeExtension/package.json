{
    "name": "screenplay",
    "displayName": "Screenplay Language",
    "description": "Language support for the Cratis Screenplay DSL (.play) — the event model board, syntax highlighting, IntelliSense, hover documentation, and diagnostics",
    "keywords": [
        "cratis",
        "screenplay",
        "event-sourcing",
        "event-modeling",
        "cqrs",
        "dsl"
    ],
    "version": "0.1.0",
    "publisher": "cratis",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Screenplay.git"
    },
    "icon": "resources/logo.png",
    "license": "MIT",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Local language assistance remains available. C# repair processes require workspace trust and explicit User configuration.",
            "restrictedConfigurations": [
                "screenplay.repairs.enabled",
                "screenplay.repairs.executable",
                "screenplay.repairs.arguments",
                "screenplay.repairs.modelRoot"
            ]
        },
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "C# repairs require a physical filesystem workspace and native extension host."
        }
    },
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "screenplay",
                "aliases": [
                    "Screenplay",
                    "screenplay"
                ],
                "extensions": [
                    ".play"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./resources/logo.png",
                    "dark": "./resources/logo.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "screenplay",
                "scopeName": "source.screenplay",
                "path": "./syntaxes/screenplay.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.csharp": "csharp",
                    "meta.embedded.block.typescript": "typescript",
                    "meta.embedded.block.typescriptreact": "typescriptreact",
                    "meta.embedded.block.html": "html",
                    "meta.embedded.block.sql": "sql"
                }
            }
        ],
        "configuration": {
            "title": "Screenplay",
            "properties": {
                "screenplay.repairs.enabled": {
                    "type": "boolean",
                    "default": false,
                    "scope": "machine",
                    "markdownDescription": "Opt in to saved-file C# repairs with a user-installed server. Requires a trusted physical workspace and repair contract v1. Nothing is installed or saved automatically."
                },
                "screenplay.repairs.executable": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Absolute path to an explicitly approved executable on this extension host (including remote hosts). User settings only; no shell or project discovery."
                },
                "screenplay.repairs.arguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "mcp"
                    ],
                    "scope": "machine",
                    "markdownDescription": "Separate argument-prefix strings, for example `[\"mcp\"]` for screenplay or `[\"screenplay\", \"mcp\"]` for cratis. The approved model root is appended as one argument; do not quote shell strings."
                },
                "screenplay.repairs.modelRoot": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Absolute existing physical application directory inside the trusted filesystem workspace. Changing it closes the old connection and invalidates all proposals."
                },
                "screenplay.sourceRoot": {
                    "type": [
                        "string",
                        "array"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "scope": "resource",
                    "markdownDescription": "Root, or roots, that a `file <path>` reference in a `.play` document is relative to. A relative entry resolves against the workspace folder. Nothing in a `.play` document records its root, so the extension otherwise probes the workspace folder, the document's own folder and the conventional source roots beneath the workspace, in that order. Set this when that probing finds the wrong tree — it is checked first, so it decides."
                }
            }
        },
        "customEditors": [
            {
                "viewType": "screenplay.eventModelBoard",
                "displayName": "Event Model Board",
                "selector": [
                    {
                        "filenamePattern": "*.play"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "screenplay.repair.apply",
                "title": "Apply Reviewed C# Repair",
                "category": "Screenplay",
                "icon": "$(check)"
            },
            {
                "command": "screenplay.repair.discard",
                "title": "Discard C# Repair",
                "category": "Screenplay",
                "icon": "$(close)"
            },
            {
                "command": "screenplay.repair.refresh",
                "title": "Discover Saved-File C# Repairs",
                "category": "Screenplay"
            },
            {
                "command": "screenplay.repair.inspectState",
                "title": "Inspect C# Repair Identity and Recovery State",
                "category": "Screenplay"
            },
            {
                "command": "screenplay.showSource",
                "title": "Show Source",
                "category": "Screenplay",
                "icon": "$(go-to-file)"
            },
            {
                "command": "screenplay.showBoard",
                "title": "Open Event Model Board",
                "category": "Screenplay",
                "icon": "$(preview)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "screenplay.repair.apply",
                    "when": "screenplay.repair.reviewPending && resourceScheme == screenplay-repair",
                    "group": "navigation"
                },
                {
                    "command": "screenplay.repair.discard",
                    "when": "screenplay.repair.reviewPending && resourceScheme == screenplay-repair",
                    "group": "navigation"
                },
                {
                    "command": "screenplay.showSource",
                    "when": "activeCustomEditorId == screenplay.eventModelBoard",
                    "group": "navigation"
                },
                {
                    "command": "screenplay.showBoard",
                    "when": "editorLangId == screenplay && activeCustomEditorId != screenplay.eventModelBoard",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "screenplay.repair.apply",
                    "when": "screenplay.repair.reviewPending"
                },
                {
                    "command": "screenplay.repair.discard",
                    "when": "screenplay.repair.reviewPending"
                },
                {
                    "command": "screenplay.showSource",
                    "when": "activeCustomEditorId == screenplay.eventModelBoard"
                },
                {
                    "command": "screenplay.showBoard",
                    "when": "editorLangId == screenplay"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "node esbuild.mjs --production",
        "build": "node esbuild.mjs && tsc --noEmit && tsc --noEmit -p Webview",
        "compile": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit && tsc --noEmit -p Webview",
        "package": "vsce package --no-dependencies",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "vitest run",
        "test:repair-process": "node tests/runProcessTests.mjs",
        "build:test-host": "node tests/buildHostTests.mjs",
        "test:host": "node tests/runHostTests.mjs"
    },
    "dependencies": {
        "@cratis/screenplay-compiler": "workspace:*",
        "@cratis/screenplay-event-models": "workspace:*",
        "@cratis/screenplay-language": "workspace:*"
    },
    "devDependencies": {
        "@cratis/arc": "22.50.1",
        "@cratis/arc.react": "22.50.1",
        "@cratis/components": "4.25.0",
        "@cratis/event-models": "0.115.0",
        "@cratis/fundamentals": "7.22.0",
        "@cratis/scene": "0.115.0",
        "@types/chai": "^5.2.3",
        "@types/node": "26.6.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/vscode": "^1.85.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^4.0.0",
        "chai": "^6.3.0",
        "esbuild": "^0.28.2",
        "pixi.js": "8.22.0",
        "primeicons": "8.0.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "reflect-metadata": "0.2.2",
        "typescript": "6.0.3",
        "vitest": "^5.0.3",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
