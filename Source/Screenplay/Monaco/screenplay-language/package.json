{
    "name": "@cratis/screenplay-language",
    "version": "0.0.0",
    "description": "Monaco language service for the Cratis Screenplay DSL — syntax highlighting, IntelliSense, hover and diagnostics for .play files",
    "keywords": [
        "cratis",
        "screenplay",
        "event-sourcing",
        "event-modeling",
        "cqrs",
        "monaco",
        "dsl",
        "language-service"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Screenplay.git"
    },
    "type": "module",
    "main": "./dist/bundles/index.js",
    "module": "./dist/bundles/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/bundles/index.js"
        },
        "./capture": {
            "types": "./dist/sub-languages/capture/index.d.ts",
            "import": "./dist/bundles/sub-languages/capture/index.js"
        },
        "./projection": {
            "types": "./dist/sub-languages/projection/index.d.ts",
            "import": "./dist/bundles/sub-languages/projection/index.js"
        }
    },
    "files": [
        "dist/bundles",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "scripts": {
        "build": "node build.mjs",
        "test:pack": "node check-package.mjs",
        "compile": "tsc --noEmit -p tsconfig.json",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "vitest run"
    },
    "peerDependencies": {
        "monaco-editor": ">=0.44.0"
    },
    "devDependencies": {
        "@cratis/screenplay-compiler": "workspace:*",
        "@types/chai": "^5.2.3",
        "chai": "^6.2.2",
        "esbuild": "^0.28.1",
        "monaco-editor": "^0.55.1",
        "typescript": "6.0.3",
        "vitest": "^4.1.11"
    }
}
